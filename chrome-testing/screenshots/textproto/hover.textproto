# Hover mode: 2 screenshots — before and after simulated hover.
# interactive.js runs the simulation: hover toggles every 500ms (ON at even steps).
# Timeline: page loads → 200ms interactive.js starts → 700ms tick 1 (hover OFF) → 1200ms tick 2 (hover ON)
# Placeholders: {{URL}}, {{OUTPUT_DIR}}, {{SLUG}}

name: "screenshot_{{SLUG}}"

steps: {
  label: "set_viewport"
  set_viewport: {
    width: 1280
    height: 800
    device_scale_factor: 2
  }
}

steps: {
  label: "navigate"
  navigate: {
    url: "{{URL}}"
  }
}

steps: {
  label: "wait_for_iframes"
  wait: {
    milliseconds: 600
  }
}

steps: {
  label: "frame_1"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/1.png"
    format: "png"
  }
}

steps: {
  label: "wait_for_hover_on"
  wait: {
    milliseconds: 800
  }
}

steps: {
  label: "frame_2"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/2.png"
    format: "png"
  }
}
