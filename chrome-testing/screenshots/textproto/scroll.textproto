# Scroll mode: 3 screenshots — top, mid, bottom positions.
# interactive.js runs the simulation: scroll cycles every 500ms (top → mid → bottom → mid).
# Timeline: 200ms start → 700ms tick 1 (mid) → 1200ms tick 2 (bottom) → 1700ms tick 3 (mid)
# Supports both vertical and horizontal scroll containers.
# Placeholders: {{URL}}, {{OUTPUT_DIR}}, {{SLUG}}

name: "screenshot_{{SLUG}}"

steps: {
  label: "set_viewport"
  set_viewport: {
    width: 1280
    height: 800
    device_scale_factor: 2
  }
}

steps: {
  label: "navigate"
  navigate: {
    url: "{{URL}}"
  }
}

steps: {
  label: "wait_for_iframes"
  wait: {
    milliseconds: 600
  }
}

steps: {
  label: "frame_1"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/1.png"
    format: "png"
  }
}

steps: {
  label: "wait_for_mid_scroll"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_2"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/2.png"
    format: "png"
  }
}

steps: {
  label: "wait_for_bottom_scroll"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_3"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/3.png"
    format: "png"
  }
}
