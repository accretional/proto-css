# Scroll mode: 3 screenshots — before, mid, and after scrolling.
# Scrolls ALL scrollable containers (not just the first), so multi-card pages work.
# Placeholders: {{URL}}, {{OUTPUT_DIR}}, {{SLUG}}

name: "screenshot_{{SLUG}}"

steps: {
  label: "set_viewport"
  set_viewport: {
    width: 1280
    height: 800
    device_scale_factor: 2
  }
}

steps: {
  label: "navigate"
  navigate: {
    url: "{{URL}}"
  }
}

steps: {
  label: "wait_for_render"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_1"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/1.png"
    format: "png"
  }
}

steps: {
  label: "scroll_mid"
  evaluate_script: {
    expression: "(function(){var containers=[];var sc=document.querySelectorAll('.scroll-container');for(var j=0;j<sc.length;j++)containers.push(sc[j]);var all=document.querySelectorAll('[style]');for(var i=0;i<all.length;i++){var s=getComputedStyle(all[i]);if((s.overflow==='auto'||s.overflow==='scroll'||s.overflowY==='auto'||s.overflowY==='scroll')&&all[i].scrollHeight>all[i].clientHeight+10){var dup=false;for(var k=0;k<containers.length;k++){if(containers[k]===all[i]){dup=true;break}}if(!dup)containers.push(all[i])}}if(containers.length===0)containers.push(document.scrollingElement);for(var n=0;n<containers.length;n++){containers[n].scrollTo({top:Math.floor(containers[n].scrollHeight/3),behavior:'instant'})}})()"
  }
}

steps: {
  label: "wait_mid"
  wait: {
    milliseconds: 300
  }
}

steps: {
  label: "frame_2"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/2.png"
    format: "png"
  }
}

steps: {
  label: "scroll_end"
  evaluate_script: {
    expression: "(function(){var containers=[];var sc=document.querySelectorAll('.scroll-container');for(var j=0;j<sc.length;j++)containers.push(sc[j]);var all=document.querySelectorAll('[style]');for(var i=0;i<all.length;i++){var s=getComputedStyle(all[i]);if((s.overflow==='auto'||s.overflow==='scroll'||s.overflowY==='auto'||s.overflowY==='scroll')&&all[i].scrollHeight>all[i].clientHeight+10){var dup=false;for(var k=0;k<containers.length;k++){if(containers[k]===all[i]){dup=true;break}}if(!dup)containers.push(all[i])}}if(containers.length===0)containers.push(document.scrollingElement);for(var n=0;n<containers.length;n++){containers[n].scrollTo({top:containers[n].scrollHeight,behavior:'instant'})}})()"
  }
}

steps: {
  label: "wait_end"
  wait: {
    milliseconds: 300
  }
}

steps: {
  label: "frame_3"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/3.png"
    format: "png"
  }
}
