# Temporal mode: 6 screenshots at 500ms intervals to capture animation/transition progress.
# interactive.js runs animations automatically. Frames capture the progression.
# Placeholders: {{URL}}, {{OUTPUT_DIR}}, {{SLUG}}

name: "screenshot_{{SLUG}}"

steps: {
  label: "set_viewport"
  set_viewport: {
    width: 1280
    height: 800
    device_scale_factor: 2
  }
}

steps: {
  label: "navigate"
  navigate: {
    url: "{{URL}}"
  }
}

steps: {
  label: "wait_for_iframes"
  wait: {
    milliseconds: 400
  }
}

steps: {
  label: "frame_1"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/1.png"
    format: "png"
  }
}

steps: {
  label: "wait_2"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_2"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/2.png"
    format: "png"
  }
}

steps: {
  label: "wait_3"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_3"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/3.png"
    format: "png"
  }
}

steps: {
  label: "wait_4"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_4"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/4.png"
    format: "png"
  }
}

steps: {
  label: "wait_5"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_5"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/5.png"
    format: "png"
  }
}

steps: {
  label: "wait_6"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_6"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/6.png"
    format: "png"
  }
}
