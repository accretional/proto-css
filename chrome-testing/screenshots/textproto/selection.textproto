# Selection mode: 2 screenshots — before and after programmatic text selection.
# Uses ?static=1 so elements are directly in the DOM (not inside iframes).
# Selects all text content inside demo targets.
# Placeholders: {{URL}}, {{OUTPUT_DIR}}, {{SLUG}}

name: "screenshot_{{SLUG}}"

steps: {
  label: "set_viewport"
  set_viewport: {
    width: 1280
    height: 800
    device_scale_factor: 2
  }
}

steps: {
  label: "navigate"
  navigate: {
    url: "{{URL}}"
  }
}

steps: {
  label: "wait_for_render"
  wait: {
    milliseconds: 500
  }
}

steps: {
  label: "frame_1"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/1.png"
    format: "png"
  }
}

steps: {
  label: "select_text"
  evaluate_script: {
    expression: "(function(){var sel=window.getSelection();sel.removeAllRanges();var targets=document.querySelectorAll('.demo-area [style]');for(var i=0;i<Math.min(targets.length,3);i++){try{var range=document.createRange();range.selectNodeContents(targets[i]);sel.addRange(range)}catch(e){}}})()"
  }
}

steps: {
  label: "wait_select"
  wait: {
    milliseconds: 300
  }
}

steps: {
  label: "frame_2"
  screenshot: {
    output_path: "{{OUTPUT_DIR}}/2.png"
    format: "png"
  }
}
