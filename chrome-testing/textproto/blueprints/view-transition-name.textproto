demo_type: BOX
title: "View Transition Name"
target_inner_html: "<div class=\"code-block\"><span class=\"selector\">.element</span> {<br>&nbsp;&nbsp;<span class=\"keyword\">view-transition-name:</span> <span class=\"value\">none</span>;<br>&nbsp;&nbsp;<span class=\"comment\">/* Element transitions with full page cross-fade */</span><br>}</div><div class=\"transition-visual\"><div class=\"page\"><div class=\"page-label\">Page A</div><div class=\"page-element no-transition\" style=\"background: #4a5568; border: 1px dashed #6b7280;\">No VT name</div><div class=\"page-element\" style=\"background: rgba(100,100,100,0.2); margin-top: 8px; border: 1px dashed #4a5568; color: #6b7280;\">other content</div></div><div class=\"transition-arrow\"><div class=\"arrow-icon\">&#10132;</div><div class=\"arrow-text\">full page<br>cross-fade</div></div><div class=\"page\"><div class=\"page-label\">Page B</div><div class=\"page-element no-transition\" style=\"background: #4a5568; border: 1px dashed #6b7280;\">No VT name</div><div class=\"page-element\" style=\"background: rgba(100,100,100,0.2); margin-top: 8px; border: 1px dashed #4a5568; color: #6b7280;\">other content</div></div></div>"
target_base_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 560px;"
extra_css: ".badge { display: inline-block; font-size: 10px; font-family: monospace; padding: 3px 8px; border-radius: 10px; background: rgba(243,156,18,0.15); color: #f39c12; margin-bottom: 10px; }\n.code-block { background: #0d1117; border-radius: 8px; padding: 14px 18px; font-family: monospace; font-size: 11px; line-height: 1.7; }\n.keyword { color: #ff7b72; }\n.value { color: #79c0ff; }\n.comment { color: #6b7280; }\n.selector { color: #7ee787; }\n.transition-visual { display: flex; align-items: center; gap: 16px; margin-top: 16px; }\n.page { background: #0d1117; border-radius: 8px; padding: 16px; width: 200px; height: 140px; border: 1px solid #2a3a5c; position: relative; }\n.page-label { font-size: 10px; font-family: monospace; color: #6b7280; margin-bottom: 8px; }\n.page-element { border-radius: 6px; padding: 8px; font-size: 10px; font-family: monospace; color: #fff; text-align: center; }\n.transition-arrow { display: flex; flex-direction: column; align-items: center; gap: 4px; }\n.arrow-icon { font-size: 24px; color: #4a5568; }\n.arrow-text { font-size: 9px; font-family: monospace; color: #6b7280; }\n.no-transition { opacity: 0.4; border-style: dashed !important; }\n.desc { font-size: 12px; color: #6b7280; margin-bottom: 16px; line-height: 1.5; }"
