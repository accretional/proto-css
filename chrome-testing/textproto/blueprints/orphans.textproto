demo_type: MULTICOL
title: "Orphans"
target_base_style: "column-count: 2; column-gap: 16px; column-rule: 1px solid #3a3a5c; font-size: 12px; line-height: 1.6; color: #c0c0d0; height: 200px;"
target_inner_html: "The quick brown fox jumps over the lazy dog. This paragraph continues with more text to demonstrate how orphans controls the minimum number of lines that must be shown at the bottom of a page or column before a break. Additional text ensures enough content for the column break to matter."
