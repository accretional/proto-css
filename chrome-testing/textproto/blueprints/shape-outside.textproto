demo_type: TEXT
title: "Shape Outside"
target_base_style: "float: left; width: 140px; height: 140px; margin-right: 12px; margin-bottom: 4px; background: rgba(139, 92, 246, 0.3); border: 2px solid #8b5cf6;"
siblings_after: "<p class=\"text-content\">Text wraps around a circle shape. The content flows along the curved edge of the circle, creating an organic layout. This demonstrates how CSS shapes allow text to flow around non-rectangular areas. More text to show the wrapping effect clearly in the demo.</p>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; border: 1px solid #2a2a4a; overflow: hidden;"
extra_css: ".demos { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }\n.label { font-size: 12px; font-family: monospace; color: #a78bfa; margin-bottom: 12px; background: #1a1a2e; display: inline-block; padding: 3px 8px; border-radius: 4px; }\n.text-content { font-size: 13px; line-height: 1.5; color: #c4b5fd; }"
