demo_type: BOX
title: "Animation Direction"
target_base_style: "width: 50px; height: 50px; border-radius: 8px; position: absolute; animation: moveCorner 2s linear infinite; animation-delay: -0.5s; background: #e94560;"
wrapper_style: "position: relative; background: #0f3460; border-radius: 8px; width: 100%; height: 120px;"
max_values: 8
extra_css: "@keyframes moveCorner {\n  0% { top: 10px; left: 10px; background: #e94560; }\n  100% { top: 60px; left: calc(100% - 60px); background: #3498db; }\n}"
screenshot_textproto: "temporal"
