demo_type: BOX
title: "Animation Direction"
target_base_style: "width: 50px; height: 50px; border-radius: 8px; position: absolute; animation: moveCorner 2s linear infinite; animation-play-state: paused; animation-delay: -0.5s; display: flex; align-items: center; justify-content: center;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 280px; height: 280px; display: flex; flex-direction: column; align-items: center;"
extra_css: ".demo-title { font-size: 13px; color: #ccc; margin-bottom: 12px; }\n.track { width: 200px; height: 160px; background: #0f3460; border-radius: 8px; position: relative; }\n.start-marker, .end-marker { position: absolute; font-size: 9px; font-family: monospace; color: #4a5568; }\n.start-marker { top: 4px; left: 8px; }\n.end-marker { bottom: 4px; right: 8px; }\n@keyframes moveCorner {\n  0% { top: 10px; left: 10px; background: #e94560; }\n  100% { top: 90px; left: 130px; background: #3498db; }\n}\n.path { position: absolute; top: 35px; left: 35px; width: 130px; height: 80px; border: 2px dashed #4a5568; border-radius: 4px; opacity: 0.4; }"
