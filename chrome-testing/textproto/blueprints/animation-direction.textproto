demo_type: BOX
title: "Animation Direction"
target_base_style: "width: 50px; height: 50px; border-radius: 8px; position: absolute; animation: moveAcross 4s linear infinite; animation-delay: -1s; background: #e94560;"
wrapper_style: "position: relative; background: #0f3460; border-radius: 8px; width: 100%; height: 80px;"
max_values: 8
extra_css: "@keyframes moveAcross {\n  0% { left: 5px; top: 15px; background: #e94560; border-radius: 8px; }\n  50% { left: calc(50% - 25px); top: 15px; background: #f39c12; border-radius: 50%; }\n  100% { left: calc(100% - 55px); top: 15px; background: #3498db; border-radius: 8px; }\n}"
screenshot_textproto: "temporal"
