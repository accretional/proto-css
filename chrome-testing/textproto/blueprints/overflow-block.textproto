demo_type: SCROLL
title: "Overflow Block"
target_base_style: "width: 100%; height: 160px; background: #0f3460; border-radius: 6px; border: 2px solid #3a3a5c; padding: 12px;"
target_inner_html: "<div class=\"content\"><p>This text overflows in the block (vertical) direction and remains visible.</p><p>More content that extends beyond the container boundary below.</p><p>Even more text to push past the bottom edge of the box.</p><p>The content keeps going and going past the bottom.</p></div>"
extra_css: ".content { font-size: 12px; line-height: 1.7; color: #c0c0d0; }"
screenshot_textproto: "static"
