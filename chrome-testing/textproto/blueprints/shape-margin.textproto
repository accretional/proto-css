demo_type: TEXT
title: "Shape Margin"
target_base_style: "background: #0a0a1a; border-radius: 8px; padding: 14px; min-height: 140px; overflow: hidden; font-size: 11px; color: #9ca3af; line-height: 1.6;"
target_inner_html: "<div class=\"float-circle\"></div>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo."
wrapper_style: "background: #16213e; border-radius: 12px; padding: 18px;"
extra_css: ".demos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }\n.float-circle { float: left; width: 80px; height: 80px; background: #e94560; border-radius: 50%; shape-outside: circle(50%); margin-right: 4px; margin-bottom: 4px; position: relative; }\n.margin-visual { display: flex; align-items: center; gap: 10px; margin-top: 10px; }\n.mv-circle-wrapper { position: relative; width: 48px; height: 48px; }\n.mv-inner { width: 30px; height: 30px; background: #e94560; border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }\n.mv-outer { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border-radius: 50%; border: 1px dashed #e9456066; }\n.mv-text { font-size: 11px; color: #7b8794; }"
