demo_type: TEXT
title: "Speak As"
target_base_style: "background: #0a0a1a; border-radius: 8px; padding: 16px;"
target_inner_html: "<div class=\"input-row\"><span class=\"input-label\">text:</span><span class=\"input-text\">Hello 2024!</span></div><div class=\"output-row\"><div class=\"speaker-icon\" style=\"background: #e9456033; color: #e94560;\">&#9835;</div><div class=\"speech-bubble\">\"Hello <span class=\"highlight\">twenty twenty-four</span>!\"</div></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px;"
extra_css: ".demos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }\n.note { font-size: 12px; color: #7b8794; margin-bottom: 20px; padding: 10px 14px; background: #16213e; border-radius: 8px; border-left: 3px solid #e94560; }\n.input-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }\n.input-label { font-size: 10px; font-family: monospace; color: #7b8794; text-transform: uppercase; }\n.input-text { font-size: 16px; color: #fff; font-weight: 600; letter-spacing: 1px; }\n.output-row { display: flex; align-items: flex-start; gap: 10px; }\n.output-label { font-size: 10px; font-family: monospace; color: #7b8794; text-transform: uppercase; margin-top: 3px; }\n.speech-bubble { background: #16213e; border-radius: 8px; padding: 10px 14px; font-size: 13px; color: #e0e0e0; position: relative; line-height: 1.5; flex: 1; }\n.speech-bubble::before { content: ''; position: absolute; left: -6px; top: 10px; width: 0; height: 0; border-style: solid; border-width: 6px 6px 6px 0; border-color: transparent #16213e transparent transparent; }\n.speaker-icon { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }\n.highlight { color: #e94560; font-weight: 600; }\n.badge-audio { background: #64b5f633; color: #64b5f6; }"
