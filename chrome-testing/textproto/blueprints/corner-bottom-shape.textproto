demo_type: BOX
title: "Corner Bottom Shape"
target_base_style: "width: 180px; height: 170px; background: linear-gradient(180deg, #0f3460, #16213e); border: 3px solid #a855f7; border-radius: 30px; display: flex; align-items: center; justify-content: center; position: relative;"
target_inner_html: "<span style=\"font-size:14px;color:#c0c0c0;\">round</span><div class=\"corner-dot inactive\" style=\"top:-8px;left:-8px;\"></div><div class=\"corner-dot inactive\" style=\"top:-8px;right:-8px;\"></div><div class=\"corner-dot active\" style=\"bottom:-8px;left:-8px;\"></div><div class=\"corner-dot active\" style=\"bottom:-8px;right:-8px;\"></div>"
extra_css: ".corner-dot { position: absolute; width: 16px; height: 16px; border-radius: 50%; }\n.active { background: #a855f7; box-shadow: 0 0 8px #a855f788; }\n.inactive { background: #444; opacity: 0.3; }"
