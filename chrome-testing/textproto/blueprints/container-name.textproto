demo_type: BOX
title: "Container Name"
target_base_style: "container-type: inline-size; background: #0f1a30; border-radius: 8px; padding: 16px; border: 2px solid #2a2a4a; position: relative;"
child_elements: "<div class=\"name-tag\">name</div>"
child_elements: "<div class=\"inner-card\"><div class=\"inner-title\">Named Section</div><div class=\"inner-text\">This container has a specific name. Child elements can target it with @container queries using this name for component-level responsive design.</div></div>"
extra_css: ".name-tag { position: absolute; top: -9px; left: 14px; font-size: 10px; font-family: monospace; padding: 1px 10px; border-radius: 3px; font-weight: 600; background: #4fc3f7; color: #0f1a30; }\n.inner-card { background: #1a2440; border: 1px solid #3a3a5a; border-radius: 6px; padding: 12px; }\n.inner-title { font-size: 13px; font-weight: 600; margin-bottom: 4px; color: #4fc3f7; }\n.inner-text { font-size: 11px; color: #9ca3af; line-height: 1.5; }"
screenshot_textproto: "static"
