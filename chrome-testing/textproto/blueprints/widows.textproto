demo_type: MULTICOL
title: "Widows"
target_tag: "p"
target_base_style: "font-size: 9.5px; line-height: 1.5; column-count: 2; column-gap: 6px; column-rule: 1px dashed #ccc; height: 100%;"
target_inner_html: "The concept of widows in typography refers to the minimum number of lines of a paragraph that must appear at the top of a new page or column. When widows is set to a given value, at least that many lines must appear at the top of a new column. This provides a balance between space usage and readability, ensuring paragraphs don't feel too fragmented across columns."
wrapper_style: "background: #f5f5f0; border-radius: 4px; padding: 10px; width: 130px; height: 340px; color: #1a1a2e; font-size: 10px; line-height: 1.6; overflow: hidden;"
