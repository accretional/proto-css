demo_type: SCROLL
title: "Overflow X"
target_base_style: "width: 100%; height: 100px; background: #0f3460; border-radius: 6px; border: 2px solid #3a3a5c; padding: 12px; overflow-y: hidden;"
target_inner_html: "<div class=\"wide-content\"><div class=\"block b1\">A</div><div class=\"block b2\">B</div><div class=\"block b3\">C</div><div class=\"block b4\">D</div><div class=\"block b5\">E</div><div class=\"block b6\">F</div></div>"
extra_css: ".wide-content { width: 500px; white-space: nowrap; display: flex; gap: 8px; align-items: center; }\n.block { min-width: 80px; height: 60px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; color: #fff; }\n.b1 { background: #e94560; }\n.b2 { background: #0077ff; }\n.b3 { background: #00cc66; }\n.b4 { background: #f5a623; }\n.b5 { background: #7b68ee; }\n.b6 { background: #00d2ff; }"
