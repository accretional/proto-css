demo_type: IMAGE
title: "Object Position"
target_tag: "img"
target_base_style: "width: 150px; height: 100px; object-fit: none; display: block; border-radius: 4px; background: #0f3460;"
wrapper_style: "width: 154px; height: 104px; border: 2px dashed #4fc3f744; border-radius: 8px; overflow: hidden; background: #0a0a1e; position: relative;"
siblings_after: "<script>var img=document.currentScript.closest('.demo-area').querySelector('img');img.src='data:image/svg+xml,'+encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"500\" height=\"400\" viewBox=\"0 0 500 400\"><rect width=\"500\" height=\"400\" fill=\"#1a1a3e\"/><circle cx=\"250\" cy=\"50\" r=\"40\" fill=\"#e94560\"/><text x=\"250\" y=\"55\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\" font-weight=\"bold\">TOP</text><circle cx=\"250\" cy=\"350\" r=\"40\" fill=\"#22c55e\"/><text x=\"250\" y=\"355\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\" font-weight=\"bold\">BTM</text><circle cx=\"75\" cy=\"200\" r=\"40\" fill=\"#0ea5e9\"/><text x=\"75\" y=\"205\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\" font-weight=\"bold\">LEFT</text><circle cx=\"425\" cy=\"200\" r=\"40\" fill=\"#f59e0b\"/><text x=\"425\" y=\"205\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\" font-weight=\"bold\">RIGHT</text><circle cx=\"250\" cy=\"200\" r=\"35\" fill=\"#a855f7\"/><text x=\"250\" y=\"205\" text-anchor=\"middle\" fill=\"white\" font-size=\"10\" font-weight=\"bold\">CTR</text></svg>');</script>"
screenshot_textproto: "static"
