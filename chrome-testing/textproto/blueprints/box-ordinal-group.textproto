demo_type: FLEX
title: "Box Ordinal Group (deprecated)"
target_base_style: "display: -webkit-box; -webkit-box-orient: horizontal; width: 100%; max-width: 800px; height: 80px; background: #16213e; border: 2px solid #333;"
child_elements: "<div class=\"child\" style=\"-webkit-box-ordinal-group: 1;\">A <small>ordinal: 1</small></div>"
child_elements: "<div class=\"child\" style=\"-webkit-box-ordinal-group: 1;\">B <small>ordinal: 1</small></div>"
child_elements: "<div class=\"child\" style=\"-webkit-box-ordinal-group: 1;\">C <small>ordinal: 1</small></div>"
child_elements: "<div class=\"child\" style=\"-webkit-box-ordinal-group: 1;\">D <small>ordinal: 1</small></div>"
extra_css: ".child { -webkit-box-flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 16px; font-weight: bold; color: #fff; border-right: 2px solid #1a1a2e; }\n.child small { font-size: 10px; font-weight: normal; opacity: 0.7; margin-top: 2px; }\n.child:nth-child(1) { background: #e94560; }\n.child:nth-child(2) { background: #0f3460; }\n.child:nth-child(3) { background: #53d769; color: #1a1a2e; }\n.child:nth-child(4) { background: #fbbf24; color: #1a1a2e; }"
screenshot_textproto: "static"
