demo_type: SCROLL
title: "Scroll Margin Right"
target_base_style: "width: 100%; height: 120px; overflow-x: auto; overflow-y: hidden; border: 2px solid #333; border-radius: 10px; background: #16213e; scroll-snap-type: x mandatory; display: flex; position: relative;"
child_elements: "<div class=\"snap-item\">1</div>"
child_elements: "<div class=\"snap-item\">2</div>"
child_elements: "<div class=\"snap-item\">3</div>"
child_elements: "<div class=\"snap-item\">4</div>"
child_elements: "<div class=\"snap-item\">5</div>"
extra_css: ".snap-item { min-width: 280px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; scroll-snap-align: end; flex-shrink: 0; }\n.snap-item:nth-child(1) { background: linear-gradient(135deg, #14b8a6, #06b6d4); }\n.snap-item:nth-child(2) { background: #22224a; }\n.snap-item:nth-child(3) { background: linear-gradient(135deg, #f59e0b, #f97316); }\n.snap-item:nth-child(4) { background: #22224a; }\n.snap-item:nth-child(5) { background: linear-gradient(135deg, #6366f1, #8b5cf6); }"
