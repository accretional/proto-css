demo_type: TABLE
title: "Caption Side"
target_tag: "table"
target_base_style: "width: 100%; border-collapse: collapse; font-size: 13px;"
target_inner_html: "<caption>Sales Report Q1</caption><thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead><tbody><tr><td>Widget A</td><td>1,240</td><td>$24,800</td></tr><tr><td>Widget B</td><td>860</td><td>$17,200</td></tr><tr><td>Widget C</td><td>2,100</td><td>$42,000</td></tr><tr><td>Widget D</td><td>530</td><td>$10,600</td></tr></tbody>"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 24px; width: 480px;"
extra_css: "caption { font-size: 15px; font-weight: 600; color: #e94560; padding: 10px 0; text-align: left; }\nth { background: #0f3460; color: #7ec8e3; text-align: left; padding: 10px 14px; font-weight: 600; font-size: 12px; }\ntd { padding: 10px 14px; border-bottom: 1px solid #2a2a4a; color: #c0c0d0; }\ntr:last-child td { border-bottom: none; }"
screenshot_textproto: "static"
