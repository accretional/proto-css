demo_type: SCROLL
title: "Overscroll Behavior X"
target_base_style: "width: 220px; height: 100px; border-radius: 6px; overflow-x: auto; overflow-y: hidden; padding: 10px; font-size: 12px; color: #c0c0c0; white-space: nowrap; flex-shrink: 0; background: #2a1a3e; border: 2px solid #e94560;"
target_inner_html: "<div class=\"inner-wide-content\"><p>Scroll horizontally past the inner boundary. X-axis overscroll chains to parent.</p><p>This is the default behavior for horizontal scrolling.</p></div>"
wrapper_style: "width: 320px; height: 150px; background: #0f3460; border-radius: 8px; overflow-x: auto; overflow-y: hidden; white-space: nowrap;"
siblings_before: "<span class=\"outer-label\">&#8592;</span>"
siblings_after: "<span class=\"outer-label\">Outer content &#8594; &#8594; &#8594; &#8594; &#8594;</span>"
extra_css: ".outer-label { font-size: 11px; color: #5a7aa0; white-space: nowrap; }\n.inner-wide-content { display: inline-block; min-width: 500px; }\n.inner-wide-content p { margin-bottom: 4px; white-space: normal; width: 480px; }"
