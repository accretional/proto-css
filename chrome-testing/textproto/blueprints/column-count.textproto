demo_type: MULTICOL
title: "Column Count"
target_base_style: "font-size: 12px; line-height: 1.6; color: #c0c8d4; column-rule: 1px solid #3a3a5a;"
target_inner_html: "The column-count property specifies the number of columns an element should be divided into. This text flows naturally across the columns. The browser automatically balances content between columns for even distribution. Each column receives roughly equal content."
max_values: 4
