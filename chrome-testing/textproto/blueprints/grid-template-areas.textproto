demo_type: GRID
title: "Grid Template Areas"
target_base_style: "display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 50px 50px; gap: 6px;"
child_elements: "<div class=\"cell\">1</div>"
child_elements: "<div class=\"cell\">2</div>"
child_elements: "<div class=\"cell\">3</div>"
child_elements: "<div class=\"cell\">4</div>"
child_elements: "<div class=\"cell\">5</div>"
child_elements: "<div class=\"cell\">6</div>"
extra_css: ".cell { border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; padding: 8px; background: #0f3460; color: #e94560; }"
