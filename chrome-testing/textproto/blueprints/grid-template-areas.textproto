demo_type: GRID
title: "Grid Template Areas"
target_base_style: "display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 40px 40px 40px; gap: 6px;"
child_elements: "<div class=\"cell\" style=\"grid-area: a;\">a</div>"
child_elements: "<div class=\"cell c2\" style=\"grid-area: b;\">b</div>"
child_elements: "<div class=\"cell c3\" style=\"grid-area: c;\">c</div>"
child_elements: "<div class=\"cell c4\" style=\"grid-area: d;\">d</div>"
child_elements: "<div class=\"cell c5\" style=\"grid-area: e;\">e</div>"
extra_css: ".cell { border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; padding: 8px; background: #e94560; color: #fff; }\n.cell.c2 { background: #0ea5e9; }\n.cell.c3 { background: #22c55e; }\n.cell.c4 { background: #f59e0b; }\n.cell.c5 { background: #8b5cf6; }"
max_values: 8
screenshot_textproto: "static"
