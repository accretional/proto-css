demo_type: GRID
title: "Grid Template Areas"
target_base_style: "display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;"
child_elements: "<div class=\"cell\">1</div>"
child_elements: "<div class=\"cell c2\">2</div>"
child_elements: "<div class=\"cell c3\">3</div>"
child_elements: "<div class=\"cell c4\">4</div>"
child_elements: "<div class=\"cell c5\">5</div>"
child_elements: "<div class=\"cell c6\">6</div>"
extra_css: ".cell { border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; padding: 8px; background: #e94560; color: #fff; min-height: 36px; }\n.cell.c2 { background: #0ea5e9; }\n.cell.c3 { background: #22c55e; }\n.cell.c4 { background: #f59e0b; }\n.cell.c5 { background: #8b5cf6; }\n.cell.c6 { background: #06b6d4; }"
max_values: 6
screenshot_textproto: "static"
