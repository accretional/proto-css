demo_type: BOX
title: "Interpolate Size"
target_base_style: "background: #0f3460; border-radius: 6px; padding: 16px; min-height: 200px;"
target_inner_html: "<p class=\"instruction\">Transition behavior with keyword sizes like auto</p><div class=\"vis-row\"><div class=\"vis-box grow-box\" style=\"height: 40px;\">40px</div><div class=\"arrow\">&#8594;</div><div class=\"vis-box\" style=\"height: 100px;\">100px</div></div><div class=\"vis-row\"><div class=\"vis-box grow-box\" style=\"height: 40px;\">40px</div><div class=\"arrow\">&#8594;</div><div class=\"vis-box\" style=\"height: 80px;\">auto</div></div>"
wrapper_style: "background: #16213e; border-radius: 8px; padding: 24px; width: 360px;"
extra_css: ".instruction { font-size: 11px; color: #9ca3af; margin-bottom: 12px; font-style: italic; }\n.vis-row { display: flex; gap: 8px; align-items: flex-end; margin-bottom: 12px; }\n.vis-box { border-radius: 4px; display: flex; align-items: flex-end; justify-content: center; padding: 4px; font-size: 9px; font-family: monospace; color: rgba(255,255,255,0.7); width: 60px; background: linear-gradient(180deg, #e94560, #921b33); }\n.grow-box { transition: height 1.5s ease; }\n.arrow { color: #e94560; font-size: 18px; align-self: center; }\n.demo-area .grow-box.active { height: 100px !important; }"
screenshot_textproto: "temporal"
