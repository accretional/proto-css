demo_type: BOX
title: "Contain Intrinsic Size (Shorthand)"
target_base_style: "contain: size layout; background: #0f1a30; border: 2px solid #2a2a4a; border-radius: 6px; padding: 12px; position: relative; overflow: hidden;"
