demo_type: BOX
title: "Math Shift"
target_tag: "div"
target_base_style: "background: #0f3460; border-radius: 8px; padding: 28px 36px; display: flex; flex-direction: column; align-items: center; gap: 24px; width: 100%;"
target_inner_html: "<div class=\"math-row\"><math display=\"block\"><msup><mi>x</mi><mn>2</mn></msup></math><math display=\"block\"><msup><mi>e</mi><mrow><mi>i</mi><mi>&pi;</mi></mrow></msup></math><math display=\"block\"><msup><mn>2</mn><mn>10</mn></msup></math></div><div class=\"guide-line\"></div><div class=\"math-row\"><math display=\"block\"><msup><mi>a</mi><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></msup></math><math display=\"block\"><msup><mi>y</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></math></div>"
extra_css: "math { font-size: 36px; color: #e0e0e0; }\n.math-row { display: flex; align-items: baseline; gap: 16px; }\n.guide-line { width: 100%; border-top: 1px dashed #4fc3f744; margin-top: 4px; }"
