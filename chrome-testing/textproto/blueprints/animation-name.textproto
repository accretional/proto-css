demo_type: BOX
title: "Animation Name"
target_base_style: "width: 80px; height: 80px; background: #e94560; border-radius: 8px; animation-duration: 2s; animation-timing-function: linear; animation-iteration-count: infinite; animation-delay: -0.7s;"
wrapper_style: "display: flex; align-items: center; justify-content: center; min-height: 140px; position: relative;"
max_values: 6
extra_css: "@keyframes slide {\n  0% { transform: translateX(-100px); background: #e94560; }\n  50% { transform: translateX(100px); background: #3498db; }\n  100% { transform: translateX(-100px); background: #e94560; }\n}\n@keyframes fade {\n  0% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.1; transform: scale(0.3); }\n  100% { opacity: 1; transform: scale(1); }\n}\n@keyframes spin {\n  0% { transform: rotate(0deg) scale(1); border-radius: 8px; }\n  50% { transform: rotate(180deg) scale(1.8); border-radius: 50%; }\n  100% { transform: rotate(360deg) scale(1); border-radius: 8px; }\n}\n@keyframes bounce {\n  0%, 100% { transform: translateY(0); background: #e94560; border-radius: 8px; }\n  25% { transform: translateY(-80px); background: #f39c12; border-radius: 50%; }\n  50% { transform: translateY(0); background: #2ecc71; border-radius: 0; }\n  75% { transform: translateY(-40px); background: #a855f7; border-radius: 50%; }\n}"
screenshot_textproto: "temporal"
