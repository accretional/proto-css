demo_type: BOX
title: "Backdrop Filter"
target_base_style: "position: absolute; bottom: 0; left: 0; right: 0; height: 70px; border-top: 1px solid rgba(255,255,255,0.15); display: flex; flex-direction: column; justify-content: center; padding: 10px; background: rgba(26, 26, 46, 0.25);"
wrapper_style: "border-radius: 12px; position: relative; overflow: hidden; height: 200px;"
siblings_before: "<div class=\"bg-pattern\"></div>"
siblings_before: "<div class=\"bg-shapes\"><div class=\"shape s1\"></div><div class=\"shape s2\"></div><div class=\"shape s3\"></div><div class=\"shape s4\"></div></div>"
extra_css: ".bg-pattern { position: absolute; inset: 0; background: linear-gradient(135deg, #e94560 0%, #533bdb 25%, #0ea5e9 50%, #10b981 75%, #f59205 100%); }\n.bg-shapes { position: absolute; inset: 0; }\n.shape { position: absolute; border-radius: 50%; }\n.s1 { width: 50px; height: 50px; background: #e94560; top: 8px; left: 8px; }\n.s2 { width: 40px; height: 40px; background: #fff; top: 20px; right: 12px; }\n.s3 { width: 45px; height: 45px; background: #f59205; bottom: 50px; left: 20px; }\n.s4 { width: 35px; height: 35px; background: #533bdb; bottom: 50px; right: 8px; }"
screenshot_textproto: "static"
