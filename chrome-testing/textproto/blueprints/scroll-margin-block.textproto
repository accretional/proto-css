demo_type: SCROLL
title: "Scroll Margin Block"
target_base_style: "width: 100%; height: 260px; overflow-y: auto; border: 2px solid #333; border-radius: 10px; background: #16213e; scroll-snap-type: y mandatory; position: relative;"
child_elements: "<div class=\"snap-item\">1</div>"
child_elements: "<div class=\"snap-item\">2</div>"
child_elements: "<div class=\"snap-item\">3</div>"
child_elements: "<div class=\"snap-item\">4</div>"
child_elements: "<div class=\"snap-item\">5</div>"
extra_css: ".snap-item { height: 130px; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; scroll-snap-align: start; border-bottom: 1px solid #2a2a4a; }\n.snap-item:nth-child(1) { background: linear-gradient(135deg, #6366f1, #8b5cf6); }\n.snap-item:nth-child(2) { background: #22224a; }\n.snap-item:nth-child(3) { background: linear-gradient(135deg, #ec4899, #f43f5e); }\n.snap-item:nth-child(4) { background: #22224a; }\n.snap-item:nth-child(5) { background: linear-gradient(135deg, #14b8a6, #06b6d4); }"
screenshot_textproto: "scroll"
