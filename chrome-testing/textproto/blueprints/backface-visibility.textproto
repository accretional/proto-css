demo_type: BOX
title: "Backface Visibility"
target_base_style: "width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transform: rotateY(135deg);"
target_inner_html: "<div class=\"card-face card-front\">FRONT</div><div class=\"card-face card-back\">BACK</div>"
wrapper_style: "width: 110px; height: 140px; perspective: 600px;"
extra_css: ".card-face { position: absolute; inset: 0; border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; }\n.card-front { background: linear-gradient(135deg, #e94560, #533bdb); color: #fff; }\n.card-back { background: linear-gradient(135deg, #0ea5e9, #10b981); color: #fff; transform: rotateY(180deg); }"
