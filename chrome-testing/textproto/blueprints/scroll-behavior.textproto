demo_type: SCROLL
title: "Scroll Behavior"
target_base_style: "width: 100%; height: 280px; overflow-y: auto; border: 2px solid #333; border-radius: 10px; background: #16213e; position: relative;"
child_elements: "<div class=\"scroll-item\">Section 1</div>"
child_elements: "<div class=\"scroll-item\">Section 2</div>"
child_elements: "<div class=\"scroll-item\">Section 3</div>"
child_elements: "<div class=\"scroll-item\">Section 4</div>"
child_elements: "<div class=\"scroll-item\">Section 5</div>"
child_elements: "<div class=\"scroll-item\">Section 6</div>"
extra_css: ".scroll-item { height: 140px; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 600; border-bottom: 1px solid #2a2a4a; }\n.scroll-item:nth-child(odd) { background: #1a1a3e; }\n.scroll-item:nth-child(even) { background: #22224a; }\n.scroll-item:nth-child(1) { background: linear-gradient(135deg, #6366f1, #8b5cf6); }\n.scroll-item:nth-child(4) { background: linear-gradient(135deg, #ec4899, #f43f5e); }\n.scroll-item:nth-child(6) { background: linear-gradient(135deg, #14b8a6, #06b6d4); }"
