demo_type: BOX
title: "Animation Duration"
target_base_style: "position: absolute; left: 0; top: 0; width: 48px; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; color: #fff; background: #e94560; animation: slideBar 2s linear infinite; animation-delay: -0.25s;"
wrapper_style: "position: relative; height: 50px; background: #0f3460; border-radius: 8px; overflow: hidden;"
max_values: 8
extra_css: "@keyframes slideBar {\n  from { left: 0; }\n  to { left: calc(100% - 48px); }\n}"
screenshot_textproto: "temporal"
