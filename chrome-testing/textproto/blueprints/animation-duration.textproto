demo_type: BOX
title: "Animation Duration"
target_base_style: "position: absolute; left: 0; top: 0; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: flex-end; padding-right: 12px; font-size: 11px; font-weight: bold; color: #fff; background: #e94560; animation: fillTrack 2s linear; animation-play-state: paused; animation-delay: -0.25s;"
wrapper_style: "display: flex; align-items: center; gap: 16px; background: #16213e; border-radius: 10px; padding: 16px 24px;"
extra_css: ".row-label { font-size: 12px; font-family: monospace; color: #9ca3af; width: 240px; flex-shrink: 0; }\n.track { flex: 1; height: 50px; background: #0f3460; border-radius: 8px; position: relative; overflow: hidden; }\n@keyframes fillTrack {\n  from { width: 0%; }\n  to { width: 100%; }\n}"
