demo_type: BOX
title: "Transition Shorthand"
target_inner_html: "<div class=\"state-row\"><div class=\"state-label\">before</div><div class=\"box d1-before\"></div><div class=\"arrow\">&#10132;</div><div class=\"state-label\">after</div><div class=\"box d1-after\"></div></div>"
target_base_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 380px;"
extra_css: ".state-row { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }\n.state-label { font-size: 10px; font-family: monospace; color: #6b7280; width: 50px; text-align: center; }\n.box { width: 70px; height: 70px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-family: monospace; color: #fff; }\n.arrow { color: #4a5568; font-size: 20px; }\n.d1-before { background: #e94560; opacity: 1; }\n.d1-after { background: #e94560; opacity: 0.2; }"
