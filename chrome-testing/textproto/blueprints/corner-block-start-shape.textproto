demo_type: BOX
title: "Corner Block Start Shape"
target_base_style: "width: 160px; height: 160px; background: linear-gradient(135deg, #0f3460, #16213e); border: 3px solid #00d2ff; border-radius: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #c0c0c0; position: relative;"
target_inner_html: "<span>round</span><div class=\"corner-dot active\" style=\"top:-8px;left:-8px;\"></div><div class=\"corner-dot active\" style=\"top:-8px;right:-8px;\"></div><div class=\"corner-dot inactive\" style=\"bottom:-8px;left:-8px;\"></div><div class=\"corner-dot inactive\" style=\"bottom:-8px;right:-8px;\"></div>"
extra_css: ".corner-dot { position: absolute; width: 16px; height: 16px; border-radius: 50%; }\n.active { background: #00d2ff; }\n.inactive { background: #7b8794; opacity: 0.3; }"
screenshot_textproto: "static"
