demo_type: GRID
title: "Grid Auto Columns"
target_base_style: "display: grid; grid-template-columns: 80px; grid-auto-flow: column; gap: 8px; min-width: 350px; min-height: 80px;"
child_elements: "<div class=\"cell\">Defined</div>"
child_elements: "<div class=\"cell\">Auto 1</div>"
child_elements: "<div class=\"cell\">Auto 2</div>"
child_elements: "<div class=\"cell\">Auto 3</div>"
child_elements: "<div class=\"cell\">Auto 4</div>"
child_elements: "<div class=\"cell\">Auto 5</div>"
extra_css: ".cell { background: #0f3460; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #e94560; font-weight: 600; padding: 8px; min-height: 50px; }\n.cell:nth-child(odd) { background: #1a4a7a; }"
screenshot_textproto: "static"
