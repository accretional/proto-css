demo_type: BOX
title: "Math Style"
target_tag: "div"
target_base_style: "background: #0f3460; border-radius: 8px; padding: 24px 32px; display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%;"
target_inner_html: "<div><math display=\"block\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow></mfrac></math><p class=\"formula-label\">fraction</p></div><div><math display=\"block\"><munderover><mo>&sum;</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><msub><mi>a</mi><mi>i</mi></msub></math><p class=\"formula-label\">summation</p></div>"
extra_css: "math { font-size: 32px; color: #e0e0e0; }\n.formula-label { font-size: 11px; color: #7b8794; font-family: monospace; margin-top: 4px; }"
screenshot_textproto: "static"
