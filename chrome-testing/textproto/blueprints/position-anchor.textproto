demo_type: POSITION
title: "Position Anchor"
target_base_style: "position: absolute; padding: 6px 14px; background: linear-gradient(135deg, #e94560, #c23066); border: 2px solid rgba(255,255,255,0.3); border-radius: 8px; font-size: 11px; font-weight: 600; color: #fff; white-space: nowrap; bottom: anchor(top); left: anchor(center); translate: -50% -8px;"
target_inner_html: "Tooltip"
wrapper_style: "width: 310px; height: 220px; position: relative; border: 2px dashed rgba(255,255,255,0.12); border-radius: 8px; background: #16213e; padding: 24px;"
siblings_before: "<div class=\"anchor-el\" style=\"anchor-name: --my-anchor; position: absolute; top: 120px; left: 100px;\">Anchor</div>"
extra_css: ".anchor-el { width: 90px; height: 40px; background: linear-gradient(135deg, #0f3460, #1a5276); border: 2px solid #3498db; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: #7ec8e3; }"
max_values: 4
screenshot_textproto: "static"
