demo_type: TABLE
title: "Empty Table Cells"
target_tag: "table"
target_base_style: "border-collapse: separate; border-spacing: 6px; width: 100%;"
target_inner_html: "<tr><th>Name</th><th>Email</th><th>Phone</th></tr><tr><td>Alice</td><td>alice@mail.com</td><td>555-0101</td></tr><tr><td>Bob</td><td></td><td>555-0202</td></tr><tr><td></td><td>carol@mail.com</td><td></td></tr><tr><td>Dave</td><td></td><td></td></tr>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; flex: 1;"
extra_css: "th { background: #e94560; color: #fff; padding: 10px 14px; font-size: 13px; border-radius: 4px; text-align: left; }\ntd { background: #0f3460; padding: 10px 14px; font-size: 13px; border-radius: 4px; border: 2px solid #233d6e; }"
