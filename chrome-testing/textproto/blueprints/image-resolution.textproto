demo_type: IMAGE
title: "Image Resolution"
target_base_style: "width: 200px; height: 200px; border-radius: 6px; background: linear-gradient(135deg, #e94560, #0f3460, #53a653); display: flex; align-items: center; justify-content: center; position: relative;"
target_inner_html: "<span class=\"res-label\">1x</span><span class=\"dpi-overlay\">dppx</span>"
extra_css: ".res-label { font-size: 28px; font-weight: 700; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.5); }\n.dpi-overlay { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.6); color: #9ca3af; font-size: 10px; font-family: monospace; padding: 3px 7px; border-radius: 4px; }"
screenshot_textproto: "static"
