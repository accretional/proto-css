demo_type: SCROLL
title: "Scroll Padding Inline"
target_base_style: "width: 100%; height: 130px; overflow-x: auto; border: 2px solid #333; border-radius: 10px; background: #16213e; scroll-snap-type: x mandatory; display: flex;"
child_elements: "<div class=\"snap-item\">Panel 1</div>"
child_elements: "<div class=\"snap-item\">Panel 2</div>"
child_elements: "<div class=\"snap-item\">Panel 3</div>"
child_elements: "<div class=\"snap-item\">Panel 4</div>"
child_elements: "<div class=\"snap-item\">Panel 5</div>"
extra_css: ".snap-item { min-width: 250px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; scroll-snap-align: start; flex-shrink: 0; }\n.snap-item:nth-child(odd) { background: linear-gradient(135deg, #f59e0b, #d97706); }\n.snap-item:nth-child(even) { background: #22224a; color: #a5b4fc; }"
