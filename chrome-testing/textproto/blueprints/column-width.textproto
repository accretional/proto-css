demo_type: MULTICOL
title: "Column Width"
target_base_style: "column-rule: 1px solid #3a3a5a; font-size: 12px; line-height: 1.6; color: #c0c8d4;"
target_inner_html: "Setting column-width controls how wide each column should be. The browser calculates how many columns fit in the container and adjusts widths to fill the space evenly."
extra_css: ".width-hint { font-size: 10px; color: #4fc3f7; margin-top: 6px; font-family: monospace; }"
