demo_type: LIST
title: "Counter Increment"
target_tag: "ol"
target_inner_html: "<li>First</li><li>Second</li><li>Third</li><li>Fourth</li><li>Fifth</li>"
target_base_style: "list-style: none; counter-reset: my-custom 0;"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 20px; width: 260px;"
extra_css: "ol li { padding: 4px 0; font-size: 14px; color: #c0c8d4; counter-increment: my-custom 1; }\nol li::before { content: counter(my-custom) '. '; color: #e94560; font-weight: bold; font-family: monospace; min-width: 36px; display: inline-block; }"
screenshot_textproto: "static"
