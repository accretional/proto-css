demo_type: BOX
title: "Corner End-End Shape"
target_base_style: "width: 170px; height: 170px; background: linear-gradient(200deg, #16213e, #0f3460); border: 3px solid #e94560; border-radius: 30px; display: flex; align-items: center; justify-content: center; position: relative;"
target_inner_html: "<span style=\"font-size:14px;color:#c0c0c0;\">round</span><div class=\"corner-dot dim\" style=\"top:-9px;left:-9px;\"></div><div class=\"corner-dot dim\" style=\"top:-9px;right:-9px;\"></div><div class=\"corner-dot dim\" style=\"bottom:-9px;left:-9px;\"></div><div class=\"corner-dot highlight\" style=\"bottom:-9px;right:-9px;\"></div>"
extra_css: ".corner-dot { position: absolute; width: 18px; height: 18px; border-radius: 50%; }\n.highlight { background: #e94560; box-shadow: 0 0 10px #e9456088; }\n.dim { background: #444; opacity: 0.3; }"
screenshot_textproto: "static"
