demo_type: BOX
title: "Pointer Events"
target_base_style: "width: 180px; height: 80px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; background: linear-gradient(135deg, #00b4d8, #0077b6); color: #fff; border: 2px solid rgba(255,255,255,0.3); cursor: pointer;"
target_inner_html: "Click Me"
wrapper_style: "width: 280px; height: 160px; position: relative; border: 2px dashed rgba(255,255,255,0.15); border-radius: 8px; display: flex; align-items: center; justify-content: center;"
extra_css: ".demo-area > div:hover { transform: scale(1.05); box-shadow: 0 4px 15px rgba(0,180,216,0.4); transition: transform 0.2s, box-shadow 0.2s; }"
screenshot_textproto: "hover"
