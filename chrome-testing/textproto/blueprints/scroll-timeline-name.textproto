demo_type: SCROLL
title: "Scroll Timeline Name"
target_base_style: "background: #0a0a1a; border-radius: 8px; padding: 16px;"
target_inner_html: "<div class=\"tl-row tl-a\"><div class=\"tl-container\">Scroller<br>A</div><div class=\"tl-name\">--hero-scroll</div><div class=\"tl-arrow\"></div><div class=\"tl-target\">&#9632;</div></div><div class=\"tl-row tl-b\"><div class=\"tl-container\">Scroller<br>B</div><div class=\"tl-name\">--sidebar</div><div class=\"tl-arrow\"></div><div class=\"tl-target\">&#9650;</div></div><div class=\"tl-row tl-c\"><div class=\"tl-container\">Scroller<br>C</div><div class=\"tl-name\">--gallery</div><div class=\"tl-arrow\"></div><div class=\"tl-target\">&#9679;</div></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 370px;"
extra_css: ".experimental { display: inline-block; background: #e9456033; color: #e94560; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px; margin-left: 8px; vertical-align: middle; }\n.tl-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }\n.tl-row:last-child { margin-bottom: 0; }\n.tl-container { width: 80px; height: 50px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-family: monospace; color: #fff; text-align: center; flex-shrink: 0; }\n.tl-arrow { width: 40px; height: 2px; position: relative; flex-shrink: 0; }\n.tl-arrow::after { content: ''; position: absolute; right: 0; top: -4px; width: 0; height: 0; border-style: solid; border-width: 5px 0 5px 8px; }\n.tl-target { width: 60px; height: 36px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 18px; }\n.tl-name { font-size: 10px; font-family: monospace; padding: 2px 6px; border-radius: 3px; flex-shrink: 0; }\n.tl-a .tl-container { background: #e9456044; border: 1px solid #e94560; }\n.tl-a .tl-arrow { background: #e94560; }\n.tl-a .tl-arrow::after { border-color: transparent transparent transparent #e94560; }\n.tl-a .tl-target { background: #e9456033; }\n.tl-a .tl-name { background: #e9456022; color: #e94560; }\n.tl-b .tl-container { background: #2ecc7144; border: 1px solid #2ecc71; }\n.tl-b .tl-arrow { background: #2ecc71; }\n.tl-b .tl-arrow::after { border-color: transparent transparent transparent #2ecc71; }\n.tl-b .tl-target { background: #2ecc7133; }\n.tl-b .tl-name { background: #2ecc7122; color: #2ecc71; }\n.tl-c .tl-container { background: #64b5f644; border: 1px solid #64b5f6; }\n.tl-c .tl-arrow { background: #64b5f6; }\n.tl-c .tl-arrow::after { border-color: transparent transparent transparent #64b5f6; }\n.tl-c .tl-target { background: #64b5f633; }\n.tl-c .tl-name { background: #64b5f622; color: #64b5f6; }"
