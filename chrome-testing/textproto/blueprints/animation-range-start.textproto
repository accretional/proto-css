demo_type: BOX
title: "Animation Range Start"
target_base_style: "position: relative; height: 36px; background: #0f3460; border-radius: 6px; overflow: visible;"
target_inner_html: "<div class=\"active-zone\">Active range</div><div class=\"start-marker\"><span class=\"start-label\">0%</span></div><div class=\"end-line\"></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 18px 28px;"
extra_css: ".demo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.demo-title { font-size: 13px; color: #e0e0e0; font-weight: 600; }\n.active-zone { position: absolute; top: 0; bottom: 0; left: 0; right: 0; border-radius: 6px; display: flex; align-items: center; justify-content: flex-end; padding-right: 12px; font-size: 11px; font-weight: 600; color: #fff; background: linear-gradient(90deg, #e9456020, #e9456060); }\n.start-marker { position: absolute; top: -8px; bottom: -8px; width: 4px; background: #6ee7b7; border-radius: 2px; z-index: 2; left: 0; }\n.start-label { position: absolute; top: -22px; font-size: 10px; font-family: monospace; color: #6ee7b7; font-weight: 600; white-space: nowrap; transform: translateX(-50%); }\n.end-line { position: absolute; top: 0; bottom: 0; right: 0; width: 4px; background: #f87171; border-radius: 0 2px 2px 0; z-index: 2; }\n.ticks { display: flex; justify-content: space-between; margin-top: 8px; font-size: 10px; font-family: monospace; color: #4b5563; }"
screenshot_textproto: "temporal"
