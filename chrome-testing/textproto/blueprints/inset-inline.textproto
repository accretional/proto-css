demo_type: POSITION
title: "Inset Inline"
target_base_style: "position: absolute; top: 10px; bottom: 10px; background: linear-gradient(90deg, rgba(233,69,96,0.8), rgba(15,52,96,0.8)); border: 2px solid #e94560; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-family: monospace; color: #fff;"
wrapper_style: "width: 700px; height: 60px; background: #16213e; border-radius: 8px; position: relative; border: 1px dashed #3a3a5e;"
siblings_before: "<div class=\"left-edge\"></div>"
siblings_after: "<div class=\"right-edge\"></div>"
extra_css: ".left-edge { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; background: #53a653; }\n.right-edge { position: absolute; top: 0; bottom: 0; right: 0; width: 2px; background: #f5c542; }"
