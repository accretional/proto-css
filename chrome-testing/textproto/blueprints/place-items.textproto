demo_type: GRID
title: "Place Items"
target_base_style: "width: 310px; height: 200px; display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 4px; border: 2px dashed rgba(255,255,255,0.2); border-radius: 6px;"
child_elements: "<div class=\"grid-item\">1</div>"
child_elements: "<div class=\"grid-item\">2</div>"
child_elements: "<div class=\"grid-item\">3</div>"
child_elements: "<div class=\"grid-item\">4</div>"
child_elements: "<div class=\"grid-item\">5</div>"
child_elements: "<div class=\"grid-item\">6</div>"
extra_css: ".grid-item { background: linear-gradient(135deg, #0f3460, #533483); border-radius: 6px; padding: 8px 16px; font-size: 13px; font-weight: 600; color: #fff; }"
