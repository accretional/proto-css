demo_type: BOX
title: "View Transition Class"
target_inner_html: "<div class=\"code-block\"><span class=\"selector\">.card-1</span> {<br>&nbsp;&nbsp;<span class=\"keyword\">view-transition-name:</span> <span class=\"value\">card-1</span>;<br>&nbsp;&nbsp;<span class=\"keyword\">view-transition-class:</span> <span class=\"value\">card</span>;<br>}<br><span class=\"selector\">.card-2</span> {<br>&nbsp;&nbsp;<span class=\"keyword\">view-transition-name:</span> <span class=\"value\">card-2</span>;<br>&nbsp;&nbsp;<span class=\"keyword\">view-transition-class:</span> <span class=\"value\">card</span>;<br>}<br><br><span class=\"comment\">/* Style all cards at once */</span><br><span class=\"selector\">::view-transition-group(.card)</span> {<br>&nbsp;&nbsp;<span class=\"keyword\">animation-duration:</span> <span class=\"value\">0.5s</span>;<br>}</div><div class=\"visual-group\"><div class=\"vt-element\" style=\"border-color: #e94560;\"><div class=\"vt-name\" style=\"color: #e94560;\">card-1</div><div class=\"vt-class-badge\" style=\"background: rgba(243,156,18,0.15); color: #f39c12;\">class: card</div></div><div class=\"vt-element\" style=\"border-color: #3498db;\"><div class=\"vt-name\" style=\"color: #3498db;\">card-2</div><div class=\"vt-class-badge\" style=\"background: rgba(243,156,18,0.15); color: #f39c12;\">class: card</div></div><div class=\"vt-element\" style=\"border-color: #16c79a;\"><div class=\"vt-name\" style=\"color: #16c79a;\">card-3</div><div class=\"vt-class-badge\" style=\"background: rgba(243,156,18,0.15); color: #f39c12;\">class: card</div></div></div><div class=\"arrow-group\">all share <span style=\"color: #f39c12;\">view-transition-class: card</span> for unified styling</div>"
target_base_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 560px;"
extra_css: ".badge { display: inline-block; font-size: 10px; font-family: monospace; padding: 3px 8px; border-radius: 10px; background: rgba(243,156,18,0.15); color: #f39c12; margin-bottom: 10px; }\n.code-block { background: #0d1117; border-radius: 8px; padding: 14px 18px; font-family: monospace; font-size: 11px; line-height: 1.7; }\n.keyword { color: #ff7b72; }\n.value { color: #79c0ff; }\n.comment { color: #6b7280; }\n.selector { color: #7ee787; }\n.visual-group { display: flex; gap: 12px; margin-top: 14px; }\n.vt-element { background: #0d1117; border-radius: 8px; padding: 14px; flex: 1; text-align: center; border: 2px solid; }\n.vt-name { font-size: 11px; font-family: monospace; margin-bottom: 4px; }\n.vt-class-badge { font-size: 10px; font-family: monospace; padding: 2px 8px; border-radius: 10px; display: inline-block; }\n.arrow-group { display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 10px; font-size: 10px; font-family: monospace; color: #6b7280; }\n.desc { font-size: 12px; color: #6b7280; margin-bottom: 16px; line-height: 1.5; }"
