demo_type: MULTICOL
title: "Column Fill"
target_base_style: "height: 200px; column-count: 3; column-rule: 1px solid #3a3a5a; font-size: 12px; line-height: 1.6; color: #c0c8d4; background: #0f1a30; border-radius: 6px; padding: 14px; overflow: hidden;"
target_inner_html: "Column fill controls distribution. With balance the browser equalizes column heights. With auto content fills columns sequentially from left to right, so early columns are full while later ones may be short or empty."
