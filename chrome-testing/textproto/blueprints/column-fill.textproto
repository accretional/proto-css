demo_type: MULTICOL
title: "Column Fill"
target_base_style: "height: 260px; column-count: 3; column-rule: 1px solid #3a3a5a; font-size: 12px; line-height: 1.6; color: #c0c8d4; background: #0f1a30; border-radius: 6px; padding: 14px; overflow: hidden;"
target_inner_html: "The column-fill property controls how content is distributed across columns. The browser decides whether to equalize the height of content in each column or to fill them sequentially. This creates different visual layouts depending on the chosen value. Notice how the text is spread across the columns in this example."
