demo_type: SCROLL
title: "Background Attachment"
target_base_style: "width: 100%; height: 300px; overflow-y: auto; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); position: relative; background-size: 40px 40px; background-image: linear-gradient(45deg, #e9456025 25%, transparent 25%, transparent 75%, #e9456025 75%), linear-gradient(45deg, #e9456025 25%, transparent 25%, transparent 75%, #e9456025 75%); background-position: 0 0, 20px 20px; background-color: #0f3460;"
target_inner_html: "<div class=\"scroll-content\"><div class=\"content-block\">Background is fixed relative to the element itself.</div><div class=\"content-block\">The pattern moves with page scroll, not container scroll.</div><div class=\"content-block\">This is the default behavior.</div><div class=\"content-block\">Scroll down to see the effect.</div><div class=\"content-block\">Background scrolls when the page scrolls.</div><div class=\"content-block\">But not when the element content scrolls.</div></div>"
extra_css: ".scroll-content { padding: 14px; }\n.content-block { background: rgba(26, 26, 46, 0.85); border-radius: 6px; padding: 12px; margin-bottom: 10px; font-size: 12px; color: #9ca3af; line-height: 1.5; }"
