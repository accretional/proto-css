demo_type: TEXT
title: "Unicode Bidi"
target_tag: "span"
target_inner_html: "&#1605;&#1585;&#1581;&#1576;&#1575;"
target_base_style: "color: #f39c12; unicode-bidi: normal; direction: rtl;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 18px 24px; display: flex; align-items: flex-start; gap: 24px;"
siblings_before: "<div class=\"info\"><div class=\"demo-title\">normal</div><div class=\"desc\">Does not open an additional level of embedding. Default behavior.</div><div class=\"label\">unicode-bidi: normal</div></div><div class=\"text-display mixed\"><span>Hello </span>"
siblings_after: "<span> World</span></div>"
extra_css: ".info { width: 260px; flex-shrink: 0; }\n.demo-title { font-size: 14px; font-weight: 600; color: #e0e0e0; margin-bottom: 6px; }\n.desc { font-size: 11px; color: #6b7280; line-height: 1.5; margin-top: 4px; }\n.text-display { flex: 1; background: #0d1117; border-radius: 8px; padding: 14px 18px; font-size: 15px; line-height: 1.8; min-height: 56px; display: flex; align-items: center; }\n.rtl-text { color: #f39c12; }\n.ltr-text { color: #3498db; }\n.mixed { direction: ltr; }"
