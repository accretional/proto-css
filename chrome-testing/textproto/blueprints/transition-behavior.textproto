demo_type: BOX
title: "Transition Behavior"
target_inner_html: "<div class=\"state-row\"><div class=\"state-label\">before</div><div class=\"box normal-before\">visible</div><div class=\"arrow\">&#10132;</div><div class=\"state-label\">after</div><div class=\"normal-gone\">instant jump</div></div><div class=\"code-block\"><span class=\"keyword\">transition-behavior:</span> <span class=\"value\">normal</span>;<br><span class=\"keyword\">transition:</span> <span class=\"value\">opacity 0.5s, display 0.5s</span>;<br><span style=\"color:#6b7280\">/* display jumps immediately, opacity ignored */</span></div>"
target_base_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 560px;"
extra_css: ".state-row { display: flex; align-items: center; gap: 20px; margin-bottom: 10px; }\n.state-label { font-size: 10px; font-family: monospace; color: #6b7280; width: 50px; text-align: center; flex-shrink: 0; }\n.arrow { color: #4a5568; font-size: 20px; }\n.box { width: 100px; height: 60px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-family: monospace; color: #fff; }\n.normal-before { background: #e94560; display: flex; }\n.normal-after { background: #e94560; display: none; position: relative; }\n.normal-after::after { content: \"gone\"; position: absolute; }\n.normal-gone { width: 100px; height: 60px; border-radius: 8px; border: 2px dashed #4a5568; display: flex; align-items: center; justify-content: center; font-size: 10px; font-family: monospace; color: #4a5568; }\n.discrete-before { background: #16c79a; opacity: 1; }\n.discrete-mid { background: #16c79a; opacity: 0.5; }\n.discrete-after { background: transparent; border: 2px dashed #4a5568; opacity: 0; }\n.desc { font-size: 12px; color: #9ca3af; margin-bottom: 14px; line-height: 1.5; }\n.code-block { background: #0d1117; border-radius: 6px; padding: 10px 14px; font-family: monospace; font-size: 11px; color: #7ee787; margin-top: 8px; line-height: 1.6; }\n.keyword { color: #ff7b72; }\n.value { color: #79c0ff; }\n.demo-area div.active .normal-before { opacity: 0.15; }\n.demo-area div.active .normal-gone { border-color: #e94560; color: #e94560; background: rgba(233,69,96,0.1); }"
screenshot_textproto: "temporal"
