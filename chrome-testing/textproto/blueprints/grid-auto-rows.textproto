demo_type: GRID
title: "Grid Auto Rows"
target_base_style: "display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 40px; gap: 8px; min-width: 300px;"
child_elements: "<div class=\"cell\">Defined</div>"
child_elements: "<div class=\"cell\">40px</div>"
child_elements: "<div class=\"cell\">40px</div>"
child_elements: "<div class=\"cell\">Auto 1</div>"
child_elements: "<div class=\"cell\">Auto 2</div>"
child_elements: "<div class=\"cell\">Auto 3</div>"
child_elements: "<div class=\"cell\">Auto 4</div>"
child_elements: "<div class=\"cell\">Auto 5</div>"
child_elements: "<div class=\"cell\">Auto 6</div>"
extra_css: ".cell { background: #0f3460; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #e94560; font-weight: 600; padding: 6px; }\n.cell:nth-child(n+4) { background: #1a4a7a; }"
