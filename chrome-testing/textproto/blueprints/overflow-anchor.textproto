demo_type: SCROLL
title: "Overflow Anchor"
target_base_style: "width: 100%; height: 400px; overflow-y: scroll; background: #0f1629; border-radius: 6px; border: 2px solid #3a3a5c;"
target_inner_html: "<div class=\"scroll-item\">Item 1 - Scroll anchoring behavior</div><div class=\"scroll-item\">Item 2 - Browser adjusts scroll offset</div><div class=\"scroll-item\">Item 3 - When content is added above</div><div class=\"scroll-item\">Item 4 - Your view stays stable</div><div class=\"scroll-item\">Item 5 - This is the default behavior</div><div class=\"scroll-item\">Item 6 - Content remains in place</div><div class=\"scroll-item\">Item 7 - No unexpected jumps</div><div class=\"scroll-item\">Item 8 - Smooth reading experience</div><div class=\"scroll-item\">Item 9 - Anchored content</div><div class=\"scroll-item\">Item 10 - Still anchored</div><div class=\"scroll-item\">Item 11 - Consistent position</div><div class=\"scroll-item\">Item 12 - Scroll anchoring active</div><div class=\"scroll-item\">Item 13 - More content below</div><div class=\"scroll-item\">Item 14 - Keeps viewport stable</div><div class=\"scroll-item\">Item 15 - End of list</div>"
extra_css: ".scroll-item { padding: 12px 16px; border-bottom: 1px solid #2a2a4a; font-size: 12px; color: #c0c0d0; transition: background 0.3s; }\n.scroll-item:nth-child(odd) { background: rgba(255,255,255,0.02); }"
