demo_type: SCROLL
title: "View Timeline"
target_inner_html: "view()"
target_base_style: "padding: 16px; margin: 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; background: linear-gradient(135deg, #7b2ff7, #c471f5); animation: fadeScale 1s linear both; animation-timeline: view(); animation-range: entry 0% entry 100%;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; border: 1px solid #2a2a4a;"
siblings_before: "<div class=\"scroll-spacer\"></div><div class=\"static-item\">Spacer</div>"
siblings_after: "<div class=\"static-item\">Spacer</div><div class=\"scroll-item item-default\">view()</div><div class=\"scroll-spacer\"></div>"
extra_css: ".demos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n.demo-label { font-size: 13px; font-weight: 600; color: #64ffda; font-family: 'SF Mono', 'Fira Code', monospace; margin-bottom: 12px; background: #0d1117; padding: 6px 10px; border-radius: 6px; display: inline-block; }\n.demo-desc { font-size: 12px; color: #8888aa; margin-bottom: 12px; line-height: 1.5; }\n.scroll-container { height: 160px; overflow-y: auto; border-radius: 8px; background: #0d1117; position: relative; scroll-behavior: smooth; }\n.scroll-container::-webkit-scrollbar { width: 4px; }\n.scroll-container::-webkit-scrollbar-track { background: #0d1117; }\n.scroll-container::-webkit-scrollbar-thumb { background: #444; border-radius: 2px; }\n.scroll-spacer { height: 60px; }\n.scroll-item { padding: 16px; margin: 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; }\n.item-default { background: linear-gradient(135deg, #7b2ff7, #c471f5); animation: fadeScale 1s linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }\n.static-item { padding: 12px; margin: 8px; border-radius: 6px; background: #2a2a4a; text-align: center; font-size: 12px; color: #aaa; }\n@keyframes fadeScale { from { opacity: 0.2; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }"
screenshot_textproto: "static"
