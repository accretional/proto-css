demo_type: BOX
title: "Contain"
target_base_style: "width: 100%; min-height: 100px; background: #0f1a30; border-radius: 6px; padding: 12px; border: 2px solid #2a2a4a; position: relative;"
child_elements: "<div class=\"inner-content\">Content inside a contained element. Overflow child below tests containment behavior.</div>"
child_elements: "<div class=\"overflow-child\">overflows parent</div>"
extra_css: ".inner-content { font-size: 11px; line-height: 1.5; color: #c0c8d4; }\n.overflow-child { width: 120%; height: 30px; background: linear-gradient(90deg, rgba(233, 69, 96, 0.4), rgba(233, 69, 96, 0.1)); border: 1px dashed #e94560; border-radius: 4px; margin-top: 8px; display: flex; align-items: center; padding-left: 8px; font-size: 10px; color: #e94560; font-family: monospace; }"
screenshot_textproto: "static"
