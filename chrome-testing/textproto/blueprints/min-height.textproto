demo_type: BOX
title: "Min Height"
target_base_style: "width: 100%; background: linear-gradient(180deg, #0f3460, #533483); border: 2px solid #4fc3f7; border-radius: 8px; padding: 10px; font-size: 11px; color: #c8d6e5; display: flex; align-items: flex-start; justify-content: center;"
target_inner_html: "<div class=\"box-inner\"><span class=\"box-text\">tiny</span><div class=\"ruler\"></div></div>"
wrapper_style: "width: 100%; display: flex; flex-direction: column; align-items: center;"
extra_css: ".ruler { width: 4px; background: #ff6b6b; border-radius: 2px; margin-left: 8px; align-self: stretch; flex-shrink: 0; }\n.box-inner { display: flex; width: 100%; }\n.box-text { flex: 1; }"
