extra_css: ".float-left { float: left; width: 60px; height: 50px; background: #e94560; border-radius: 6px; margin: 0 8px 6px 0; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 600; color: #fff; }\n.float-right { float: right; width: 60px; height: 50px; background: #0f3460; border: 2px solid #3b82f6; border-radius: 6px; margin: 0 0 6px 8px; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 600; color: #7ec8e3; }"
