demo_type: BOX
title: "Animation Composition"
target_base_style: "width: 60px; height: 60px; border-radius: 8px; position: absolute; left: 10px; top: 50%; margin-top: -30px; transform: rotate(45deg) scale(1.5); background: #e94560; animation: composeDemo 3s linear infinite; animation-delay: -1.5s;"
wrapper_style: "position: relative; height: 80px; background: #0f3460; border-radius: 8px; overflow: hidden;"
max_values: 3
target_inner_html: ""
extra_css: "@keyframes composeDemo {\n  from { transform: rotate(0deg) scale(1); }\n  to { transform: rotate(180deg) scale(2); }\n}"
screenshot_textproto: "temporal"
