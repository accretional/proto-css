demo_type: BOX
title: "Animation Composition"
target_base_style: "width: 60px; height: 60px; border-radius: 8px; position: absolute; transform: translateX(30px) rotate(20deg); background: #e94560; animation: moveRight 2s ease-in-out; animation-delay: -1s;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 360px; height: 260px; position: relative;"
target_inner_html: ""
extra_css: ".demo-title { font-size: 13px; color: #ccc; margin-bottom: 16px; }\n.track { width: 100%; height: 80px; background: #0f3460; border-radius: 8px; position: relative; display: flex; align-items: center; justify-content: center; }\n.guide { position: absolute; left: 30px; top: 50%; transform: translateY(-50%); width: 60px; height: 60px; border: 2px dashed #4a5568; border-radius: 8px; }\n@keyframes moveRight {\n  from { transform: translateX(0px) rotate(0deg); }\n  to { transform: translateX(100px) rotate(45deg); }\n}\n.note { font-size: 11px; color: #6b7280; margin-top: 4px; font-style: italic; }\n.legend { display: flex; align-items: center; gap: 6px; margin-top: 8px; }\n.legend-dot { width: 8px; height: 8px; border-radius: 2px; }\n.legend-text { font-size: 10px; color: #9ca3af; }"
