demo_type: BOX
title: "Break Inside"
target_base_style: "background: #16213e; border-radius: 10px; padding: 20px;"
target_inner_html: "<div class=\"multicol\"><div class=\"card\">Card A: This card has enough content that it may be split across columns when break-inside allows it.</div><div class=\"card\">Card B: Another card with content that could break across column boundaries.</div><div class=\"card\">Card C: More content here to fill the multi-column layout nicely.</div><div class=\"card\">Card D: Additional text to demonstrate break behavior inside columns clearly.</div><div class=\"card\">Card E: This card also has content that may split across column boundaries.</div><div class=\"card\">Card F: Final card with additional filler text for the layout.</div></div>"
property_target_selector: " .card"
max_values: 4
extra_css: ".multicol { column-count: 3; column-gap: 14px; column-rule: 1px solid #2a2a4a; }\n.card { background: #0f3460; border-radius: 8px; padding: 12px; margin-bottom: 10px; border: 1px solid #1a4a8a; font-size: 11px; line-height: 1.5; color: #b0b0c0; }"
screenshot_textproto: "static"
