demo_type: MULTICOL
title: "Break Inside"
target_base_style: "background: #16213e; border-radius: 10px; padding: 20px; flex: 1;"
wrapper_style: "display: flex; gap: 32px;"
target_inner_html: "<div class=\"multicol\"><div class=\"card\"><h3>Card A</h3><p>This card has enough content that it may be split across columns.</p></div><div class=\"card\"><h3>Card B</h3><p>Another card with some content that could break.</p></div><div class=\"card\"><h3>Card C</h3><p>More content here to demonstrate break behavior inside columns.</p></div><div class=\"card\"><h3>Card D</h3><p>Additional card with text that fills space in the column layout.</p></div><div class=\"card\"><h3>Card E</h3><p>This card also has content that may split across column boundaries.</p></div></div>"
extra_css: ".multicol { column-count: 3; column-gap: 14px; column-rule: 1px solid #2a2a4a; }\n.card { background: #0f3460; border-radius: 8px; padding: 12px; margin-bottom: 10px; border: 1px solid #1a4a8a; }\n.card h3 { font-size: 13px; color: #e94560; margin-bottom: 6px; }\n.card p { font-size: 11px; line-height: 1.5; color: #b0b0c0; }"
screenshot_textproto: "static"
