demo_type: BOX
title: "Animation (Shorthand)"
target_base_style: "width: 60px; height: 60px; border-radius: 8px; animation-play-state: paused; animation-delay: -1s;"
extra_css: "@keyframes slideRotate {\n  0% { transform: translateX(-60px) rotate(0deg); background: #e94560; }\n  50% { transform: translateX(60px) rotate(180deg); background: #3498db; }\n  100% { transform: translateX(-60px) rotate(360deg); background: #e94560; }\n}\n@keyframes pulse {\n  0% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.5); opacity: 0.5; }\n  100% { transform: scale(1); opacity: 1; }\n}\n@keyframes bounce {\n  0%, 100% { transform: translateY(0); border-radius: 8px; }\n  50% { transform: translateY(-40px); border-radius: 50%; }\n}\n@keyframes colorShift {\n  0% { background: #e94560; transform: rotate(0deg); }\n  33% { background: #f39c12; transform: rotate(120deg); }\n  66% { background: #2ecc71; transform: rotate(240deg); }\n  100% { background: #e94560; transform: rotate(360deg); }\n}"
