demo_type: BOX
title: "Animation (Shorthand)"
target_base_style: "width: 60px; height: 60px; border-radius: 8px; background: #e94560;"
wrapper_style: "display: flex; align-items: center; justify-content: center; min-height: 100px;"
extra_css: "@keyframes slideRotate {\n  0% { transform: translateX(-200px) rotate(0deg) scale(0.5); background: #e94560; border-radius: 8px; }\n  25% { transform: translateX(0px) rotate(90deg) scale(2); background: #f39c12; border-radius: 50%; }\n  50% { transform: translateX(200px) rotate(180deg) scale(0.5); background: #3498db; border-radius: 8px; }\n  75% { transform: translateX(0px) rotate(270deg) scale(1.5); background: #2ecc71; border-radius: 50%; }\n  100% { transform: translateX(-200px) rotate(360deg) scale(0.5); background: #e94560; border-radius: 8px; }\n}\n@keyframes pulse {\n  0% { transform: scale(0.3); opacity: 1; background: #e94560; }\n  50% { transform: scale(2.5); opacity: 0.3; background: #00d2ff; }\n  100% { transform: scale(0.3); opacity: 1; background: #e94560; }\n}\n@keyframes bounce {\n  0%, 100% { transform: translateY(0) scale(1); border-radius: 8px; background: #e94560; }\n  25% { transform: translateY(-80px) scale(1.5); border-radius: 50%; background: #f39c12; }\n  50% { transform: translateY(0) scale(0.5); border-radius: 0; background: #2ecc71; }\n  75% { transform: translateY(-40px) scale(1.2); border-radius: 50%; background: #a855f7; }\n}\n@keyframes colorShift {\n  0% { background: #e94560; transform: rotate(0deg) translateX(-100px); }\n  33% { background: #f39c12; transform: rotate(120deg) translateX(100px); }\n  66% { background: #2ecc71; transform: rotate(240deg) translateX(-100px); }\n  100% { background: #e94560; transform: rotate(360deg) translateX(100px); }\n}\n.demo-area > div { animation-delay: -1s !important; animation-iteration-count: infinite !important; }"
screenshot_textproto: "temporal"
