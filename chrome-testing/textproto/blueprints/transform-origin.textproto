demo_type: BOX
title: "Transform Origin"
target_base_style: "width: 80px; height: 80px; background: linear-gradient(135deg, #e94560, #0f3460); border-radius: 6px; position: relative; transform: rotate(45deg);"
target_inner_html: "<div class=\"origin-dot\"></div>"
wrapper_style: "width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; position: relative;"
siblings_before: "<div class=\"ghost\"></div>"
extra_css: ".ghost { position: absolute; width: 80px; height: 80px; border: 2px dashed #394867; border-radius: 6px; }\n.origin-dot { width: 10px; height: 10px; background: #34d399; border-radius: 50%; position: absolute; z-index: 2; box-shadow: 0 0 6px #34d399; top: 50%; left: 50%; margin-top: -5px; margin-left: -5px; transform: rotate(-45deg); }"
