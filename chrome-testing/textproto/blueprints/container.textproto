demo_type: BOX
title: "Container (Shorthand)"
target_base_style: "background: #0f1a30; border: 2px solid #2a2a4a; border-radius: 8px; padding: 16px; position: relative;"
child_elements: "<div class=\"container-badge\">name</div>"
child_elements: "<div class=\"card-inside\"><div class=\"card-title\">Container Title</div><div class=\"card-text\">This container is established with a name and type via the container shorthand. Child elements can target it with @container queries.</div></div>"
extra_css: ".container-badge { position: absolute; top: -8px; right: 12px; background: #16213e; border: 1px solid #4fc3f7; color: #4fc3f7; font-size: 9px; font-family: monospace; padding: 2px 8px; border-radius: 3px; }\n.card-inside { background: linear-gradient(135deg, #1e2a4a, #16213e); border: 1px solid #3a3a5a; border-radius: 6px; padding: 12px; }\n.card-title { font-size: 14px; font-weight: 600; color: #fff; margin-bottom: 4px; }\n.card-text { font-size: 11px; color: #9ca3af; line-height: 1.5; }"
max_values: 6
screenshot_textproto: "static"
