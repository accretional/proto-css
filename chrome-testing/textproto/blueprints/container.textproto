demo_type: BOX
title: "Container (Shorthand)"
target_base_style: "background: #0f1a30; border: 2px solid #2a2a4a; border-radius: 8px; padding: 16px; position: relative; min-height: 100px;"
child_elements: "<div class=\"cq-child\"><div class=\"cq-status\">No container context</div><div class=\"cq-content\">Content responds to container queries when a containment context is established.</div></div>"
extra_css: ".cq-child { padding: 12px; border-radius: 6px; background: #1a2440; border: 1px solid #3a3a5a; }\n.cq-status { font-size: 11px; font-family: monospace; color: #ef4444; margin-bottom: 8px; padding: 4px 8px; background: rgba(239,68,68,0.1); border-radius: 4px; display: inline-block; }\n.cq-content { font-size: 11px; color: #9ca3af; line-height: 1.5; }\n@container (min-width: 50px) { .cq-status { color: #22c55e; background: rgba(34,197,94,0.1); } .cq-status::after { content: ' — active!'; } .cq-content { color: #4fc3f7; } }"
max_values: 6
screenshot_textproto: "static"
