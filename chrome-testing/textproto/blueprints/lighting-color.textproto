demo_type: SVG
title: "Lighting Color"
target_tag: "svg"
property_target_selector: " feDiffuseLighting"
max_values: 6
target_base_style: "width: 200px; height: 140px;"
target_inner_html: "<defs><filter id=\"lightF-{{INDEX}}\" x=\"0\" y=\"0\" width=\"100%\" height=\"100%\"><feDiffuseLighting in=\"SourceGraphic\" result=\"light\" surfaceScale=\"8\" diffuseConstant=\"1.2\"><fePointLight x=\"100\" y=\"70\" z=\"150\"/></feDiffuseLighting><feComposite in=\"SourceGraphic\" in2=\"light\" operator=\"arithmetic\" k1=\"1\" k2=\"0.2\" k3=\"0\" k4=\"0\"/></filter></defs><rect x=\"10\" y=\"10\" width=\"180\" height=\"120\" rx=\"12\" fill=\"#e0e0e0\" filter=\"url(#lightF-{{INDEX}})\"/>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 16px; display: flex; flex-direction: column; align-items: center;"
