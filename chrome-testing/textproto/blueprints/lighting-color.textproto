target_inner_html: "<defs><filter id=\"lightF\" x=\"0\" y=\"0\" width=\"100%\" height=\"100%\"><feDiffuseLighting in=\"SourceGraphic\" result=\"light\" surfaceScale=\"5\" diffuseConstant=\"0.8\"><fePointLight x=\"100\" y=\"70\" z=\"120\"/></feDiffuseLighting><feComposite in=\"SourceGraphic\" in2=\"light\" operator=\"arithmetic\" k1=\"0.8\" k2=\"0.3\" k3=\"0\" k4=\"0\"/></filter></defs><rect x=\"10\" y=\"10\" width=\"180\" height=\"120\" rx=\"12\" fill=\"#4a5568\" filter=\"url(#lightF)\"/>"
