demo_type: SCROLL
title: "Overflow"
target_base_style: "width: 100%; height: 150px; background: #0f3460; border-radius: 6px; border: 2px solid #3a3a5c; position: relative;"
target_inner_html: "<div class=\"content\"><p>This content overflows the container boundaries and remains visible outside the box.</p><p>More text that continues to overflow past the edges of this element.</p><p>Even more content here to make it really obvious.</p><p>And yet another line of text.</p></div>"
extra_css: ".content { font-size: 12px; line-height: 1.6; color: #c0c0d0; padding: 10px; }"
screenshot_textproto: "static"
