demo_type: TABLE
title: "Border Collapse"
target_tag: "table"
target_base_style: "border-spacing: 8px;"
target_inner_html: "<tr><th>A</th><th>B</th><th>C</th></tr><tr><td>1</td><td>2</td><td>3</td></tr><tr><td>4</td><td>5</td><td>6</td></tr>"
extra_css: "table { border: 2px solid #e94560; border-spacing: 8px; }\ntd { border: 2px solid #0f3460; padding: 12px 20px; background: #16213e; font-size: 13px; color: #ccc; }\nth { border: 2px solid #0f3460; padding: 10px 20px; background: #0a1628; font-size: 12px; color: #e94560; font-weight: 600; }"
