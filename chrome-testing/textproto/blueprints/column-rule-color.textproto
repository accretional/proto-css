demo_type: MULTICOL
title: "Column Rule Color"
target_base_style: "column-count: 3; column-rule-style: solid; column-rule-width: 3px; font-size: 12px; line-height: 1.6; color: #c0c8d4;"
target_inner_html: "Column rule color controls the color of the rule drawn between columns. The rule color works independently from the text and background colors. Any valid CSS color value can be used including named colors, hex, rgb, and more."
