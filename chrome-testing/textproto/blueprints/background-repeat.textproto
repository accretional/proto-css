demo_type: BOX
title: "Background Repeat"
target_base_style: "width: 180px; height: 140px; border-radius: 8px; border: 2px solid rgba(255,255,255,0.15); background-color: #2d2d4e; background-image: linear-gradient(135deg, #667eea 25%, transparent 25%), linear-gradient(225deg, #667eea 25%, transparent 25%), linear-gradient(315deg, #667eea 25%, transparent 25%), linear-gradient(45deg, #667eea 25%, transparent 25%); background-size: 30px 30px; background-position: 0 0, 0 0, 0 0, 0 0;"
