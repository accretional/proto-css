demo_type: MULTICOL
title: "Page Break Inside"
target_base_style: "columns: 2; column-gap: 16px; column-rule: 2px dashed #f39c12;"
target_inner_html: "<div class=\"card\">Card A: Lorem ipsum dolor sit amet, consectetur adipiscing elit.</div><div class=\"card target\">Card B: This card tests whether it can be split across column boundaries.</div><div class=\"card\">Card C: Short card.</div><div class=\"card\">Card D: Another paragraph of text that fills space in the column layout.</div><div class=\"card\">Card E: Final content block.</div>"
extra_css: ".card { background: #2a2a4a; border-radius: 6px; padding: 12px; margin-bottom: 12px; font-size: 12px; border-left: 3px solid #3498db; }\n.card.target { border-left-color: #e94560; background: #3a1a2a; }"
