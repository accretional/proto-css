demo_type: BOX
title: "Page Break Inside"
target_base_style: "background: #16213e; border-radius: 10px; padding: 20px;"
target_inner_html: "<div class=\"multicol\"><div class=\"card\">Card A: This card has enough content that it may be split across columns.</div><div class=\"card\">Card B: Another card with content that could break across column boundaries.</div><div class=\"card\">Card C: More content here to fill the multi-column layout.</div><div class=\"card\">Card D: Additional text to demonstrate break behavior.</div><div class=\"card\">Card E: This card may split across column boundaries.</div></div>"
property_target_selector: " .card"
max_values: 2
extra_css: ".multicol { column-count: 2; column-gap: 16px; column-rule: 2px dashed #f39c12; }\n.card { background: #2a2a4a; border-radius: 6px; padding: 12px; margin-bottom: 12px; font-size: 12px; line-height: 1.5; color: #b0b0c0; border-left: 3px solid #3498db; }"
screenshot_textproto: "static"
