demo_type: BOX
title: "Cursor"
target_base_style: "background: #16213e; border-radius: 10px; padding: 14px 10px; width: 140px; height: 80px; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2px solid #0f3460;"
target_inner_html: "<span class=\"cursor-name\">default</span><span class=\"cursor-code\">cursor: default</span>"
extra_css: ".cursor-name { font-size: 13px; font-weight: 600; color: #e0e0e0; margin-bottom: 4px; }\n.cursor-code { font-size: 10px; font-family: monospace; color: #7b8794; background: #0f3460; padding: 2px 8px; border-radius: 4px; }"
max_values: 24
