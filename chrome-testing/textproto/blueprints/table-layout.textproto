demo_type: TABLE
title: "Table Layout"
target_tag: "table"
target_base_style: "width: 100%; max-width: 1100px; border-collapse: collapse; background: #16213e; border-radius: 8px; overflow: hidden;"
target_inner_html: "<thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Status</th></tr></thead><tbody><tr><td>1</td><td>A</td><td>This is a much longer description text that demonstrates how the layout algorithm distributes column widths</td><td>Active</td></tr><tr><td>2</td><td>Bob Robertson III</td><td>Short</td><td>Pending Review</td></tr><tr><td>3456</td><td>C</td><td>Medium length content here</td><td>OK</td></tr></tbody>"
extra_css: "th, td { padding: 12px 16px; text-align: left; border: 1px solid #2a2a4e; font-size: 13px; }\nth { background: #0f3460; color: #a5f3fc; font-weight: 600; font-size: 12px; text-transform: uppercase; }\ntd { color: #d1d5db; }"
screenshot_textproto: "static"
