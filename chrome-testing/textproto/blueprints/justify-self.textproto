demo_type: GRID
title: "Justify Self"
target_base_style: "width: 60px; background: #e94560; border-radius: 6px; padding: 12px 20px; font-size: 12px; font-weight: 600; color: #fff; text-align: center;"
target_inner_html: "Target"
wrapper_style: "display: grid; grid-template-columns: 300px; grid-template-rows: repeat(3, 50px); gap: 8px; background: #0f3460; border-radius: 8px; padding: 12px; min-height: 80px;"
siblings_before: "<div class=\"other-item\">default (stretch)</div>"
siblings_after: "<div class=\"other-item\">default (stretch)</div>"
extra_css: ".other-item { background: #374151; border-radius: 6px; padding: 8px 14px; font-size: 11px; color: #9ca3af; text-align: center; justify-self: stretch; }"
screenshot_textproto: "static"
