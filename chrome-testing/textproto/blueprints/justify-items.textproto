demo_type: GRID
title: "Justify Items"
target_base_style: "display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; background: #0f3460; border-radius: 8px; padding: 10px; min-height: 120px;"
child_elements: "<div class=\"grid-item\">A</div>"
child_elements: "<div class=\"grid-item\">B</div>"
child_elements: "<div class=\"grid-item\">C</div>"
child_elements: "<div class=\"grid-item\">D</div>"
child_elements: "<div class=\"grid-item\">E</div>"
child_elements: "<div class=\"grid-item\">F</div>"
extra_css: ".grid-item { background: #e94560; border-radius: 6px; padding: 10px 14px; font-size: 12px; font-weight: 600; color: #fff; text-align: center; }"
