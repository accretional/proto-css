demo_type: SCROLL
title: "View Timeline Axis"
target_inner_html: "block axis"
target_base_style: "padding: 14px; margin: 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; background: linear-gradient(135deg, #7b2ff7, #c471f5); animation: fadeIn 1s linear both; animation-timeline: view(); animation-range: entry 0% entry 100%;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; border: 1px solid #2a2a4a;"
siblings_before: "<div class=\"spacer-v\"></div><div class=\"static-item-v\">...</div>"
siblings_after: "<div class=\"static-item-v\">...</div><div class=\"scroll-item-v color-block\">block axis</div><div class=\"static-item-v\">...</div><div class=\"spacer-v\"></div>"
extra_css: ".demos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }\n.demo-label { font-size: 13px; font-weight: 600; color: #64ffda; font-family: 'SF Mono', 'Fira Code', monospace; margin-bottom: 10px; background: #0d1117; padding: 6px 10px; border-radius: 6px; display: inline-block; }\n.demo-desc { font-size: 12px; color: #8888aa; margin-bottom: 14px; line-height: 1.5; }\n.axis-arrow { display: flex; align-items: center; justify-content: center; width: 100%; height: 40px; border-radius: 8px; background: #0d1117; position: relative; overflow: hidden; }\n.axis-arrow .line { position: absolute; background: #64ffda; border-radius: 2px; }\n.axis-arrow .line.vertical { width: 3px; height: 70%; left: 50%; transform: translateX(-50%); }\n.axis-arrow .line.horizontal { height: 3px; width: 70%; top: 50%; transform: translateY(-50%); }\n.axis-arrow .dot { width: 8px; height: 8px; border-radius: 50%; background: #64ffda; position: absolute; }\n.axis-arrow .dot.top { top: 10%; left: 50%; transform: translateX(-50%); }\n.axis-arrow .dot.bottom { bottom: 10%; left: 50%; transform: translateX(-50%); }\n.scroll-v { height: 140px; overflow-y: auto; border-radius: 8px; background: #0d1117; }\n.scroll-v::-webkit-scrollbar { width: 4px; }\n.scroll-v::-webkit-scrollbar-track { background: #0d1117; }\n.scroll-v::-webkit-scrollbar-thumb { background: #444; border-radius: 2px; }\n.spacer-v { height: 50px; }\n.scroll-item-v { padding: 14px; margin: 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; animation: fadeIn 1s linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }\n.color-block { background: linear-gradient(135deg, #7b2ff7, #c471f5); }\n.static-item-v { padding: 10px; margin: 8px; border-radius: 6px; background: #2a2a4a; text-align: center; font-size: 11px; color: #777; }\n@keyframes fadeIn { from { opacity: 0.15; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }"
screenshot_textproto: "temporal"
