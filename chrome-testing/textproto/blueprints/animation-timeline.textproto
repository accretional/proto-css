demo_type: SCROLL
title: "Animation Timeline"
target_base_style: "width: 100%; height: 100px; background: #0f3460; border-radius: 8px; position: relative; overflow: hidden;"
target_inner_html: "<div class=\"scroll-content-line\" style=\"width: 70%;\"></div><div class=\"scroll-content-line\" style=\"width: 90%;\"></div><div class=\"scroll-content-line\" style=\"width: 60%;\"></div><div class=\"scroll-content-line\" style=\"width: 85%;\"></div><div class=\"scroll-content-line\" style=\"width: 50%;\"></div><div class=\"scroll-content-line\" style=\"width: 75%;\"></div><div class=\"scroll-content-line\" style=\"width: 65%;\"></div><div class=\"scroll-track\"><div class=\"scroll-thumb\"></div></div><div class=\"scroll-progress\"><div class=\"scroll-progress-fill\"></div></div>"
extra_css: ".scroll-content-line { height: 3px; background: #1a1a4e; margin: 6px 16px 6px 10px; border-radius: 2px; }\n.scroll-track { position: absolute; right: 6px; top: 6px; bottom: 6px; width: 5px; background: #1a1a2e; border-radius: 3px; }\n.scroll-thumb { position: absolute; top: 6px; width: 5px; height: 30px; background: #e94560; border-radius: 3px; }\n.scroll-progress { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; }\n.scroll-progress-fill { height: 100%; width: 35%; background: linear-gradient(90deg, #e94560, #533bdb); border-radius: 0 2px 0 0; }"
