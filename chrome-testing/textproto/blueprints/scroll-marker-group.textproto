demo_type: SCROLL
title: "Scroll Marker Group"
target_base_style: "width: 100%; height: 220px; overflow-x: auto; overflow-y: hidden; border: 2px solid #333; border-radius: 10px; background: #16213e; scroll-snap-type: x mandatory; display: flex; position: relative;"
child_elements: "<div class=\"slide\">Slide 1</div>"
child_elements: "<div class=\"slide\">Slide 2</div>"
child_elements: "<div class=\"slide\">Slide 3</div>"
child_elements: "<div class=\"slide\">Slide 4</div>"
extra_css: ".slide { min-width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; scroll-snap-align: start; flex-shrink: 0; }\n.slide:nth-child(1) { background: linear-gradient(135deg, #6366f1, #8b5cf6); }\n.slide:nth-child(2) { background: linear-gradient(135deg, #ec4899, #f43f5e); }\n.slide:nth-child(3) { background: linear-gradient(135deg, #14b8a6, #06b6d4); }\n.slide:nth-child(4) { background: linear-gradient(135deg, #f59e0b, #ef4444); }"
