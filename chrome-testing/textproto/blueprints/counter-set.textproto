demo_type: LIST
title: "Counter Set"
target_tag: "ol"
target_inner_html: "<li>Normal</li><li>Normal</li><li class=\"highlight-row\">Set here!</li><li>Continues</li><li>Continues</li>"
target_base_style: "list-style: none;"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 20px; width: 260px;"
extra_css: ".demo-title { font-size: 12px; color: #a855f7; font-family: monospace; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #0f3460; }\nol li { padding: 4px 0; font-size: 14px; }\nol li::before { font-weight: bold; font-family: monospace; min-width: 30px; display: inline-block; }\n.highlight-row { background: #0f3460; border-radius: 4px; padding: 2px 6px !important; margin: 2px -6px; }"
