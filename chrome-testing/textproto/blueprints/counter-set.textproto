demo_type: LIST
title: "Counter Set"
target_tag: "ol"
target_inner_html: "<li>Normal</li><li>Normal</li><li class=\"highlight-row\">Set here</li><li>Continues</li><li>Continues</li>"
target_base_style: "list-style: none; counter-reset: my-custom 0;"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 20px; width: 260px;"
extra_css: "ol li { padding: 4px 0; font-size: 14px; color: #c0c8d4; counter-increment: my-custom 1; }\nol li::before { content: counter(my-custom) '. '; color: #a855f7; font-weight: bold; font-family: monospace; min-width: 36px; display: inline-block; }\n.highlight-row { background: #0f3460; border-radius: 4px; padding: 2px 6px !important; margin: 2px -6px; }"
screenshot_textproto: "static"
