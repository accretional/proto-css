demo_type: BOX
title: "Overflow Clip Margin"
target_base_style: "position: absolute; top: 30px; left: 30px; width: 100px; height: 100px; overflow: clip; background: #0f3460; border-radius: 6px;"
target_inner_html: "<div class=\"overflow-content\"><div class=\"overflow-block\"></div></div>"
wrapper_style: "width: 160px; height: 160px; position: relative;"
siblings_before: "<div class=\"clip-border\"></div>"
extra_css: ".clip-border { position: absolute; top: 30px; left: 30px; width: 100px; height: 100px; border: 2px dashed #3a3a5c; border-radius: 6px; pointer-events: none; }\n.overflow-content { width: 160px; height: 160px; position: relative; }\n.overflow-block { position: absolute; top: -10px; left: -10px; width: 120px; height: 120px; background: linear-gradient(135deg, #e94560 0%, #0077ff 100%); border-radius: 8px; opacity: 0.8; }"
max_values: 6
screenshot_textproto: "static"
