extra_css: ".row { display: flex; gap: 10px; align-items: center; }\n.box { width: 60px; height: 60px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; }\n.box-a { background: #e94560; }\n.box-c { background: #533483; }\n.ghost-outline { border: 2px dashed #4a4a6a; width: 60px; height: 60px; border-radius: 6px; position: relative; }\n.note { font-size: 10px; color: #6b7280; margin-top: 6px; line-height: 1.4; }"
