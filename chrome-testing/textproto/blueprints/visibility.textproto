demo_type: BOX
title: "Visibility"
target_inner_html: "B"
target_base_style: "width: 60px; height: 60px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; background: #533483;"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 20px; width: 280px;"
