demo_type: BOX
title: "Content Visibility"
target_base_style: "background: #0f3460; border-radius: 8px; padding: 16px;"
target_inner_html: "<h3>Card Title</h3><p>This content may be visible, hidden, or automatically managed based on viewport visibility.</p><div class=\"swatch-row\"><div class=\"swatch\" style=\"background: #e94560;\"></div><div class=\"swatch\" style=\"background: #00d2ff;\"></div><div class=\"swatch\" style=\"background: #00d26a;\"></div></div>"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 20px; min-height: 200px; border: 2px solid #0f3460; position: relative;"
extra_css: "h3 { font-size: 15px; color: #e94560; margin-bottom: 8px; }\np { font-size: 13px; color: #c0c0c0; line-height: 1.5; }\n.swatch-row { display: flex; gap: 8px; margin-top: 10px; }\n.swatch { width: 30px; height: 30px; border-radius: 6px; }"
