demo_type: POSITION
title: "Anchor Name"
target_tag: "button"
target_base_style: "background: #e94560; color: #fff; border: none; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: bold; position: absolute; top: 100px; left: 80px;"
target_inner_html: "Anchor"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 340px; height: 260px; position: relative;"
siblings_after: "<div class=\"tooltip\">Tooltip</div>"
extra_css: ".tooltip { position: absolute; background: #22c55e; color: #000; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; position-anchor: --my-anchor; bottom: anchor(top); left: anchor(center); translate: -50% -8px; }\n.tooltip::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); border: 6px solid transparent; border-top-color: #22c55e; }"
max_values: 4
screenshot_textproto: "static"
