demo_type: POSITION
title: "Anchor Name"
target_tag: "button"
target_base_style: "background: #e94560; color: #fff; border: none; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: bold; cursor: pointer; position: absolute; top: 80px; left: 60px;"
target_inner_html: "Anchor Element"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 360px; height: 280px; position: relative;"
siblings_after: "<div class=\"tooltip-top\">Tooltip above</div>"
extra_css: ".tooltip-top { position: absolute; background: #2ecc71; color: #000; padding: 8px 14px; border-radius: 6px; font-size: 12px; font-weight: bold; position-anchor: --my-button; bottom: anchor(top); left: anchor(center); translate: -50% -8px; }\n.demo-title { font-size: 13px; color: #ccc; margin-bottom: 8px; }"
screenshot_textproto: "static"
