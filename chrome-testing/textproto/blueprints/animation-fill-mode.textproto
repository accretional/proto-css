demo_type: BOX
title: "Animation Fill Mode"
target_base_style: "width: 50px; height: 50px; border-radius: 8px; position: absolute; top: 50%; transform: translateY(-50%); background: #6b7280; animation: slideRight 0.001s ease 0s 1;"
wrapper_style: "position: relative; height: 70px; background: #0f3460; border-radius: 8px; overflow: hidden;"
max_values: 4
extra_css: "@keyframes slideRight {\n  from { left: 20px; background: #06b6d4; }\n  to { left: calc(100% - 60px); background: #e94560; }\n}"
screenshot_textproto: "static"
