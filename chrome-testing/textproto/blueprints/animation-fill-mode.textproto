demo_type: BOX
title: "Animation Fill Mode"
target_base_style: "width: 50px; height: 50px; border-radius: 8px; position: absolute; top: 45px; background: #3498db; animation: slideRight 1s ease;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 280px; height: 300px; display: flex; flex-direction: column; align-items: center;"
extra_css: ".demo-title { font-size: 13px; color: #ccc; margin-bottom: 12px; }\n.track { width: 220px; height: 140px; background: #0f3460; border-radius: 8px; position: relative; overflow: visible; }\n.origin-marker { position: absolute; left: 16px; top: 45px; width: 50px; height: 50px; border: 2px dashed #4a5568; border-radius: 8px; }\n.origin-label { position: absolute; left: 16px; top: 98px; font-size: 9px; color: #4a5568; font-family: monospace; }\n.end-marker { position: absolute; right: 16px; top: 45px; width: 50px; height: 50px; border: 2px dashed #e94560; border-radius: 8px; opacity: 0.4; }\n.end-label { position: absolute; right: 16px; top: 98px; font-size: 9px; color: #e94560; font-family: monospace; opacity: 0.6; }\n@keyframes slideRight {\n  from { left: 16px; background: #3498db; }\n  to { left: 154px; background: #e94560; }\n}\n.note { font-size: 10px; color: #6b7280; margin-top: 4px; text-align: center; font-style: italic; }"
