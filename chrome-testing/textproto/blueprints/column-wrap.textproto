title: "Column Wrap"
target_base_style: "column-count: 3; column-rule: 1px solid #3a3a5a; font-size: 12px; line-height: 1.6; color: #c0c8d4; background: #0f1a30; border-radius: 6px; padding: 14px; height: 160px; overflow: hidden;"
