demo_type: SCROLL
title: "Scroll Padding Bottom"
target_base_style: "width: 100%; height: 250px; overflow-y: auto; border: 2px solid #333; border-radius: 10px; background: #16213e; scroll-snap-type: y mandatory;"
target_inner_html: "<div class=\"snap-item\">1</div><div class=\"snap-item\">2</div><div class=\"snap-item\">3</div><div class=\"snap-item\">4</div><div class=\"snap-item\">5</div>"
wrapper_style: "position: relative; border-radius: 10px; overflow: hidden;"
extra_css: ".demo-card { flex: 1; min-width: 200px; }\n.snap-item { height: 125px; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; scroll-snap-align: end; border-bottom: 1px solid #2a2a4a; }\n.snap-item:nth-child(odd) { background: linear-gradient(135deg, #6366f1, #8b5cf6); }\n.snap-item:nth-child(even) { background: #22224a; }\n.pad-bottom { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(52, 211, 153, 0.15); border-top: 2px dashed #34d399; pointer-events: none; z-index: 2; }\n.note { font-size: 10px; color: #6b7280; margin-top: 4px; }"
