demo_type: BOX
title: "Animation Timing Function"
target_base_style: "flex: 1; height: 32px; background: #0f3460; border-radius: 6px; position: relative; overflow: hidden;"
target_inner_html: "<div class=\"ball\"></div>"
property_target_selector: "> .ball"
wrapper_style: "display: flex; align-items: center; gap: 14px; background: #16213e; border-radius: 10px; padding: 10px 16px; min-width: 400px;"
max_values: 9
extra_css: ".ball { width: 24px; height: 24px; border-radius: 50%; position: absolute; top: 4px; background: #e94560; animation: moveRight 5s infinite alternate; animation-delay: -1.5s; }\n@keyframes moveRight { 0% { left: 0; background: #e94560; } 100% { left: calc(100% - 24px); background: #3498db; } }"
screenshot_textproto: "temporal"
