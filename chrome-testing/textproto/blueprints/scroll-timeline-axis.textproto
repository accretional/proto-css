demo_type: SCROLL
title: "Scroll Timeline Axis"
target_base_style: "width: 100%; height: 180px; background: #0a0a1a; border-radius: 8px; position: relative; display: flex; align-items: center; justify-content: center;"
target_inner_html: "<div class=\"axis-box\"><div class=\"arrow-v\"></div><div class=\"box-label\">scroll<br>container</div></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px;"
extra_css: ".experimental { display: inline-block; background: #e9456033; color: #e94560; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px; margin-left: 8px; vertical-align: middle; }\n.demos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }\n.axis-box { width: 120px; height: 100px; border: 2px solid #333; border-radius: 8px; position: relative; background: #16213e; }\n.arrow-h { position: absolute; top: 50%; left: -40px; right: -40px; height: 2px; background: #e94560; transform: translateY(-50%); }\n.arrow-h::before, .arrow-h::after { content: ''; position: absolute; top: -4px; width: 0; height: 0; border-style: solid; }\n.arrow-h::before { left: 0; border-width: 5px 8px 5px 0; border-color: transparent #e94560 transparent transparent; }\n.arrow-h::after { right: 0; border-width: 5px 0 5px 8px; border-color: transparent transparent transparent #e94560; }\n.arrow-v { position: absolute; left: 50%; top: -30px; bottom: -30px; width: 2px; background: #2ecc71; transform: translateX(-50%); }\n.arrow-v::before, .arrow-v::after { content: ''; position: absolute; left: -4px; width: 0; height: 0; border-style: solid; }\n.arrow-v::before { top: 0; border-width: 0 5px 8px 5px; border-color: transparent transparent #2ecc71 transparent; }\n.arrow-v::after { bottom: 0; border-width: 8px 5px 0 5px; border-color: #2ecc71 transparent transparent transparent; }\n.box-label { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 10px; color: #7b8794; font-family: monospace; text-align: center; }\n.axis-label-v { position: absolute; top: 12px; left: 12px; font-size: 11px; font-family: monospace; color: #2ecc71; background: #2ecc7122; padding: 2px 8px; border-radius: 4px; }\n.axis-label-h { position: absolute; bottom: 12px; right: 12px; font-size: 11px; font-family: monospace; color: #e94560; background: #e9456022; padding: 2px 8px; border-radius: 4px; }"
max_values: 4
screenshot_textproto: "temporal"
