demo_type: BOX
title: "Border Image Repeat"
target_base_style: "width: 200px; height: 150px; background: #16213e; border: 20px solid transparent; border-image-source: repeating-linear-gradient(45deg, #e94560 0px, #e94560 6px, #53d8fb 6px, #53d8fb 12px, #4ade80 12px, #4ade80 18px); border-image-slice: 20; border-image-width: 20px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #ccc; font-family: monospace;"
