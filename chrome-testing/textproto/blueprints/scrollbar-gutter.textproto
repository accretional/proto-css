demo_type: SCROLL
title: "Scrollbar Gutter"
target_base_style: "width: 100%; height: 140px; overflow: auto; border: 1px solid #333; border-radius: 6px; padding: 12px; font-size: 12px; color: #9ca3af; line-height: 1.6; background: #16213e;"
target_inner_html: "Short content. No scrollbar needed, so no gutter space is reserved."
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 370px;"
extra_css: ".box-wrapper { background: #0a0a1a; border-radius: 8px; padding: 12px; }\n.gutter-visual { display: flex; align-items: stretch; height: 40px; border-radius: 4px; overflow: hidden; margin-top: 10px; }\n.gv-content { flex: 1; background: #0f3460; display: flex; align-items: center; justify-content: center; font-size: 10px; font-family: monospace; color: #7b8794; }\n.gv-gutter { width: 16px; display: flex; align-items: center; justify-content: center; font-size: 8px; color: #fff; }\n.gv-gutter-reserved { background: #e9456044; border: 1px dashed #e94560; }\n.note { font-size: 10px; color: #7b8794; margin-top: 8px; font-style: italic; }"
