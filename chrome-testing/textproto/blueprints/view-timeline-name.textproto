demo_type: SCROLL
title: "View Timeline Name"
target_inner_html: "No timeline<br><span class=\"name-tag tag-none\">none</span>"
target_base_style: "padding: 14px; margin: 6px 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; background: linear-gradient(135deg, #555, #777); view-timeline-name: none;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; border: 1px solid #2a2a4a;"
siblings_before: "<div class=\"spacer\"></div><div class=\"filler\">...</div>"
siblings_after: "<div class=\"filler\">...</div><div class=\"target name-none\">No timeline<br><span class=\"name-tag tag-none\">none</span></div><div class=\"filler\">...</div><div class=\"spacer\"></div>"
extra_css: ".demos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }\n.demo-label { font-size: 13px; font-weight: 600; color: #64ffda; font-family: 'SF Mono', 'Fira Code', monospace; margin-bottom: 10px; background: #0d1117; padding: 6px 10px; border-radius: 6px; display: inline-block; }\n.demo-desc { font-size: 12px; color: #8888aa; margin-bottom: 14px; line-height: 1.5; }\n.scroll-box { height: 160px; overflow-y: auto; border-radius: 8px; background: #0d1117; }\n.scroll-box::-webkit-scrollbar { width: 4px; }\n.scroll-box::-webkit-scrollbar-track { background: #0d1117; }\n.scroll-box::-webkit-scrollbar-thumb { background: #444; border-radius: 2px; }\n.spacer { height: 50px; }\n.filler { padding: 10px; margin: 6px 8px; border-radius: 6px; background: #2a2a4a; text-align: center; font-size: 11px; color: #666; }\n.target { padding: 14px; margin: 6px 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; }\n.name-none { background: linear-gradient(135deg, #555, #777); view-timeline-name: none; }\n.name-tag { display: inline-block; font-size: 10px; padding: 2px 8px; border-radius: 4px; margin-top: 6px; font-family: 'SF Mono', 'Fira Code', monospace; }\n.tag-none { background: #444; color: #aaa; }\n@keyframes pop { from { opacity: 0.15; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }"
screenshot_textproto: "static"
