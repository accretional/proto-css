demo_type: BOX
title: "Animation Play State"
target_base_style: "width: 50px; height: 50px; background: #e94560; border-radius: 50%; position: absolute; top: 5px; left: 0; animation: moveAcross 2s ease-in-out infinite alternate;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 32px 40px; display: flex; flex-direction: column; align-items: center; flex: 1;"
extra_css: ".status { font-size: 13px; font-weight: 600; margin-bottom: 20px; padding: 4px 12px; border-radius: 20px; }\n.status-running { background: #064e3b; color: #6ee7b7; }\n.status-paused { background: #78350f; color: #fcd34d; }\n.track { width: 100%; height: 60px; background: #0f3460; border-radius: 8px; position: relative; overflow: hidden; }\n@keyframes moveAcross {\n  0% { left: 0; }\n  100% { left: calc(100% - 50px); }\n}"
