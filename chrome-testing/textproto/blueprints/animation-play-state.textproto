demo_type: BOX
title: "Animation Play State"
target_base_style: "width: 50px; height: 50px; background: #e94560; border-radius: 50%; position: absolute; top: 50%; left: 0; transform: translateY(-50%); animation: moveAcross 2s ease-in-out infinite alternate; animation-delay: -0.3s;"
wrapper_style: "position: relative; height: 64px; background: #0f3460; border-radius: 8px; overflow: hidden;"
max_values: 4
extra_css: "@keyframes moveAcross {\n  0% { left: 0; }\n  100% { left: calc(100% - 50px); }\n}"
screenshot_textproto: "temporal"
