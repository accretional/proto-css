demo_type: FLEX
title: "Box Flex (deprecated)"
property_name_override: "-webkit-box-flex"
property_target_selector: "> *:first-child"
max_values: 6
target_base_style: "display: -webkit-box; -webkit-box-orient: horizontal; width: 100%; max-width: 900px; height: 80px; background: #16213e; border: 2px solid #333;"
child_elements: "<div class=\"child c1\">flex: 1</div>"
child_elements: "<div class=\"child c2\">flex: 2</div>"
child_elements: "<div class=\"child c3\">flex: 1</div>"
extra_css: ".child { height: 100%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold; color: #fff; border-right: 2px solid #1a1a2e; }\n.c1 { background: #e94560; }\n.c2 { background: #0f3460; }\n.c3 { background: #53d769; color: #1a1a2e; }"
screenshot_textproto: "static"
