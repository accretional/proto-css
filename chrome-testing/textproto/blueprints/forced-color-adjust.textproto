demo_type: BOX
title: "Forced Color Adjust"
target_base_style: "background: #0f172a; padding: 14px; border-radius: 8px;"
target_inner_html: "<div class=\"status-bar\"><div class=\"status-dot dot-red\"></div><div class=\"status-dot dot-yellow\"></div><div class=\"status-dot dot-green\"></div></div><div class=\"gradient-box\"></div><div><span class=\"btn btn-primary\">Primary</span><span class=\"btn btn-success\">Success</span><span class=\"btn btn-danger\">Danger</span></div><p class=\"text-styled\" style=\"margin-top: 10px; color: #e0e0e0;\">Text with <span class=\"highlight\">highlighted</span> content</p>"
extra_css: ".btn { display: inline-block; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; margin-right: 6px; margin-bottom: 6px; }\n.btn-primary { background: #7c3aed; color: #fff; }\n.btn-success { background: #10b981; color: #fff; }\n.btn-danger { background: #ef4444; color: #fff; }\n.status-bar { display: flex; gap: 8px; margin-bottom: 12px; }\n.status-dot { width: 12px; height: 12px; border-radius: 50%; }\n.dot-red { background: #ef4444; }\n.dot-yellow { background: #f59e0b; }\n.dot-green { background: #10b981; }\n.gradient-box { height: 32px; border-radius: 6px; margin-bottom: 12px; background: linear-gradient(90deg, #7c3aed, #ec4899, #f59e0b); }\n.text-styled { font-size: 14px; line-height: 1.5; }\n.highlight { background: #f59e0b33; color: #f59e0b; padding: 1px 4px; border-radius: 3px; }"
