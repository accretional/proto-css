demo_type: SCROLL
title: "Overscroll Behavior"
target_base_style: "width: 260px; height: 120px; border-radius: 6px; overflow: auto; margin: 8px auto; padding: 10px; font-size: 12px; line-height: 1.6; color: #c0c0c0; background: #2a1a3e; border: 2px solid #e94560;"
target_inner_html: "<p>Inner scrollable content. Scroll down past this content...</p><p>When you reach the end of this inner scroll area, the scroll will chain to the outer container.</p><p>This is the default browser behavior.</p><p>Line 4 of inner content.</p><p>Line 5 of inner content.</p><p>Line 6 - end of inner.</p>"
wrapper_style: "width: 320px; height: 200px; background: #0f3460; border-radius: 8px; overflow: auto; position: relative;"
siblings_before: "<p class=\"outer-label\">Outer scrollable container</p>"
siblings_after: "<p class=\"outer-label\">More outer content below...</p><p class=\"outer-label\">Outer content continues...</p><p class=\"outer-label\">Even more outer content...</p><p class=\"outer-label\">End of outer content.</p>"
extra_css: ".outer-label { font-size: 11px; color: #5a7aa0; margin-bottom: 6px; padding: 0 12px; }\np { margin-bottom: 6px; }"
