demo_type: POSITION
title: "Anchor Scope"
target_base_style: "border: 2px dashed #4a5568; border-radius: 8px; padding: 16px; margin-bottom: 12px; position: relative;"
target_inner_html: "<div class=\"scope-label\">Container</div><div class=\"anchor-el\">Anchor</div><div class=\"positioned-el\">Positioned element</div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 380px; min-height: 300px; position: relative;"
extra_css: ".scope-label { font-size: 10px; font-family: monospace; color: #f39c12; position: absolute; top: -8px; left: 12px; background: #16213e; padding: 0 4px; }\n.anchor-el { anchor-name: --scoped-anchor; background: #e94560; color: #fff; padding: 8px 16px; border-radius: 6px; font-size: 12px; display: inline-block; font-weight: bold; }\n.positioned-el { background: #3498db; color: #fff; padding: 6px 12px; border-radius: 6px; font-size: 11px; display: inline-block; margin-top: 8px; }\n.visual-indicator { display: flex; align-items: center; gap: 6px; margin-top: 10px; }\n.indicator-dot { width: 10px; height: 10px; border-radius: 50%; }\n.indicator-dot.visible { background: #2ecc71; }\n.indicator-dot.hidden { background: #e74c3c; }\n.indicator-text { font-size: 11px; color: #aaa; }\n.note { font-size: 11px; color: #6b7280; margin-top: 8px; font-style: italic; }\n.demo-title { font-size: 13px; color: #ccc; margin-bottom: 16px; }"
screenshot_textproto: "static"
