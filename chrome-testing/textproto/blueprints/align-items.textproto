demo_type: FLEX
title: "Align Items"
target_base_style: "display: flex; width: 180px; height: 160px; background: #0f3460; border-radius: 8px; gap: 8px; padding: 8px;"
child_elements: "<div class=\"item\">1</div>"
child_elements: "<div class=\"item\">2</div>"
child_elements: "<div class=\"item\">3</div>"
child_elements: "<div class=\"item\">4</div>"
extra_css: ".item { width: 36px; background: #e94560; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; color: #fff; }\n.item:nth-child(1) { height: 40px; }\n.item:nth-child(2) { height: 70px; }\n.item:nth-child(3) { height: 55px; }\n.item:nth-child(4) { height: 90px; }"
