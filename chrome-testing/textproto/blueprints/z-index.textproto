demo_type: POSITION
title: "Z-Index"
target_base_style: "position: absolute; width: 140px; height: 100px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: monospace; font-weight: 700; font-size: 16px; color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.4); border: 2px solid rgba(255,255,255,0.2); background: #e94560; top: 70px; left: 80px;"
target_inner_html: "<span>target</span><span class=\"z-label\">z-index: ?</span>"
wrapper_style: "position: relative; height: 280px; background: #0f1a30; border-radius: 8px; border: 1px solid #2a2a4a; overflow: hidden; width: 360px;"
siblings_before: "<div class=\"stack-box\" style=\"z-index: -5; background: #374151; top: 20px; left: 20px;\">A<span class=\"z-label\">z: -5</span></div>"
siblings_before: "<div class=\"stack-box\" style=\"z-index: 0; background: #6b7280; top: 45px; left: 50px;\">B<span class=\"z-label\">z: 0</span></div>"
siblings_after: "<div class=\"stack-box\" style=\"z-index: 10; background: #533483; top: 120px; left: 160px;\">C<span class=\"z-label\">z: 10</span></div>"
siblings_after: "<div class=\"stack-box\" style=\"z-index: 50; background: #0ea5e9; top: 150px; left: 190px;\">D<span class=\"z-label\">z: 50</span></div>"
extra_css: ".stack-box { position: absolute; width: 120px; height: 80px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: monospace; font-weight: 700; font-size: 16px; color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.4); border: 2px solid rgba(255,255,255,0.15); }\n.z-label { font-size: 10px; font-weight: 400; opacity: 0.8; margin-top: 4px; }"
screenshot_textproto: "static"
