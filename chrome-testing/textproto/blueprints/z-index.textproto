demo_type: POSITION
title: "Z-Index"
target_base_style: "position: absolute; width: 180px; height: 140px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: monospace; font-weight: 700; font-size: 18px; color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.4); border: 2px solid rgba(255,255,255,0.15); background: #e94560; top: 80px; left: 100px;"
target_inner_html: "z"
wrapper_style: "position: relative; height: 340px; background: #0f1a30; border-radius: 8px; border: 1px solid #2a2a4a; overflow: hidden; width: 560px;"
siblings_before: "<div class=\"stack-box\" style=\"z-index: -1; background: #374151; width: 180px; height: 140px; top: 20px; left: 20px;\">-1<span class=\"z-label\">z-index: -1</span></div>"
siblings_before: "<div class=\"stack-box\" style=\"z-index: auto; background: #6b7280; width: 180px; height: 140px; top: 50px; left: 60px;\">auto<span class=\"z-label\">z-index: auto</span></div>"
siblings_after: "<div class=\"stack-box\" style=\"z-index: 100; background: #533483; width: 180px; height: 140px; top: 170px; left: 220px;\">100<span class=\"z-label\">z-index: 100</span></div>"
extra_css: ".stack-box { position: absolute; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: monospace; font-weight: 700; font-size: 18px; color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.4); border: 2px solid rgba(255,255,255,0.15); }\n.z-label { font-size: 11px; font-weight: 400; opacity: 0.8; margin-top: 4px; }"
