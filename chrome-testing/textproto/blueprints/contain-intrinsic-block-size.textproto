demo_type: BOX
title: "Contain Intrinsic Block Size"
target_base_style: "contain: size layout; background: #0f1a30; border: 2px solid #2a2a4a; border-radius: 6px; padding: 12px; position: relative; overflow: hidden;"
child_elements: "<div class=\"inner\">This element has an intrinsic block size hint. The browser uses this as the height when size containment is active.</div>"
extra_css: ".inner { font-size: 11px; color: #c0c8d4; line-height: 1.5; }"
