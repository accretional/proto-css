demo_type: GRID
title: "Grid Auto Flow"
target_base_style: "display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 50px); gap: 5px;"
child_elements: "<div class=\"cell\">1</div>"
child_elements: "<div class=\"cell wide\">2 (span 2)</div>"
child_elements: "<div class=\"cell\">3</div>"
child_elements: "<div class=\"cell\">4</div>"
child_elements: "<div class=\"cell\">5</div>"
child_elements: "<div class=\"cell\">6</div>"
child_elements: "<div class=\"cell\">7</div>"
extra_css: ".cell { background: #0f3460; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #e94560; font-weight: 600; padding: 6px; }\n.cell.wide { grid-column: span 2; background: #e94560; color: #fff; }\n.cell.tall { grid-row: span 2; background: #e94560; color: #fff; }"
