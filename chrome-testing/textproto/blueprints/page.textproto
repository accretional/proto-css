demo_type: BOX
title: "Page"
target_base_style: "border-radius: 6px; background: #f5f5f5; box-shadow: 0 4px 16px rgba(0,0,0,0.3); width: 160px; height: 210px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;"
target_inner_html: "<div class=\"page-content\"><h3>Page Content</h3><p>This element uses a named page type for print layout.</p></div>"
extra_css: ".page-content { padding: 16px; text-align: center; }\n.page-content h3 { font-size: 12px; color: #333; margin-bottom: 6px; }\n.page-content p { font-size: 10px; color: #666; line-height: 1.5; }"
