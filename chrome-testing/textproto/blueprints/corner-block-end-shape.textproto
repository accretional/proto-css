demo_type: BOX
title: "Corner Block End Shape"
target_base_style: "width: 160px; height: 160px; background: linear-gradient(135deg, #0f3460, #16213e); border: 3px solid #e94560; border-radius: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #c0c0c0; position: relative;"
target_inner_html: "<span>round</span><div class=\"corner-dot highlight\" style=\"bottom:-9px;left:-9px;\"></div><div class=\"corner-dot highlight\" style=\"bottom:-9px;right:-9px;\"></div><div class=\"corner-dot dim\" style=\"top:-9px;left:-9px;\"></div><div class=\"corner-dot dim\" style=\"top:-9px;right:-9px;\"></div>"
extra_css: ".corner-dot { position: absolute; width: 18px; height: 18px; border-radius: 50%; }\n.highlight { background: #e94560; box-shadow: 0 0 10px #e9456088; }\n.dim { background: #7b8794; opacity: 0.4; }"
