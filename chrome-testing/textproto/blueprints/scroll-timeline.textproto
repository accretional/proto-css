demo_type: SCROLL
title: "Scroll Timeline"
target_base_style: "width: 100%; height: 180px; overflow-y: scroll; border-radius: 8px; background: #0a0a1a; position: relative; scroll-timeline: --myScroll block;"
target_inner_html: "<div class=\"progress-bar\"></div><div class=\"scroll-content\"><div class=\"animated-box\"></div></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 380px;"
extra_css: ".experimental { display: inline-block; background: #e9456033; color: #e94560; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px; margin-left: 8px; vertical-align: middle; }\n.scroll-content { height: 600px; padding: 16px; background: linear-gradient(180deg, #e9456033, #53348333, #2ecc7133); position: relative; }\n.scroll-content::after { content: 'Scroll down...'; position: absolute; bottom: 16px; left: 16px; font-size: 12px; color: #7b8794; }\n.progress-bar { position: sticky; top: 0; left: 0; width: 100%; height: 4px; background: #e94560; transform-origin: left; animation: grow-bar linear; animation-timeline: --myScroll; z-index: 1; }\n@keyframes grow-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }\n.animated-box { width: 40px; height: 40px; background: #e94560; border-radius: 8px; margin: 20px; animation: slide-right linear; animation-timeline: --myScroll; }\n@keyframes slide-right { from { transform: translateX(0) rotate(0deg); } to { transform: translateX(260px) rotate(360deg); } }"
screenshot_textproto: "static"
