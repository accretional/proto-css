demo_type: BOX
title: "Transition Property"
target_inner_html: "<div class=\"state-pair\"><div class=\"state-tag\">from</div><div class=\"box\" style=\"background:#e94560;\">A</div><div class=\"arrow\">&#10132;</div><div class=\"state-tag\">to</div><div class=\"box\" style=\"background:#3498db;\">B</div></div><div class=\"prop-list\"><div class=\"prop-item\"><span class=\"indicator\" style=\"background:#e94560;\"></span><span class=\"not-animated\">opacity - instant</span></div><div class=\"prop-item\"><span class=\"indicator\" style=\"background:#e94560;\"></span><span class=\"not-animated\">transform - instant</span></div><div class=\"prop-item\"><span class=\"indicator\" style=\"background:#e94560;\"></span><span class=\"not-animated\">bg-color - instant</span></div></div>"
target_base_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 230px;"
extra_css: ".state-pair { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }\n.state-tag { font-size: 9px; font-family: monospace; color: #6b7280; width: 36px; }\n.box { width: 60px; height: 60px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 9px; font-family: monospace; color: #fff; }\n.arrow { color: #4a5568; font-size: 14px; }\n.prop-list { margin-top: 8px; padding: 6px 10px; background: #0d1117; border-radius: 6px; }\n.prop-item { font-size: 10px; font-family: monospace; line-height: 1.6; }\n.animated { color: #16c79a; }\n.not-animated { color: #e94560; }\n.indicator { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }"
