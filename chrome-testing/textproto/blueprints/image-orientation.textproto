demo_type: IMAGE
title: "Image Orientation"
target_base_style: "width: 180px; height: 140px; border-radius: 6px; position: relative; overflow: hidden;"
target_inner_html: "<div class=\"landscape\"><div class=\"sun\"></div><span class=\"arrow\">TOP &#8593;</span></div>"
extra_css: ".landscape { width: 100%; height: 100%; background: linear-gradient(180deg, #e94560 0%, #e94560 40%, #0f3460 40%, #0f3460 60%, #53a653 60%); display: flex; align-items: center; justify-content: center; }\n.landscape::after { content: \"\\25B2\"; font-size: 40px; color: rgba(255,255,255,0.6); position: absolute; bottom: 20%; left: 50%; transform: translateX(-50%); }\n.sun { width: 30px; height: 30px; border-radius: 50%; background: #f5c542; position: absolute; top: 15px; right: 25px; }\n.arrow { position: absolute; top: 5px; left: 5px; font-size: 18px; color: rgba(255,255,255,0.8); background: rgba(0,0,0,0.4); border-radius: 4px; padding: 2px 6px; }"
