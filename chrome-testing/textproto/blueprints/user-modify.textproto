demo_type: TEXT
title: "User Modify"
target_inner_html: "This text is <strong>read-only</strong>. Users cannot edit this content. The element behaves like a normal, non-editable element."
target_base_style: "background: #0d1117; border-radius: 8px; padding: 16px; font-size: 14px; line-height: 1.6; min-height: 80px; border: 2px solid transparent; -webkit-user-modify: read-only;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 370px;"
extra_css: ".editable-area:focus { outline: none; }\n.status { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-family: monospace; padding: 4px 10px; border-radius: 20px; margin-bottom: 10px; }\n.status-dot { width: 8px; height: 8px; border-radius: 50%; }\n.readonly { border-color: #4a5568; }\n.readwrite { border-color: #16c79a; }\n.plaintext { border-color: #f39c12; }\n.desc { font-size: 12px; color: #6b7280; margin-bottom: 14px; line-height: 1.5; }"
