demo_type: TEXT
title: "User Select"
target_inner_html: "<span class=\"highlight-sim\">This text can be</span> selected normally, following the default browser selection behavior."
target_base_style: "background: #0d1117; border-radius: 8px; padding: 14px; font-size: 13px; line-height: 1.6; min-height: 90px; position: relative; user-select: auto;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 22px; width: 230px;"
extra_css: ".highlight-sim { background: rgba(59, 130, 246, 0.3); padding: 1px 2px; border-radius: 2px; }\n.no-highlight { color: #6b7280; }\n.badge { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-family: monospace; padding: 3px 8px; border-radius: 12px; margin-bottom: 8px; }\n.desc { font-size: 11px; color: #6b7280; margin-bottom: 12px; line-height: 1.4; }"
