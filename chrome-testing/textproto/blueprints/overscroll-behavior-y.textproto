demo_type: SCROLL
title: "Overscroll Behavior Y"
target_base_style: "width: 260px; height: 100px; border-radius: 6px; overflow-y: auto; overflow-x: hidden; margin: 8px auto; padding: 10px; font-size: 12px; line-height: 1.6; color: #c0c0c0; background: #2a1a3e; border: 2px solid #e94560;"
target_inner_html: "<p>Inner scrollable content. Scroll vertically past the boundary...</p><p>Y-axis overscroll will chain to the parent's vertical scroll.</p><p>This is the default behavior.</p><p>Line 4 of inner.</p><p>Line 5 of inner.</p>"
wrapper_style: "width: 320px; height: 180px; background: #0f3460; border-radius: 8px; overflow-y: auto; overflow-x: hidden;"
siblings_before: "<p class=\"outer-label\">Outer vertical scroll area</p>"
siblings_after: "<p class=\"outer-label\">More outer content below...</p><p class=\"outer-label\">Outer content continues...</p><p class=\"outer-label\">Even more outer content...</p><p class=\"outer-label\">End of outer.</p>"
extra_css: ".outer-label { font-size: 11px; color: #5a7aa0; margin-bottom: 6px; padding: 0 12px; }\np { margin-bottom: 6px; }"
