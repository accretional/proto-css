demo_type: BOX
title: "Interest Delay"
target_base_style: "width: 160px; height: 120px; background: #0f3460; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; position: relative; border: 2px solid #3a3a5e; cursor: pointer; transition: border-color 0.2s;"
target_inner_html: "<span class=\"icon\">&#9432;</span><span class=\"trigger-label\">Hover me</span>"
