extra_css: ".icon { font-size: 28px; }\n.trigger-label { font-size: 12px; color: #9ca3af; }\n.demo-area > div:hover { border-color: #e94560 !important; box-shadow: 0 0 12px rgba(233,69,96,0.4); }"
