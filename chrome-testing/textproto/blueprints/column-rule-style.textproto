demo_type: MULTICOL
title: "Column Rule Style"
target_base_style: "column-count: 3; column-rule-color: #e94560; column-rule-width: 3px; column-gap: 24px; font-size: 11px; line-height: 1.5; color: #c0c8d4;"
target_inner_html: "Column rule style controls the line style drawn between columns. Styles like solid, dashed, dotted, double, groove, and ridge create distinct visual effects between column separators in multi-column layouts."
