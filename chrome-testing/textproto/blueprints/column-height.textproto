demo_type: MULTICOL
title: "Column Height"
target_base_style: "column-count: 3; column-rule: 1px solid #3a3a5a; font-size: 11px; line-height: 1.5; color: #c0c8d4; background: #0f1a30; border-radius: 6px; padding: 12px; overflow: hidden;"
target_inner_html: "Columns grow to fit their content naturally. The container expands or contracts as needed. Text flows across columns and the overall height adjusts to accommodate all content. This simulates how column-height would constrain the column layout if supported."
