extra_css: ".flex-item { border-radius: 6px; padding: 10px 14px; display: flex; align-items: center; justify-content: center; }\n.item-a { background: rgba(102, 126, 234, 0.4); border: 2px solid #667eea; height: 70px; width: 80px; }\n.item-c { background: rgba(254, 202, 87, 0.4); border: 2px solid #feca57; height: 100px; width: 80px; }"
