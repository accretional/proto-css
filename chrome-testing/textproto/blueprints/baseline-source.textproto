target_base_style: "border-radius: 6px; padding: 10px 14px; display: flex; flex-direction: column; justify-content: space-between; background: rgba(240, 147, 251, 0.4); border: 2px solid #f093fb; font-size: 24px; height: 140px; width: 100px;"
