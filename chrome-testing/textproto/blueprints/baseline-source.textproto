extra_css: ".flex-item { border-radius: 6px; padding: 10px 14px; display: flex; flex-direction: column; justify-content: space-between; }\n.item-a { background: rgba(102, 126, 234, 0.4); border: 2px solid #667eea; font-size: 14px; height: 70px; width: 80px; }\n.item-c { background: rgba(254, 202, 87, 0.4); border: 2px solid #feca57; font-size: 14px; height: 100px; width: 80px; }\n.item-label { font-size: 10px; color: rgba(255,255,255,0.6); }"
