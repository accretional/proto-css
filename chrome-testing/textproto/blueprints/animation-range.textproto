demo_type: BOX
title: "Animation Range"
target_base_style: "position: relative; height: 40px; background: #0f3460; border-radius: 6px; overflow: hidden;"
target_inner_html: "<div class=\"timeline-full\"></div><div class=\"timeline-range\">0% &ndash; 100%</div><div class=\"marker marker-start\"></div><div class=\"marker marker-end\"></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px 28px;"
extra_css: ".demo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }\n.demo-title { font-size: 13px; color: #e0e0e0; font-weight: 600; }\n.timeline-full { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: repeating-linear-gradient(90deg, transparent, transparent 9.8%, rgba(255,255,255,0.08) 9.8%, rgba(255,255,255,0.08) 10.2%); }\n.timeline-range { position: absolute; top: 0; bottom: 0; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: #fff; left: 0%; right: 0%; background: linear-gradient(90deg, #e9456080, #e9456040); }\n.marker { position: absolute; top: -6px; bottom: -6px; width: 3px; border-radius: 2px; }\n.marker-start { background: #6ee7b7; left: 0%; }\n.marker-end { background: #f87171; left: calc(100% - 3px); }\n.tick-labels { display: flex; justify-content: space-between; margin-top: 6px; font-size: 10px; font-family: monospace; color: #6b7280; }"
