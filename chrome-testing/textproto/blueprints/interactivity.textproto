demo_type: BOX
title: "Interactivity"
target_base_style: "background: #0f3460; border-radius: 6px; padding: 20px; min-height: 180px;"
target_inner_html: "<button>Click Me</button><input type=\"text\" placeholder=\"Type here...\" value=\"Editable text\"><a href=\"#\">Focusable Link</a><p>This text is selectable. All elements are interactive and respond to user input normally.</p>"
wrapper_style: "background: #16213e; border-radius: 8px; padding: 24px; width: 360px;"
extra_css: ".demo-area button { background: #e94560; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-size: 14px; margin-bottom: 12px; }\n.demo-area button:hover { background: #c73652; }\n.demo-area input { display: block; width: 100%; padding: 8px 12px; border-radius: 4px; border: 1px solid #3a3a5e; background: #16213e; color: #e0e0e0; font-size: 14px; margin-bottom: 12px; }\n.demo-area a { color: #53a6f5; text-decoration: underline; display: inline-block; margin-bottom: 12px; }\n.demo-area p { font-size: 13px; color: #9ca3af; user-select: text; }"
screenshot_textproto: "hover"
