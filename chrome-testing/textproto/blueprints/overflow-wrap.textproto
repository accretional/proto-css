demo_type: TEXT
title: "Overflow Wrap"
target_base_style: "width: 100%; background: #0f3460; border-radius: 6px; border: 2px solid #3a3a5c; padding: 14px; font-size: 13px; line-height: 1.6; color: #c0c0d0;"
target_inner_html: "<p>This text has a <span class=\"long-word\">Supercalifragilisticexpialidociousandreallyreallylongword</span> that may overflow the container.</p><p style=\"margin-top:8px;\">Also: <span class=\"long-word\">https://www.example.com/very/long/url/path/that/extends/beyond</span></p>"
extra_css: ".long-word { color: #e94560; font-weight: bold; background: rgba(233,69,96,0.1); }"
