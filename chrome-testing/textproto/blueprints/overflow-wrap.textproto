demo_type: TEXT
title: "Overflow Wrap"
target_base_style: "width: 160px; background: #0f3460; border-radius: 6px; border: 2px solid #3a3a5c; padding: 14px; font-size: 13px; line-height: 1.6; color: #c0c0d0; overflow: visible;"
target_inner_html: "<p>Text with a <span class=\"long-word\">Pneumonoultramicroscopicsilicovolcanoconiosis</span> long unbreakable word.</p><p style=\"margin-top:8px;\">URL: <span class=\"long-word\">https://www.example.com/very/long/url/path/that/extends</span></p>"
extra_css: ".long-word { color: #e94560; font-weight: bold; background: rgba(233,69,96,0.15); }"
