demo_type: BOX
title: "Transition Duration"
target_inner_html: "<div class=\"bar-fill\" style=\"width: 2px; background: #e94560;\"></div><span class=\"duration-label\">instant (no transition)</span>"
target_base_style: "position: relative; height: 36px; flex: 1; background: #16213e; border-radius: 8px; overflow: hidden; max-width: 750px;"
wrapper_style: "display: flex; flex-direction: column; gap: 16px;"
extra_css: ".demo-row { display: flex; align-items: center; gap: 16px; }\n.label { font-size: 12px; font-family: monospace; color: #9ca3af; width: 300px; flex-shrink: 0; }\n.bar-fill { position: absolute; top: 0; left: 0; height: 100%; border-radius: 8px; display: flex; align-items: center; padding-left: 12px; font-size: 10px; font-family: monospace; color: #fff; }\n.duration-label { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-size: 10px; font-family: monospace; color: rgba(255,255,255,0.7); }\n.info { font-size: 12px; color: #6b7280; margin-top: 20px; line-height: 1.6; max-width: 700px; }\n.demo-area .active.bar-fill { width: 100% !important; }"
screenshot_textproto: "temporal"
