demo_type: BOX
title: "Transition Duration"
property_target_selector: ".box"
target_inner_html: "<div class=\"box\" style=\"width: 60px; height: 60px; background: #e94560;\"></div>"
target_base_style: "display: flex; align-items: center; justify-content: center; min-height: 100px; background: #0f3460; border-radius: 8px; padding: 16px;"
extra_css: ".box { border-radius: 8px; transition-property: width, height, background, border-radius; transition-delay: 0s; transition-timing-function: ease; }\n.demo-area .box.active { width: 100% !important; height: 30px !important; background: #16c79a !important; border-radius: 4px !important; }"
screenshot_textproto: "temporal"
