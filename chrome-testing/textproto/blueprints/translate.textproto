target_base_style: "position: absolute; width: 60px; height: 60px; border-radius: 8px; top: 50px; left: 20px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-family: monospace; color: #fff; background: #e94560;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 280px; height: 260px; position: relative;"
extra_css: ".canvas { position: relative; width: 240px; height: 160px; border: 1px dashed #2a3a5c; border-radius: 6px; overflow: visible; }\n.ghost { position: absolute; width: 60px; height: 60px; border: 2px dashed #4a5568; border-radius: 8px; top: 50px; left: 20px; }\n.origin-dot { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: #ffd700; top: 77px; left: 47px; z-index: 2; }"
