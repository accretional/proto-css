demo_type: TEXT
title: "White Space Collapse"
target_inner_html: "Hello      world.     Multiple     spaces     are\ncollapsed     into     a     single     space.\n\nMultiple newlines are also collapsed."
target_base_style: "background: #0f1a30; border: 1px solid #2a2a4a; border-radius: 6px; padding: 14px; font-size: 13px; line-height: 1.6; color: #d1d5db; min-height: 100px; text-wrap: wrap; overflow: hidden; white-space-collapse: collapse;"
wrapper_style: "background: #16213e; border-radius: 10px; padding: 20px;"
extra_css: ".demos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }\n.note { font-size: 10px; color: #6b7280; margin-top: 6px; line-height: 1.4; }"
