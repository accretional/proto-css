demo_type: POSITION
title: "Offset Position"
target_base_style: "width: 24px; height: 24px; background: #e94560; border-radius: 4px; position: absolute; offset-path: path(\"M 0,0 L 80,0\"); offset-distance: 100%; box-shadow: 0 0 10px rgba(233,69,96,0.5);"
wrapper_style: "width: 240px; height: 240px; position: relative; background: repeating-linear-gradient(0deg, transparent, transparent 59px, #2a2a4a 59px, #2a2a4a 60px), repeating-linear-gradient(90deg, transparent, transparent 59px, #2a2a4a 59px, #2a2a4a 60px);"
siblings_before: "<div class=\"start-marker\"></div>"
extra_css: ".start-marker { width: 16px; height: 16px; background: #00ff88; border-radius: 50%; position: absolute; box-shadow: 0 0 10px rgba(0,255,136,0.6); top: 0; left: 0; }"
