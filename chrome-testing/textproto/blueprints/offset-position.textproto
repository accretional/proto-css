demo_type: POSITION
title: "Offset Position"
target_base_style: "width: 24px; height: 24px; background: #e94560; border-radius: 4px; position: absolute; offset-path: ray(0deg closest-side); offset-distance: 50%; box-shadow: 0 0 10px rgba(233,69,96,0.5);"
wrapper_style: "width: 240px; height: 240px; position: relative; background: repeating-linear-gradient(0deg, transparent, transparent 59px, #2a2a4a 59px, #2a2a4a 60px), repeating-linear-gradient(90deg, transparent, transparent 59px, #2a2a4a 59px, #2a2a4a 60px); border: 1px solid #2a2a4a;"
siblings_before: "<div class=\"crosshair-h\"></div><div class=\"crosshair-v\"></div>"
extra_css: ".crosshair-h { position: absolute; left: 0; right: 0; top: 50%; border-top: 1px dashed #3a4a5e; }\n.crosshair-v { position: absolute; top: 0; bottom: 0; left: 50%; border-left: 1px dashed #3a4a5e; }"
screenshot_textproto: "static"
