demo_type: SCROLL
title: "Scroll Target Group"
target_base_style: "width: 100%; height: 160px; overflow-y: scroll; border-radius: 8px; background: #0a0a1a; position: relative;"
target_inner_html: "<div class=\"section group-a\"><div class=\"section-icon\">&#9733;</div><div><div class=\"section-text\">Section Alpha</div><span class=\"section-tag\">group-a</span></div></div><div class=\"section group-b\"><div class=\"section-icon\">&#9830;</div><div><div class=\"section-text\">Section Beta</div><span class=\"section-tag\">group-b</span></div></div><div class=\"section group-a\"><div class=\"section-icon\">&#9733;</div><div><div class=\"section-text\">Section Gamma</div><span class=\"section-tag\">group-a</span></div></div><div class=\"section group-none\"><div class=\"section-icon\">&#9679;</div><div><div class=\"section-text\">Section Delta</div><span class=\"section-tag\">none</span></div></div><div class=\"section group-b\"><div class=\"section-icon\">&#9830;</div><div><div class=\"section-text\">Section Epsilon</div><span class=\"section-tag\">group-b</span></div></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; width: 370px;"
extra_css: ".section { padding: 16px; min-height: 100px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #1a1a2e; }\n.section-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }\n.section-text { font-size: 13px; color: #e0e0e0; }\n.section-tag { font-size: 9px; font-family: monospace; padding: 2px 6px; border-radius: 3px; margin-top: 4px; display: inline-block; }\n.group-a .section-icon { background: #e9456033; }\n.group-a .section-tag { background: #e9456022; color: #e94560; }\n.group-b .section-icon { background: #2ecc7133; }\n.group-b .section-tag { background: #2ecc7122; color: #2ecc71; }\n.group-none .section-icon { background: #7b879433; }\n.group-none .section-tag { background: #7b879422; color: #7b8794; }"
