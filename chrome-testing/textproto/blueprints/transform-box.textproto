demo_type: BOX
title: "Transform Box"
target_base_style: "width: 80px; height: 80px; border: 4px solid #394867; padding: 12px; position: relative; transform: rotate(30deg);"
target_inner_html: "<div class=\"box-inner\"></div>"
wrapper_style: "width: 160px; height: 160px; display: flex; align-items: center; justify-content: center; position: relative;"
siblings_before: "<div class=\"ghost\"></div>"
extra_css: ".ghost { position: absolute; top: 50%; left: 50%; width: 80px; height: 80px; border: 2px dashed #394867; transform: translate(-50%, -50%); }\n.box-inner { width: 100%; height: 100%; background: linear-gradient(135deg, #e94560, #c2185b); border-radius: 4px; }"
