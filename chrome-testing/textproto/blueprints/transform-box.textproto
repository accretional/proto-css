demo_type: BOX
title: "Transform Box"
target_base_style: "width: 40px; height: 40px; border: 25px solid rgba(79, 195, 247, 0.4); padding: 15px; background: transparent; transform: rotate(45deg); transform-origin: top left; position: relative;"
target_inner_html: "<div class=\"box-inner\"></div>"
wrapper_style: "width: 240px; height: 240px; display: flex; align-items: center; justify-content: center; position: relative;"
siblings_before: "<div class=\"origin-marker\"></div>"
extra_css: ".origin-marker { position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; background: #ef4444; border-radius: 50%; transform: translate(-50%, -50%); z-index: 10; }\n.box-inner { width: 100%; height: 100%; background: linear-gradient(135deg, #e94560, #c2185b); border-radius: 2px; }"
max_values: 5
screenshot_textproto: "static"
