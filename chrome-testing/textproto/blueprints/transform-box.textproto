demo_type: BOX
title: "Transform Box"
target_base_style: "width: 30px; height: 30px; border: 30px solid rgba(57, 72, 103, 0.6); padding: 25px; margin: 0; position: relative; transform: rotate(45deg); background: transparent;"
target_inner_html: "<div class=\"box-inner\"></div>"
wrapper_style: "width: 240px; height: 240px; display: flex; align-items: center; justify-content: center; position: relative;"
siblings_before: "<div class=\"ghost\"></div>"
extra_css: ".ghost { position: absolute; top: 50%; left: 50%; width: 30px; height: 30px; border: 2px dashed #394867; transform: translate(-50%, -50%); pointer-events: none; }\n.box-inner { width: 100%; height: 100%; background: linear-gradient(135deg, #e94560, #c2185b); border-radius: 4px; }"
max_values: 5
screenshot_textproto: "static"
