demo_type: BOX
title: "Color Scheme"
target_base_style: "border-radius: 10px; padding: 24px; border: 1px solid #2a2a4a;"
target_inner_html: "<div class=\"form-group\"><label>Text Input</label><input type=\"text\" value=\"Sample text\"/></div><div class=\"form-group\"><label>Select</label><select><option>Option A</option><option>Option B</option></select></div><div class=\"form-group\"><label>Range</label><input type=\"range\" min=\"0\" max=\"100\" value=\"60\"/></div><div class=\"form-group\"><div class=\"checkbox-row\"><input type=\"checkbox\" checked/><label>Checkbox</label></div></div>"
extra_css: ".form-group { margin-bottom: 12px; }\n.form-group label { display: block; font-size: 12px; margin-bottom: 4px; font-weight: 500; }\n.form-group input[type=\"text\"], .form-group select, .form-group textarea { width: 100%; padding: 8px 10px; border-radius: 6px; font-size: 13px; font-family: system-ui, sans-serif; }\n.form-group input[type=\"range\"] { width: 100%; }\n.form-group input[type=\"checkbox\"] { margin-right: 6px; }\n.checkbox-row { display: flex; align-items: center; font-size: 12px; }"
screenshot_textproto: "static"
