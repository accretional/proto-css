demo_type: SCROLL
title: "View Timeline Inset"
target_inner_html: "auto"
target_base_style: "padding: 14px; margin: 6px 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; background: linear-gradient(135deg, #7b2ff7, #c471f5); animation: reveal 1s linear both; animation-timeline: view(); animation-range: entry 0% entry 100%;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 20px; border: 1px solid #2a2a4a;"
siblings_before: "<div class=\"spacer\"></div><div class=\"filler\">...</div>"
siblings_after: "<div class=\"filler\">...</div><div class=\"target c1 inset-auto\">auto</div><div class=\"filler\">...</div><div class=\"spacer\"></div>"
extra_css: ".demos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n.demo-label { font-size: 12px; font-weight: 600; color: #64ffda; font-family: 'SF Mono', 'Fira Code', monospace; margin-bottom: 10px; background: #0d1117; padding: 6px 10px; border-radius: 6px; display: inline-block; }\n.demo-desc { font-size: 11px; color: #8888aa; margin-bottom: 12px; line-height: 1.5; }\n.scroll-box { height: 170px; overflow-y: auto; border-radius: 8px; background: #0d1117; position: relative; }\n.scroll-box::-webkit-scrollbar { width: 4px; }\n.scroll-box::-webkit-scrollbar-track { background: #0d1117; }\n.scroll-box::-webkit-scrollbar-thumb { background: #444; border-radius: 2px; }\n.spacer { height: 50px; }\n.filler { padding: 10px; margin: 6px 8px; border-radius: 6px; background: #2a2a4a; text-align: center; font-size: 11px; color: #666; }\n.target { padding: 14px; margin: 6px 8px; border-radius: 8px; text-align: center; font-size: 13px; font-weight: 600; color: #fff; animation: reveal 1s linear both; animation-range: entry 0% entry 100%; }\n.c1 { background: linear-gradient(135deg, #7b2ff7, #c471f5); }\n.inset-auto { animation-timeline: view(); }\n.inset-visual { display: flex; align-items: center; justify-content: center; height: 30px; margin-bottom: 8px; position: relative; }\n.inset-bar { width: 100%; height: 4px; background: #2a2a4a; border-radius: 2px; position: relative; }\n.inset-active { position: absolute; height: 4px; background: #64ffda; border-radius: 2px; top: 0; }\n@keyframes reveal { from { opacity: 0.1; transform: scale(0.8) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }"
screenshot_textproto: "temporal"
