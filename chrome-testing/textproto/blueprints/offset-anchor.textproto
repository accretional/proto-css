demo_type: POSITION
title: "Offset Anchor"
target_base_style: "width: 40px; height: 40px; background: #e94560; border-radius: 4px; position: absolute; top: 0; left: 0; offset-path: path(\"M 20,100 C 60,20 180,20 220,100\"); offset-distance: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: bold; color: #fff;"
target_inner_html: "<div class=\"anchor-dot\"></div>"
wrapper_style: "width: 240px; height: 200px; position: relative;"
siblings_before: "<svg class=\"path-visual\" viewBox=\"0 0 240 200\" style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%;\"><path d=\"M 20,100 C 60,20 180,20 220,100\" fill=\"none\" stroke=\"#3a3a5c\" stroke-width=\"2\" stroke-dasharray=\"4 4\"/></svg>"
extra_css: ".anchor-dot { width: 6px; height: 6px; background: #00ff88; border-radius: 50%; position: absolute; }"
