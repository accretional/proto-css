demo_type: SCROLL
title: "Overscroll Behavior Block"
target_base_style: "width: 260px; height: 110px; border-radius: 6px; overflow: auto; margin: 8px auto; padding: 10px; font-size: 12px; line-height: 1.6; color: #c0c0c0; background: #2a1a3e; border: 2px solid #e94560;"
target_inner_html: "<p>Inner content -- scroll vertically past the boundary...</p><p>Block-axis overscroll will chain to the parent.</p><p>Default browser behavior.</p><p>Line 4.</p><p>Line 5.</p>"
wrapper_style: "width: 320px; height: 190px; background: #0f3460; border-radius: 8px; overflow: auto; position: relative;"
siblings_before: "<p class=\"outer-label\">Outer scrollable area</p>"
siblings_after: "<p class=\"outer-label\">Outer content below</p><p class=\"outer-label\">More outer content...</p><p class=\"outer-label\">End of outer.</p>"
extra_css: ".outer-label { font-size: 11px; color: #5a7aa0; margin-bottom: 6px; padding: 0 12px; }\np { margin-bottom: 6px; }"
screenshot_textproto: "scroll"
