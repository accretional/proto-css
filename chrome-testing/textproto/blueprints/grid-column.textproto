demo_type: GRID
title: "Grid Column"
wrapper_style: "display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: 50px 50px; gap: 6px; background: #0a1a35; border-radius: 8px; padding: 6px;"
target_base_style: "background: #e94560; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #fff; font-weight: 600;"
target_inner_html: "Item"
siblings_after: "<div class=\"cell\">2</div>"
siblings_after: "<div class=\"cell\">3</div>"
siblings_after: "<div class=\"cell\">4</div>"
siblings_after: "<div class=\"cell\">5</div>"
siblings_after: "<div class=\"cell\">6</div>"
siblings_after: "<div class=\"cell\">7</div>"
extra_css: ".cell { background: #0f3460; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #4a5568; font-weight: 600; }"
screenshot_textproto: "static"
