extra_css: ".snap-item { min-width: 300px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; scroll-snap-align: end; flex-shrink: 0; }\n.snap-item:nth-child(odd) { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }\n.snap-item:nth-child(even) { background: #22224a; }"
