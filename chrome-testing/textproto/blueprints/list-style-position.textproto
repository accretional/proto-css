demo_type: LIST
title: "List Style Position"
target_tag: "ul"
target_base_style: "font-size: 14px; line-height: 1.8; color: #e0e0e0;"
target_inner_html: "<li>First item with positioning. The marker is inside or outside the content box of the list item element. This text is intentionally long enough to wrap to multiple lines so you can see how the marker position affects text alignment on subsequent lines.</li><li>Second item also has enough text to demonstrate wrapping behavior relative to the list marker position clearly.</li><li>Third item for reference with additional words to ensure wrapping occurs.</li>"
wrapper_style: "background: #0f3460; border-radius: 8px; padding: 16px 16px 16px 44px;"
extra_css: "li { background: rgba(233, 69, 96, 0.1); border: 1px solid rgba(233, 69, 96, 0.3); border-radius: 4px; margin-bottom: 6px; padding: 4px 8px; }"
screenshot_textproto: "static"
