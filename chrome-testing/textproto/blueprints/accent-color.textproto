demo_type: BOX
title: "Accent Color"
target_inner_html: "<div class=\"controls\"><div class=\"control-row\"><input type=\"checkbox\" checked><span>Checkbox</span></div><div class=\"control-row\"><input type=\"radio\" name=\"demo\" checked><span>Radio</span></div><div class=\"control-row\"><input type=\"range\" value=\"60\"></div></div>"
target_base_style: "background: #16213e; border-radius: 12px; padding: 24px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; min-width: 200px;"
extra_css: ".controls { display: flex; flex-direction: column; gap: 10px; }\n.control-row { display: flex; align-items: center; gap: 10px; }\n.control-row span { font-size: 13px; color: #ccc; }\ninput[type=\"checkbox\"], input[type=\"radio\"] { width: 20px; height: 20px; }\ninput[type=\"range\"] { width: 160px; }"
