demo_type: BOX
title: "Transform Style"
target_base_style: "width: 150px; height: 150px; position: relative; transform: rotateY(35deg) rotateX(15deg); border: 2px solid rgba(233, 69, 96, 0.5); background: rgba(233, 69, 96, 0.1);"
target_inner_html: "<div class=\"child-front\">Front Z+40</div><div class=\"child-back\">Back Z-40</div>"
wrapper_style: "width: 200px; height: 200px; perspective: 600px; display: flex; align-items: center; justify-content: center;"
extra_css: ".child-front { position: absolute; width: 100%; height: 100%; background: rgba(52, 211, 153, 0.4); border: 2px solid #34d399; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; color: #34d399; transform: translateZ(40px); }\n.child-back { position: absolute; width: 100%; height: 100%; background: rgba(59, 130, 246, 0.4); border: 2px solid #3b82f6; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; color: #3b82f6; transform: translateZ(-40px); }"
screenshot_textproto: "static"
