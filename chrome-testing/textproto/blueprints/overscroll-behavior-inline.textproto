demo_type: SCROLL
title: "Overscroll Behavior Inline"
target_base_style: "width: 240px; height: 100px; border-radius: 6px; overflow: auto; margin: 8px 12px; padding: 10px; font-size: 12px; color: #c0c0c0; white-space: nowrap; display: inline-block; vertical-align: top; background: #2a1a3e; border: 2px solid #e94560;"
target_inner_html: "<div class=\"inner-wide\"><p>Scroll horizontally past the boundary of this inner container...</p><p>Inline-axis overscroll will chain to the parent container's horizontal scroll.</p></div>"
wrapper_style: "width: 320px; height: 160px; background: #0f3460; border-radius: 8px; overflow: auto; white-space: nowrap;"
siblings_before: "<span class=\"outer-label\">Outer horizontal scroll area</span>"
siblings_after: "<span class=\"outer-label\" style=\"margin-left:20px;\">More outer content to the right</span>"
extra_css: ".outer-label { font-size: 11px; color: #5a7aa0; }\n.inner-wide { display: inline-block; min-width: 600px; white-space: normal; line-height: 1.5; }\n.inner-wide p { margin-bottom: 4px; }"
