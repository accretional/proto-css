demo_type: BOX
title: "Container Type"
target_base_style: "background: #0f1a30; border-radius: 8px; padding: 16px; border: 2px solid #2a2a4a; position: relative;"
child_elements: "<div class=\"type-badge\">type</div>"
child_elements: "<div class=\"inner-demo\"><div class=\"inner-box\"><h3>Container Content</h3><p>This element establishes a container with the specified type, controlling which dimensional queries can target it.</p></div></div>"
child_elements: "<div class=\"feature-list\"><span class=\"feature feature-yes\">inline-size queries</span><span class=\"feature feature-yes\">style queries</span></div>"
extra_css: ".type-badge { position: absolute; top: -9px; right: 14px; font-size: 9px; font-family: monospace; padding: 2px 10px; border-radius: 3px; font-weight: 600; background: #4fc3f7; color: #0f1a30; }\n.inner-demo { display: flex; gap: 12px; }\n.inner-box { flex: 1; background: #1a2440; border: 1px solid #3a3a5a; border-radius: 6px; padding: 12px; }\n.inner-box h3 { font-size: 12px; font-weight: 600; margin-bottom: 4px; }\n.inner-box p { font-size: 11px; color: #9ca3af; line-height: 1.5; }\n.feature-list { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }\n.feature { font-size: 9px; font-family: monospace; padding: 3px 8px; border-radius: 3px; }\n.feature-yes { background: rgba(102, 187, 106, 0.2); color: #66bb6a; }"
