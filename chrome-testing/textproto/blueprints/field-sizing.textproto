demo_type: BOX
title: "Field Sizing"
target_tag: "textarea"
target_base_style: "background: #0f3460; border: 2px solid #4fc3f7; border-radius: 8px; color: #e0e0e0; font-family: system-ui, sans-serif; font-size: 14px; padding: 10px 14px; outline: none; display: block; width: 100%; min-height: 36px; max-height: 200px; resize: none;"
target_inner_html: "This textarea has enough content to demonstrate field-sizing. With field-sizing: content, the textarea grows to fit all this text. With field-sizing: fixed, it stays at the minimum height regardless of content length."
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; flex: 1;"
screenshot_textproto: "static"
