demo_type: INLINE
title: "Vertical Align"
target_tag: "span"
target_base_style: "display: inline-block; width: 28px; height: 28px; border-radius: 4px; margin: 0 4px; background: #e94560;"
wrapper_style: "display: flex; flex-direction: column; gap: 12px;"
siblings_before: "<span class=\"ref-text\">Text </span>"
siblings_after: "<span class=\"ref-text\"> aligned to baseline</span>"
extra_css: ".demo-row { display: flex; align-items: center; gap: 16px; }\n.label-col { width: 280px; flex-shrink: 0; }\n.val-name { font-size: 13px; font-family: monospace; color: #e0e0e0; font-weight: 600; }\n.val-label { font-size: 11px; font-family: monospace; color: #9ca3af; }\n.line-container { flex: 1; max-width: 700px; background: #16213e; border-radius: 8px; padding: 12px 16px; position: relative; line-height: 60px; font-size: 18px; }\n.baseline-line { position: absolute; left: 16px; right: 16px; border-top: 1px dashed #4a5568; }\n.ref-text { color: #6b7280; font-size: 18px; }\n.aligned-text { font-size: 14px; font-weight: 600; display: inline; }"
