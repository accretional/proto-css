demo_type: SVG
title: "Stop Opacity"
target_tag: "svg"
target_base_style: "display: block;"
target_inner_html: "<defs><pattern id=\"check0\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\"><rect width=\"5\" height=\"5\" fill=\"#333\"/><rect x=\"5\" y=\"5\" width=\"5\" height=\"5\" fill=\"#333\"/><rect x=\"5\" width=\"5\" height=\"5\" fill=\"#222\"/><rect y=\"5\" width=\"5\" height=\"5\" fill=\"#222\"/></pattern><linearGradient id=\"g0\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#e94560\" stop-opacity=\"0\" /><stop offset=\"100%\" stop-color=\"#e94560\" stop-opacity=\"1\" /></linearGradient></defs><rect x=\"5\" y=\"5\" width=\"180\" height=\"70\" rx=\"10\" fill=\"url(#check0)\" /><rect x=\"5\" y=\"5\" width=\"180\" height=\"70\" rx=\"10\" fill=\"url(#g0)\" /><text x=\"15\" y=\"95\" font-size=\"9\" fill=\"#7b8794\" font-family=\"monospace\">opacity: 0</text><text x=\"135\" y=\"95\" font-size=\"9\" fill=\"#7b8794\" font-family=\"monospace\">opacity: 1</text>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 18px; width: 228px;"
extra_css: ".svg-container { background: #0a0a1a; border-radius: 8px; padding: 10px; display: flex; align-items: center; justify-content: center; }\n.opacity-bar { display: flex; align-items: center; gap: 6px; margin-top: 8px; }\n.ob-track { flex: 1; height: 6px; background: #333; border-radius: 3px; overflow: hidden; }\n.ob-fill { height: 100%; background: #e94560; border-radius: 3px; }\n.ob-value { font-size: 14px; font-weight: 700; color: #e94560; min-width: 30px; text-align: right; }"
