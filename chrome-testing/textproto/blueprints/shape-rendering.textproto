target_inner_html: "<circle cx=\"110\" cy=\"60\" r=\"45\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"2\"/><rect x=\"40\" y=\"130\" width=\"140\" height=\"80\" rx=\"4\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2\"/><polygon points=\"110,240 160,320 60,320\" fill=\"none\" stroke=\"#a78bfa\" stroke-width=\"2\"/><ellipse cx=\"110\" cy=\"380\" rx=\"70\" ry=\"40\" fill=\"none\" stroke=\"#7c3aed\" stroke-width=\"2\"/><line x1=\"30\" y1=\"450\" x2=\"190\" y2=\"510\" stroke=\"#c4b5fd\" stroke-width=\"2\"/><path d=\"M30,470 Q110,430 190,470\" fill=\"none\" stroke=\"#ddd6fe\" stroke-width=\"2\"/>"
