demo_type: BOX
title: "Interest Delay Start"
target_base_style: "width: 220px; background: #0f3460; border-radius: 8px; padding: 16px; position: relative;"
target_inner_html: "<div class=\"tooltip-trigger\">Hover target</div><div class=\"tooltip-box\">Tooltip content</div>"
wrapper_style: "background: #16213e; border-radius: 8px; padding: 20px; width: 260px; display: flex; flex-direction: column; align-items: center;"
extra_css: ".tooltip-trigger { width: 100%; height: 40px; background: #16213e; border: 2px solid #3a3a5e; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #9ca3af; cursor: pointer; }\n.tooltip-box { margin-top: 8px; background: #e94560; color: #fff; font-size: 11px; padding: 8px 12px; border-radius: 4px; text-align: center; }"
