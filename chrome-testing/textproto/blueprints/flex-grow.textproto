demo_type: FLEX
title: "Flex Grow"
target_base_style: "background: #023e8a; border-color: #4cc9f0; color: #fff; font-weight: 700; flex-basis: 0;"
wrapper_style: "display: flex; background: #16213e; border-radius: 8px; padding: 12px; height: 80px; align-items: stretch; gap: 8px;"
siblings_after: "<div class=\"item\" style=\"flex-grow: 1;\">grow: 1</div>"
siblings_after: "<div class=\"item\" style=\"flex-grow: 1;\">grow: 1</div>"
extra_css: ".item { background: #0f3460; border: 2px solid #4cc9f0; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-family: monospace; color: #4cc9f0; flex-basis: 0; padding: 0 6px; }\n.item.target { background: #023e8a; border-color: #4cc9f0; color: #fff; font-weight: 700; }"
