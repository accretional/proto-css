demo_type: BOX
title: "Mask Border Slice"
target_base_style: "width: 200px; height: 200px; position: relative; margin: 0 auto;"
target_inner_html: "<div class=\"full\"></div><div class=\"slice-line-h\" style=\"top: 10%;\"></div><div class=\"slice-line-h\" style=\"top: 90%;\"></div><div class=\"slice-line-v\" style=\"left: 10%;\"></div><div class=\"slice-line-v\" style=\"left: 90%;\"></div><span class=\"slice-val\" style=\"top: 10%; right: -30px;\">slice</span>"
extra_css: ".full { width: 100%; height: 100%; border: 2px solid #4a5568; border-radius: 4px; position: absolute; background: linear-gradient(135deg, #e94560 0%, #a855f7 50%, #00d2ff 100%); }\n.slice-line-h { position: absolute; left: 0; width: 100%; height: 0; border-top: 2px dashed #f9a825; z-index: 2; }\n.slice-line-v { position: absolute; top: 0; height: 100%; width: 0; border-left: 2px dashed #f9a825; z-index: 2; }\n.slice-val { position: absolute; font-size: 10px; font-family: monospace; color: #f9a825; z-index: 3; background: #16213e; padding: 1px 4px; border-radius: 2px; }"
