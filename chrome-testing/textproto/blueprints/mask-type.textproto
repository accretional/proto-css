demo_type: SVG
title: "Mask Type"
target_tag: "svg"
target_base_style: "width: 200px; height: 120px;"
target_inner_html: "<defs><mask id=\"typeMask\" maskContentUnits=\"objectBoundingBox\"><rect width=\"1\" height=\"1\" fill=\"white\"/><circle cx=\"0.5\" cy=\"0.5\" r=\"0.3\" fill=\"black\"/></mask><linearGradient id=\"grad1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#e94560\"/><stop offset=\"50%\" stop-color=\"#a855f7\"/><stop offset=\"100%\" stop-color=\"#00d2ff\"/></linearGradient></defs><rect width=\"200\" height=\"120\" fill=\"url(#grad1)\" mask=\"url(#typeMask)\"/>"
wrapper_style: "display: flex; gap: 24px; align-items: flex-start;"
siblings_before: "<div><div class=\"svg-demo\"><svg width=\"160\" height=\"120\" viewBox=\"0 0 160 120\"><rect width=\"160\" height=\"120\" fill=\"#334155\"/><text x=\"30\" y=\"30\" font-size=\"10\" fill=\"#94a3b8\" font-family=\"monospace\">mask source</text><circle cx=\"80\" cy=\"60\" r=\"40\" fill=\"black\" opacity=\"0.5\"/></svg></div><p class=\"section-label\">SVG mask</p></div><div class=\"arrow-col\">&rarr;</div>"
extra_css: ".svg-demo { border: 1px solid #2d3748; border-radius: 6px; overflow: hidden; background: #0f172a; }\n.section-label { font-size: 10px; color: #6b7280; text-align: center; margin-top: 4px; }\n.arrow-col { display: flex; align-items: center; font-size: 18px; color: #4a5568; padding-top: 50px; }"
screenshot_textproto: "static"
