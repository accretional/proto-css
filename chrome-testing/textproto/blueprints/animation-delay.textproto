demo_type: BOX
title: "Animation Delay"
target_base_style: "width: 48px; height: 48px; border-radius: 8px; position: absolute; left: 0; top: 50%; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; color: #fff; background: #e94560; animation: slideAcross 4s linear infinite;"
wrapper_style: "position: relative; height: 64px; background: #0f3460; border-radius: 8px; overflow: hidden;"
max_values: 8
extra_css: "@keyframes slideAcross {\n  from { left: 0; }\n  to { left: calc(100% - 48px); }\n}"
screenshot_textproto: "temporal"
