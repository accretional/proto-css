demo_type: FLEX
title: "Flex Basis"
target_base_style: "background: #533483; border: 2px solid #a78bfa; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-family: monospace; color: #fff; font-weight: 700; flex-grow: 0; flex-shrink: 0; min-width: 0; padding: 0 4px;"
