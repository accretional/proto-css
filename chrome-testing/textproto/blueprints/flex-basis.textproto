extra_css: ".item { background: #0f3460; border: 1px solid #533483; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-family: monospace; color: #a78bfa; padding: 0 8px; flex-shrink: 0; }\n.item.target { background: #533483; border-color: #a78bfa; color: #fff; font-weight: 700; }"
