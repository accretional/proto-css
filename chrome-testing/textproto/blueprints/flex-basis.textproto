demo_type: FLEX
title: "Flex Basis"
target_base_style: "background: #533483; border-color: #a78bfa; color: #fff; font-weight: 700;"
wrapper_style: "display: flex; background: #16213e; border-radius: 8px; padding: 12px; height: 70px; align-items: stretch; gap: 8px;"
