demo_type: BOX
title: "Animation Iteration Count"
target_base_style: "width: 40px; height: 40px; border-radius: 6px; position: absolute; left: 0; top: 50%; margin-top: -20px; background: #e94560; animation: slideCount 0.5s linear; animation-delay: -0.2s;"
wrapper_style: "position: relative; height: 56px; background: #0f3460; border-radius: 8px; overflow: hidden;"
max_values: 6
extra_css: "@keyframes slideCount {\n  from { left: 0; background: #e94560; }\n  to { left: calc(100% - 40px); background: #3498db; }\n}"
screenshot_textproto: "temporal"
