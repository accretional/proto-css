demo_type: BOX
title: "Animation Iteration Count"
target_base_style: "width: 40px; height: 40px; border-radius: 6px; background: #e94560; animation: spin 1s linear; animation-delay: -0.5s;"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; width: 270px; display: flex; flex-direction: column; align-items: center; gap: 12px;"
extra_css: ".demo-title { font-size: 14px; color: #fff; font-weight: bold; }\n.iteration-visual { display: flex; gap: 8px; align-items: center; min-height: 40px; }\n.iter-dot { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; color: #fff; }\n.iter-dot.active { background: #e94560; }\n.iter-dot.inactive { background: #2d3748; border: 2px dashed #4a5568; color: #4a5568; }\n.progress-bar { width: 200px; height: 12px; background: #0f3460; border-radius: 6px; overflow: hidden; position: relative; }\n@keyframes spin {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}"
