demo_type: SCROLL
title: "Scroll Snap Stop"
target_base_style: "width: 100%; height: 140px; overflow-x: scroll; display: flex; scroll-snap-type: x mandatory; border-radius: 8px; background: #0a0a1a;"
child_elements: "<div class=\"snap-item\" style=\"background: #e94560;\">1<span class=\"num-label\">stop</span></div>"
child_elements: "<div class=\"snap-item\" style=\"background: #0f3460;\">2<span class=\"num-label\">stop</span></div>"
child_elements: "<div class=\"snap-item\" style=\"background: #533483;\">3<span class=\"num-label\">stop</span></div>"
child_elements: "<div class=\"snap-item\" style=\"background: #2b6e4e;\">4<span class=\"num-label\">stop</span></div>"
child_elements: "<div class=\"snap-item\" style=\"background: #8b5e3c;\">5<span class=\"num-label\">stop</span></div>"
child_elements: "<div class=\"snap-item\" style=\"background: #6b2d5b;\">6<span class=\"num-label\">stop</span></div>"
wrapper_style: "background: #16213e; border-radius: 12px; padding: 24px; flex: 1; min-width: 360px; max-width: 560px;"
extra_css: ".snap-item { min-width: 180px; height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; color: #fff; flex-shrink: 0; scroll-snap-align: start; position: relative; }\n.snap-item .num-label { font-size: 11px; font-weight: 400; opacity: 0.7; margin-top: 4px; }"
screenshot_textproto: "scroll"
