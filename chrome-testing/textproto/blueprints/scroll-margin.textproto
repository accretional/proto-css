demo_type: SCROLL
title: "Scroll Margin"
target_base_style: "width: 100%; height: 240px; overflow-x: auto; overflow-y: hidden; border: 2px solid #333; border-radius: 10px; background: #16213e; scroll-snap-type: x mandatory; display: flex; position: relative;"
child_elements: "<div class=\"snap-item\">1</div>"
child_elements: "<div class=\"snap-item\">2</div>"
child_elements: "<div class=\"snap-item\">3</div>"
child_elements: "<div class=\"snap-item\">4</div>"
extra_css: ".snap-item { min-width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; scroll-snap-align: start; flex-shrink: 0; }\n.snap-item:nth-child(1) { background: linear-gradient(135deg, #6366f1, #8b5cf6); }\n.snap-item:nth-child(2) { background: linear-gradient(135deg, #ec4899, #f43f5e); }\n.snap-item:nth-child(3) { background: linear-gradient(135deg, #14b8a6, #06b6d4); }\n.snap-item:nth-child(4) { background: linear-gradient(135deg, #f59e0b, #ef4444); }"
screenshot_textproto: "scroll"
