demo_type: FLEX
title: "Box Align (deprecated)"
target_base_style: "display: -webkit-box; -webkit-box-orient: horizontal; width: 200px; height: 150px; background: #16213e; border: 2px solid #333;"
child_elements: "<div class=\"child short\">A</div>"
child_elements: "<div class=\"child medium\">B</div>"
child_elements: "<div class=\"child tall\">C</div>"
extra_css: ".child { width: 50px; background: #e94560; margin: 4px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; }\n.child.short { height: 40px; }\n.child.medium { height: 60px; }\n.child.tall { height: 80px; }"
