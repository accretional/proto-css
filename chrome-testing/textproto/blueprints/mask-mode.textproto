demo_type: BOX
title: "Mask Mode"
target_base_style: "flex: 1; height: 80px; background: linear-gradient(135deg, #e94560, #a855f7, #00d2ff); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 12px; -webkit-mask-image: linear-gradient(to bottom, black, transparent); mask-image: linear-gradient(to bottom, black, transparent);"
target_inner_html: "Content"
wrapper_style: "display: flex; gap: 12px; align-items: flex-start;"
siblings_before: "<div><div class=\"mask-source\"></div><p class=\"section-label\">Mask</p></div>"
extra_css: ".mask-source { width: 90px; height: 80px; border-radius: 6px; border: 1px solid #4a5568; flex-shrink: 0; background: linear-gradient(to right, black, transparent); }\n.section-label { font-size: 9px; color: #6b7280; text-align: center; margin-top: 3px; }"
