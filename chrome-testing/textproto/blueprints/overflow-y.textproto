extra_css: ".tall-content { display: flex; flex-direction: column; gap: 8px; }\n.block { width: 100%; height: 50px; border-radius: 6px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; color: #fff; }\n.b1 { background: #e94560; }\n.b2 { background: #0077ff; }\n.b3 { background: #00cc66; }\n.b4 { background: #f5a623; }\n.b5 { background: #7b68ee; }"
