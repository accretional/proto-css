  primary_rules: "transition-delay"
  primary_rules: "animation-duration"
  primary_rules: "animation-delay"
}

types {
  type_name: "NonNegativeTimeType"
  values: "0s"
  values: "0.3s"
  values: "1s"
  values: "2s"
}

