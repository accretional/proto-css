types {
  type_name: "MaskReferenceType"
  values: "none"
  values: "url(mask.png)"
}

types {
  type_name: "GeometryBoxType"
  values: "content-box"
  values: "padding-box"
  values: "border-box"
  values: "margin-box"
  values: "fill-box"
  values: "stroke-box"
  values: "view-box"
}

types {
  type_name: "CompositingOperatorType"
  values: "add"
  values: "subtract"
  values: "intersect"
  values: "exclude"
}

types {
  type_name: "MaskingModeType"
