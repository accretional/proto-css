# Representative values for open-ended / recursive CSS grammar types.
# Each entry short-circuits exhaustive enumeration with hand-picked samples,
# unless the property being generated is listed in primary_rules (in which
# case the grammar is expanded fully).
#
# ORDERING MATTERS: the exhaustive enumerator picks the first value in each
# position first, so lead with the most visually distinct value (never 0).

# --- Lengths ---

types {
  type_name: "LengthType"
  values: "10px"
  values: "20px"
  values: "50px"
  values: "4px"
  values: "2em"
  values: "0"
}

types {
  type_name: "NonNegativeLengthType"
  values: "10px"
  values: "20px"
  values: "50px"
  values: "4px"
  values: "0"
}

types {
  type_name: "LengthPercentageType"
  values: "10px"
  values: "25%"
  values: "50%"
  values: "100%"
  values: "0"
}

types {
  type_name: "NonNegativeLengthPercentageType"
  values: "10px"
  values: "25%"
  values: "50%"
  values: "0"
}

# --- Percentages ---

types {
  type_name: "PercentageType"
  values: "25%"
  values: "50%"
  values: "75%"
  values: "100%"
  values: "0%"
}

types {
  type_name: "NonNegativePercentageType"
  values: "25%"
  values: "50%"
  values: "100%"
  values: "0%"
}

