  values: "0"
  values: "0.5"
  values: "1"
  values: "2"
  primary_rules: "opacity"
  primary_rules: "font-size-adjust"
}

types {
  type_name: "NonNegativeNumberType"
  values: "0"
  values: "0.5"
  values: "1"
  values: "2"
}

types {
  type_name: "IntegerType"
  values: "0"
  values: "1"
  values: "2"
  values: "5"
  primary_rules: "z-index"
  primary_rules: "order"
  primary_rules: "orphans"
  primary_rules: "widows"
}

types {
  type_name: "NonNegativeIntegerType"
  values: "0"
  values: "1"
  values: "2"
  values: "5"
}

types {
  type_name: "PositiveIntegerType"
  values: "1"
  values: "2"
  values: "3"
}

# --- Colors ---

types {
  type_name: "ColorType"
  values: "red"
  values: "#3498db"
  values: "rgb(0, 128, 0)"
  values: "transparent"
  values: "currentcolor"
  primary_rules: "color"
  primary_rules: "background-color"
  primary_rules: "border-color"
  primary_rules: "border-top-color"
  primary_rules: "border-right-color"
  primary_rules: "border-bottom-color"
  primary_rules: "border-left-color"
  primary_rules: "border-block-color"
  primary_rules: "border-block-start-color"
  primary_rules: "border-block-end-color"
  primary_rules: "border-inline-color"
  primary_rules: "border-inline-start-color"
  primary_rules: "border-inline-end-color"
  primary_rules: "outline-color"
  primary_rules: "text-decoration-color"
  primary_rules: "text-emphasis-color"
  primary_rules: "accent-color"
  primary_rules: "caret-color"
  primary_rules: "column-rule-color"
  primary_rules: "flood-color"
  primary_rules: "lighting-color"
  primary_rules: "stop-color"
  primary_rules: "fill"
  primary_rules: "stroke"
}

types {
  type_name: "ColorBaseType"
  values: "red"
