# --- URLs ---

types {
  type_name: "UrlType"
  values: "url(example.png)"
}

# --- Strings ---

types {
  type_name: "string_type"
  values: "\"example\""
}

# --- Identifiers ---

types {
  type_name: "ident_type"
  values: "my-ident"
}

types {
  type_name: "custom_ident_type"
  values: "my-custom"
}

types {
  type_name: "dashed_ident_type"
  values: "--my-var"
}

types {
  type_name: "KeyframesNameType"
  values: "my-animation"
}

types {
  type_name: "AnchorNameType"
  values: "--my-anchor"
}

# --- Functions (complex/recursive) ---

types {
  type_name: "CalcFn"
  values: "calc(50% - 10px)"
}

types {
  type_name: "MathFunctionType"
  values: "calc(50% + 20px)"
}

types {
  type_name: "FilterValueListType"
  values: "blur(4px)"
  values: "grayscale(50%)"
  values: "brightness(1.5)"
  primary_rules: "filter"
  primary_rules: "backdrop-filter"
}

types {
  type_name: "FilterFunctionType"
  values: "blur(4px)"
  values: "grayscale(50%)"
}

types {
  type_name: "TransformFunctionType"
  values: "rotate(45deg)"
  values: "scale(1.5)"
  values: "translateX(10px)"
  primary_rules: "transform"
}

types {
  type_name: "TransformListType"
  values: "rotate(45deg)"
  values: "scale(2) translateX(10px)"
}

