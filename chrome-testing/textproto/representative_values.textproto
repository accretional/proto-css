  primary_rules: "font-size-adjust"
}

types {
  type_name: "NonNegativeNumberType"
  values: "1"
  values: "0.5"
  values: "2"
  values: "0"
}

types {
  type_name: "IntegerType"
  values: "1"
  values: "2"
  values: "5"
  values: "0"
  primary_rules: "order"
  primary_rules: "orphans"
  primary_rules: "widows"
}

types {
  type_name: "NonNegativeIntegerType"
  values: "1"
  values: "2"
  values: "5"
  values: "0"
}

types {
  type_name: "PositiveIntegerType"
  values: "1"
  values: "2"
  values: "3"
}

types {
  type_name: "positive_integer_type"
  values: "1"
  values: "2"
  values: "3"
}

