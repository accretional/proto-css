}

# --- Functions (complex/recursive) ---

types {
  type_name: "CalcFn"
  values: "calc(50% - 10px)"
}

types {
  type_name: "MathFunctionType"
  values: "calc(50% + 20px)"
}

types {
  type_name: "FilterValueListType"
  values: "blur(4px)"
  values: "grayscale(50%)"
  values: "brightness(1.5)"
  primary_rules: "filter"
  primary_rules: "backdrop-filter"
}

types {
  type_name: "FilterFunctionType"
  values: "blur(4px)"
  values: "grayscale(50%)"
}

types {
  type_name: "TransformFunctionType"
  values: "rotate(45deg)"
  values: "scale(1.5)"
  values: "translateX(10px)"
  primary_rules: "transform"
}

types {
  type_name: "TransformListType"
  values: "rotate(45deg)"
  values: "scale(2) translateX(10px)"
}

# --- Easing ---

types {
  type_name: "EasingFunctionType"
  values: "ease"
  values: "linear"
  values: "ease-in"
  values: "ease-out"
  values: "ease-in-out"
  primary_rules: "transition-timing-function"
  primary_rules: "animation-timing-function"
}

types {
  type_name: "LinearEasingFunctionType"
  values: "linear"
}

types {
  type_name: "CubicBezierEasingFunctionType"
  values: "ease"
  values: "ease-in"
  values: "ease-out"
  values: "ease-in-out"
}

types {
  type_name: "StepEasingFunctionType"
  values: "step-start"
  values: "step-end"
}

# --- Box types ---

types {
  type_name: "ShapeBoxType"
  values: "content-box"
  values: "padding-box"
  values: "border-box"
  values: "margin-box"
}

# --- Position ---
# Removed primary_rules — full expansion produces "left, left top" etc.
# which are mostly identical. Representative values are more visually distinct.

types {
  type_name: "PositionType"
  values: "center"
  values: "top"
  values: "bottom"
  values: "left"
  values: "right"
  values: "50% 50%"
}

# --- Shadow ---
# Removed primary_rules — full expansion produces "0 0" zero-offset combos
# that are invisible. Representative values show actual visible shadows.

types {
  type_name: "ShadowType"
  values: "2px 2px 4px rgba(0,0,0,0.5)"
  values: "inset 0 0 10px red"
  values: "4px 4px 8px #3498db"
  values: "0 8px 16px rgba(233,69,96,0.6)"
}

# --- Sizing ---

types {
  type_name: "BgSizeType"
  values: "auto"
  values: "cover"
  values: "contain"
  values: "50% 50%"
  values: "200px 100px"
  values: "100% auto"
}

# --- Generic family ---

types {
  type_name: "GenericFamilyType"
  values: "serif"
  values: "sans-serif"
  values: "monospace"
  values: "cursive"
  values: "system-ui"
  primary_rules: "font-family"
}

# --- Animation sub-types ---

types {
  type_name: "SingleAnimationType"
  values: "fadeIn 1s ease"
  values: "slideIn 0.5s linear forwards"
}

types {
  type_name: "SingleAnimationTimelineType"
  values: "auto"
  values: "scroll()"
  values: "view()"
  primary_rules: "animation-timeline"
}

# --- Grid types ---
# Removed primary_rules — full expansion produces "0 0 [ ]" combos
# that collapse to zero-width columns. Representative values are better.

types {
  type_name: "TrackListType"
  values: "1fr 1fr"
  values: "100px 1fr 2fr"
  values: "repeat(3, 1fr)"
}

types {
  type_name: "GridLineType"
  values: "1"
  values: "span 2"
  values: "auto"
}

# --- Shorthand types ---

types {
  type_name: "BgLayerType"
  values: "linear-gradient(red, blue) center / cover no-repeat"
  values: "radial-gradient(circle, #e94560, #3498db) center / contain no-repeat"
}

types {
  type_name: "FinalBgLayerType"
  values: "#333 linear-gradient(45deg, red, blue) center / cover no-repeat"
  values: "#0f3460 radial-gradient(circle, #e94560, #3498db) center / contain no-repeat"
}

# --- SVG stroke-dasharray ---

types {
  type_name: "StrokeDasharrayPropItem"
  values: "10"
  values: "5"
  values: "20"
  values: "2"
}

types {
  type_name: "StrokeDasharrayProp"
  values: "none"
  values: "10 5"
  values: "20 10 5"
  values: "5"
  values: "15 5 3 5"
  values: "30 10"
}

# --- Border ---
# Removed primary_rules — full expansion produces "0 / 0 X" combos
# that all look like sharp corners. Representative values show actual rounding.

types {
  type_name: "BorderRadiusType"
  values: "4px"
  values: "10px"
  values: "50%"
  values: "0"
}

types {
  type_name: "Image1dType"
  values: "red"
  values: "linear-gradient(red, blue)"
}

