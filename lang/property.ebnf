(* print-color-adjust *)
PrintColorAdjustProp = "economy" | "exact" ;

(* quotes *)
QuotesProp = "auto" | "none" | "match-parent" | QuotesPropItem , { QuotesPropItem } ;
QuotesPropItem = string_type , string_type ;

(* r *)
RProp = LengthPercentageType ;

(* resize *)
ResizeProp = "none" | "both" | "horizontal" | "vertical" | "block" | "inline" ;

(* right *)
RightProp = "auto" | LengthPercentageType | AnchorFn | AnchorSizeFn ;

(* rotate *)
(* rotate = none | <angle> | [ x | y | z | <number>{3} ] && <angle> (docs).
   The number axis needs exactly THREE numbers (grouped); attr() is not a rotate
   value. *)
(* rotate = none | <angle> | [ x | y | z | <number>{3} ] && <angle>. The
   <number>{3} axis vector is a dedicated rule carrying a multi-token rep (a whole
   "1 1 1" triple, in reps.go): three identical adjacent <number> leaves otherwise
   collapse to one repeated proto field and emit a single number ("1 45deg"). *)
RotateAxisVectorType = number_type ;
(* clip's legacy rect( top, right, bottom, left ): four adjacent <length-percentage>
   leaves collapse to one repeated field (rect(8px,8px,8px,8px) — a degenerate, empty
   clip). Supply the whole comma-separated tuple as ONE multi-token rep so right>left
   and bottom>top form a real visible clip window (rep in cmd/gen/reps.go). *)
ClipRectEdgesType = length_percentage_type ;
RotateProp = "none" | AngleType | ( ( "x" | "y" | "z" | RotateAxisVectorType ) , AngleType ) ;

(* row-gap *)
RowGapProp = "normal" | NonNegativeLengthPercentageType | LineWidthType ;

(* ruby-align *)
RubyAlignProp = "start" | "center" | "space-between" | "space-around" ;

(* ruby-overhang *)
RubyOverhangProp = "auto" | "spaces" ;

(* ruby-position *)
