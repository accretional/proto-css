(* min-block-size *)
MinBlockSizeProp = MinWidthProp ;

(* min-height *)
MinHeightProp = "auto" | NonNegativeLengthPercentageType | "min-content" | "max-content" | FitContentFn | CalcSizeFn | AnchorSizeFn | "stretch" | "fit-content" | "contain" ;

(* min-inline-size *)
MinInlineSizeProp = MinWidthProp ;

