PaddingProp = PaddingTopProp , [ PaddingTopProp ] , [ PaddingTopProp ] , [ PaddingTopProp ] ;

(* page-break-after *)
PageBreakAfterProp = "auto" | "always" | "avoid" | "left" | "right" | "inherit" ;

(* page-break-before *)
PageBreakBeforeProp = "auto" | "always" | "avoid" | "left" | "right" | "inherit" ;

(* page-break-inside *)
PageBreakInsideProp = "avoid" | "auto" | "inherit" ;

