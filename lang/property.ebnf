(* transition-duration *)
TransitionDurationExpr = "transition-duration" , ":" , ( TransitionDurationProp | AllProp ) , [ "!" , "important" ] ;

(* transition-Property *)
TransitionPropertyExpr = "transition-property" , ":" , ( TransitionPropertyProp | AllProp ) , [ "!" , "important" ] ;

(* transition-timing-function *)
TransitionTimingFunctionExpr = "transition-timing-function" , ":" , ( TransitionTimingFunctionProp | AllProp ) , [ "!" , "important" ] ;

(* transition *)
TransitionExpr = "transition" , ":" , ( TransitionProp | AllProp ) , [ "!" , "important" ] ;

(* translate *)
TranslateExpr = "translate" , ":" , ( TranslateProp | AllProp ) , [ "!" , "important" ] ;

(* unicode-bidi *)
UnicodeBidiExpr = "unicode-bidi" , ":" , ( UnicodeBidiProp | AllProp ) , [ "!" , "important" ] ;

(* user-modify *)
UserModifyExpr = "user-modify" , ":" , ( UserModifyProp | AllProp ) , [ "!" , "important" ] ;

(* user-select *)
UserSelectExpr = "user-select" , ":" , ( UserSelectProp | AllProp ) , [ "!" , "important" ] ;

(* vector-effect *)
VectorEffectExpr = "vector-effect" , ":" , ( VectorEffectProp | AllProp ) , [ "!" , "important" ] ;

(* vertical-align *)
VerticalAlignExpr = "vertical-align" , ":" , ( VerticalAlignProp | AllProp ) , [ "!" , "important" ] ;

(* view-timeline-axis *)
ViewTimelineAxisExpr = "view-timeline-axis" , ":" , ( ViewTimelineAxisProp | AllProp ) , [ "!" , "important" ] ;

(* view-timeline-inset *)
ViewTimelineInsetExpr = "view-timeline-inset" , ":" , ( ViewTimelineInsetProp | AllProp ) , [ "!" , "important" ] ;

(* view-timeline-name *)
ViewTimelineNameExpr = "view-timeline-name" , ":" , ( ViewTimelineNameProp | AllProp ) , [ "!" , "important" ] ;

(* view-timeline *)
ViewTimelineExpr = "view-timeline" , ":" , ( ViewTimelineProp | AllProp ) , [ "!" , "important" ] ;

(* view-transition-class *)
ViewTransitionClassExpr = "view-transition-class" , ":" , ( ViewTransitionClassProp | AllProp ) , [ "!" , "important" ] ;

(* view-transition-name *)
ViewTransitionNameExpr = "view-transition-name" , ":" , ( ViewTransitionNameProp | AllProp ) , [ "!" , "important" ] ;

(* visibility *)
VisibilityExpr = "visibility" , ":" , ( VisibilityProp | AllProp ) , [ "!" , "important" ] ;

(* white-space-collapse *)
WhiteSpaceCollapseExpr = "white-space-collapse" , ":" , ( WhiteSpaceCollapseProp | AllProp ) , [ "!" , "important" ] ;

(* white-space *)
WhiteSpaceExpr = "white-space" , ":" , ( WhiteSpaceProp | AllProp ) , [ "!" , "important" ] ;

(* widows *)
WidowsExpr = "widows" , ":" , ( WidowsProp | AllProp ) , [ "!" , "important" ] ;

(* width *)
WidthExpr = "width" , ":" , ( WidthProp | AllProp ) , [ "!" , "important" ] ;

(* will-change *)
WillChangeExpr = "will-change" , ":" , ( WillChangeProp | AllProp ) , [ "!" , "important" ] ;

(* word-break *)
WordBreakExpr = "word-break" , ":" , ( WordBreakProp | AllProp ) , [ "!" , "important" ] ;

(* word-spacing *)
WordSpacingExpr = "word-spacing" , ":" , ( WordSpacingProp | AllProp ) , [ "!" , "important" ] ;

(* writing-mode *)
WritingModeExpr = "writing-mode" , ":" , ( WritingModeProp | AllProp ) , [ "!" , "important" ] ;

(* x *)
XExpr = "x" , ":" , ( XProp | AllProp ) , [ "!" , "important" ] ;

(* y *)
YExpr = "y" , ":" , ( YProp | AllProp ) , [ "!" , "important" ] ;

(* z-index *)
ZIndexExpr = "z-index" , ":" , ( ZIndexProp | AllProp ) , [ "!" , "important" ] ;

(* zoom *)
ZoomExpr = "zoom" , ":" , ( ZoomProp | AllProp ) , [ "!" , "important" ] ;

(* ── Property-specific sub-types ──────────────────────────────────────── *)

(* <baseline-metric> *)
BaselineMetricType = "text-bottom" | "alphabetic" | "ideographic" | "middle" | "central" | "mathematical" | "hanging" | "text-top" ;

(* <anchor-name> *)
AnchorNameType = dashed_ident_type ;

(* <single-animation-composition> *)
SingleAnimationCompositionType = "replace" | "add" | "accumulate" ;

(* <single-animation-direction> *)
SingleAnimationDirectionType = "normal" | "reverse" | "alternate" | "alternate-reverse" ;

(* <single-animation-fill-mode> *)
SingleAnimationFillModeType = "none" | "forwards" | "backwards" | "both" ;

(* <single-animation-iteration-count> *)
SingleAnimationIterationCountType = "infinite" | NonNegativeNumberType ;

(* <keyframes-name> *)
KeyframesNameType = custom_ident_type | string_type ;

(* <single-animation-play-state> *)
SingleAnimationPlayStateType = "running" | "paused" ;

(* <animation-range-start> *)
AnimationRangeStartType = AnimationRangeStartTypeItem , { "," , AnimationRangeStartTypeItem } ;
AnimationRangeStartTypeItem = ( "normal" | LengthPercentageType | TimelineRangeNameType , [ LengthPercentageType ] ) ;

(* <animation-range-end> *)
AnimationRangeEndType = AnimationRangeEndTypeItem , { "," , AnimationRangeEndTypeItem } ;
AnimationRangeEndTypeItem = ( "normal" | LengthPercentageType | TimelineRangeNameType , [ LengthPercentageType ] ) ;

(* <single-animation-timeline> *)
SingleAnimationTimelineType = "auto" | "none" | dashed_ident_type | ScrollFn | ViewFn ;

(* <single-animation>
   CSS allows animation shorthand components in any order.
   Dispatch via alternation so any order is accepted. *)
(* <single-animation> = <duration> || <easing-function> || <delay> ||
   <iteration-count> || <direction> || <fill-mode> || <play-state> || [none|<name>].
   The fully loose "any item, repeated" form explodes past the value cap and emits
   NOTHING, so encode the documented canonical order as explicit representative
   subrules (duration easing delay iteration direction fill-mode play-state name),
   pinning the wide leading bits per row so each combination shows. *)
SingleAnimationType =
    "none"
    | KeyframesNameType
    | TimeType , KeyframesNameType
    | TimeType , "ease-in-out" , KeyframesNameType
    | TimeType , "linear" , "infinite" , "alternate" , KeyframesNameType
    | TimeType , "ease" , TimeType , "2" , "alternate-reverse" , "both" , "paused" , KeyframesNameType
    | TimeType , "ease-in" , TimeType , "infinite" , "normal" , "forwards" , "running" , KeyframesNameType ;

(* <animation-duration> *)
AnimationDurationType = AnimationDurationTypeItem , { "," , AnimationDurationTypeItem } ;
AnimationDurationTypeItem = ( "auto" | TimeType ) ;

(* <animation-delay> *)
AnimationDelayType = TimeType , { "," , TimeType } ;

(* <compat-auto> *)
CompatAutoType = "searchfield" | "textarea" | "checkbox" | "radio" | "menulist" | "listbox" | "meter" | "progress-bar" | "button" ;

(* <compat-special> *)
CompatSpecialType = "textfield" | "menulist-button" ;

(* <filter-value-list> *)
FilterValueListType = FilterValueListTypeItem , { FilterValueListTypeItem } ;
FilterValueListTypeItem = ( FilterFunctionType | UrlType ) ;

(* <attachment> *)
AttachmentType = "scroll" | "fixed" | "local" ;

(* <mix-blend-mode> *)
MixBlendModeType = BlendModeType | "plus-darker" | "plus-lighter" ;

(* <bg-clip> *)
BgClipType = VisualBoxType | "border-area" , [ "text" ] | "text" , [ "border-area" ] ;

(* <bg-image> *)
BgImageType = ImageType | "none" ;

(* <bg-position> *)
BgPositionType = PositionType | PositionThreeType ;

(* <position-three> *)
PositionThreeType = ( "left" | "center" | "right" ) , ( "top" | "bottom" ) , LengthPercentageType | ( "left" | "right" ) , LengthPercentageType , ( "top" | "center" | "bottom" ) ;

(* <repeat-style> *)
RepeatStyleType = "repeat-x" | "repeat-y" | "repeat-block" | "repeat-inline" | RepetitionType , [ RepetitionType ] ;

(* <repetition> *)
RepetitionType = "repeat" | "space" | "round" | "no-repeat" ;

(* <bg-size> *)
BgSizeType = BgSizeTypeItem , [ BgSizeTypeItem ] | "cover" | "contain" ;
BgSizeTypeItem = ( NonNegativeLengthPercentageType | "auto" ) ;

(* <bg-layer> — components in any order per spec *)
BgLayerItem =
    BgImageType
    | ( BgPositionType , [ "/" , BgSizeType ] )
    | RepeatStyleType
    | AttachmentType
    | BgClipType
    | VisualBoxType
    ;
BgLayerType = { BgLayerItem } ;

(* <final-bg-layer> — like <bg-layer> plus optional color in any position *)
FinalBgLayerItem = BgLayerItem | ColorType ;
FinalBgLayerType = { FinalBgLayerItem } ;

(* <background-color> *)
BackgroundColorType = ColorType ;

(* <width> *)
WidthType = "auto" | NonNegativeLengthPercentageType | "min-content" | "max-content" | FitContentFn | CalcSizeFn | AnchorSizeFn | "stretch" | "fit-content" | "contain" ;

(* <anchor-size> *)
AnchorSizeType = "width" | "height" | "block" | "inline" | "self-block" | "self-inline" ;

(* <border-top-color> *)
BorderTopColorType = ColorType | Image1dType ;

(* <image-1D> *)
Image1dType = StripesFn ;

(* <stripes()> *)
StripesFn = "stripes" , "(" , ColorStripeType , { "," , ColorStripeType } , ")" ;

(* <color-stripe> *)
ColorStripeType = ColorType , [ ( LengthPercentageType | FlexType ) ] ;

(* <line-width> = <length> | thin | medium | thick. 'hairline' is not a CSS
   keyword (Chrome drops it), so it is removed. *)
LineWidthType = NonNegativeLengthType | "thin" | "medium" | "thick" ;

(* <border-top-style> *)
BorderTopStyleType = LineStyleType ;

(* <border-top-width> *)
BorderTopWidthType = LineWidthType ;

(* <border-block-start> *)
BorderBlockStartType = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* <slash-separated-border-radius-syntax> *)
SlashSeparatedBorderRadiusSyntaxType = LengthPercentageType , [ "/" , LengthPercentageType ] ;

(* <legacy-border-radius-syntax> *)
LegacyBorderRadiusSyntaxType = LengthPercentageType , [ LengthPercentageType ] ;

(* <border-image-source> *)
BorderImageSourceType = "none" | ImageType ;

(* <border-image-slice> *)
BorderImageSliceType = BorderImageSliceTypeItem , [ BorderImageSliceTypeItem ] , [ BorderImageSliceTypeItem ] , [ BorderImageSliceTypeItem ] , [ "fill" ] ;
BorderImageSliceTypeItem = ( NumberType | PercentageType ) ;

(* <border-image-width> *)
BorderImageWidthType = BorderImageWidthTypeItem , [ BorderImageWidthTypeItem ] , [ BorderImageWidthTypeItem ] , [ BorderImageWidthTypeItem ] ;
BorderImageWidthTypeItem = ( LengthPercentageType | NumberType | "auto" ) ;

(* <border-image-outset> *)
BorderImageOutsetType = BorderImageOutsetTypeItem , [ BorderImageOutsetTypeItem ] , [ BorderImageOutsetTypeItem ] , [ BorderImageOutsetTypeItem ] ;
BorderImageOutsetTypeItem = ( LengthType | NumberType ) ;

(* <border-image-repeat> *)
BorderImageRepeatType = BorderImageRepeatTypeItem , [ BorderImageRepeatTypeItem ] ;
BorderImageRepeatTypeItem = ( "stretch" | "repeat" | "round" | "space" ) ;

(* <spread-shadow> — [ <color>? && [ <length>{2,4} && inset? ] ] *)
(* box-shadow item: color? inset? offX offY blur? spread? — identical lengths collapse
   to "24px 24px 24px"; supply varied curated shadows as one rep (cmd/gen/reps.go). *)
SpreadShadowType = length_type ;

(* <box-shadow-color> *)
BoxShadowColorType = ColorType , { "," , ColorType } ;

(* <box-shadow-blur> *)
BoxShadowBlurType = LengthType , { "," , LengthType } ;

(* <box-shadow-spread> *)
BoxShadowSpreadType = LengthType , { "," , LengthType } ;

(* <box-shadow-position> *)
BoxShadowPositionType = BoxShadowPositionTypeItem , { "," , BoxShadowPositionTypeItem } ;
BoxShadowPositionTypeItem = ( "outset" | "inset" ) ;

(* <caret-color> *)
CaretColorType = "auto" | ColorType , [ ( "auto" | ColorType ) ] ;

(* <caret-animation> *)
CaretAnimationType = "auto" | "manual" ;

(* <caret-shape> *)
CaretShapeType = "auto" | "bar" | "block" | "underscore" ;

(* <clip-source> *)
ClipSourceType = UrlType ;

(* <basic-shape-rect> *)
BasicShapeRectType = InsetFn | RectFn | XywhFn ;

(* <line-color-list> *)
LineColorListType = LineColorOrRepeatType , { "," , LineColorOrRepeatType } ;

(* <auto-line-color-list> *)
AutoLineColorListType = [ LineColorOrRepeatType , { "," , LineColorOrRepeatType } ] , "," , AutoRepeatLineColorType , "," , [ LineColorOrRepeatType , { "," , LineColorOrRepeatType } ] ;

(* <line-color-or-repeat> *)
LineColorOrRepeatType = ColorType | RepeatLineColorType ;

(* <auto-repeat-line-color> *)
AutoRepeatLineColorType = RepeatFn ;
AutoRepeatLineColorTypeItem = ColorType ;

(* <repeat-line-color> *)
RepeatLineColorType = RepeatFn ;
RepeatLineColorTypeItem = ColorType ;

(* <line-style-list> *)
LineStyleListType = LineStyleOrRepeatType , { "," , LineStyleOrRepeatType } ;

(* <auto-line-style-list> *)
AutoLineStyleListType = [ LineStyleOrRepeatType , { "," , LineStyleOrRepeatType } ] , "," , AutoRepeatLineStyleType , "," , [ LineStyleOrRepeatType , { "," , LineStyleOrRepeatType } ] ;

(* <line-style-or-repeat> *)
LineStyleOrRepeatType = LineStyleType | RepeatLineStyleType ;

(* <auto-repeat-line-style> = repeat( auto, [ <line-style> ]# ) — repeats
   LINE-STYLES, not grid track sizes (RepeatFn put lengths like 48px here). *)
AutoRepeatLineStyleType = "repeat" , "(" , "auto" , "," , LineStyleType , { "," , LineStyleType } , ")" ;
AutoRepeatLineStyleTypeItem = LineStyleType ;

(* <repeat-line-style> = repeat( <integer [1,∞]>, [ <line-style> ]# ) *)
RepeatLineStyleType = "repeat" , "(" , positive_integer_type , "," , LineStyleType , { "," , LineStyleType } , ")" ;
RepeatLineStyleTypeItem = LineStyleType ;

(* <line-width-list> *)
LineWidthListType = LineWidthOrRepeatType , { "," , LineWidthOrRepeatType } ;

(* <auto-line-width-list> *)
AutoLineWidthListType = [ LineWidthOrRepeatType , { "," , LineWidthOrRepeatType } ] , "," , AutoRepeatLineWidthType , "," , [ LineWidthOrRepeatType , { "," , LineWidthOrRepeatType } ] ;

(* <line-width-or-repeat> *)
LineWidthOrRepeatType = LineWidthType | RepeatLineWidthType ;

(* <auto-repeat-line-width> *)
AutoRepeatLineWidthType = RepeatFn ;
AutoRepeatLineWidthTypeItem = LineWidthType ;

(* <repeat-line-width> *)
RepeatLineWidthType = RepeatFn ;
RepeatLineWidthTypeItem = LineWidthType ;

(* <gap-rule-list> *)
GapRuleListType = GapRuleOrRepeatType , { "," , GapRuleOrRepeatType } ;

(* <gap-auto-rule-list> *)
GapAutoRuleListType = [ GapRuleOrRepeatType , { "," , GapRuleOrRepeatType } ] , "," , GapAutoRepeatRuleType , "," , [ GapRuleOrRepeatType , { "," , GapRuleOrRepeatType } ] ;

(* <gap-rule-or-repeat> *)
GapRuleOrRepeatType = GapRuleType | GapRepeatRuleType ;

(* <gap-auto-repeat-rule> *)
GapAutoRepeatRuleType = RepeatFn ;

(* <gap-rule> — components in any order per spec *)
GapRuleType =
    LineWidthType , [ LineStyleType , [ ColorType ] | ColorType , [ LineStyleType ] ]
    | LineStyleType , [ LineWidthType , [ ColorType ] | ColorType , [ LineWidthType ] ]
    | ColorType , [ LineWidthType , [ LineStyleType ] | LineStyleType , [ LineWidthType ] ] ;

(* <gap-repeat-rule> *)
GapRepeatRuleType = RepeatFn ;

(* <column-width> *)
ColumnWidthType = "auto" | LengthType | "min-content" | "max-content" | FitContentFn ;

(* <column-count> *)
ColumnCountType = "auto" | IntegerType ;

(* <column-height> *)
ColumnHeightType = "auto" | LengthType ;

(* <container-name> *)
ContainerNameType = "none" | custom_ident_type , { custom_ident_type } ;

(* <container-type> *)
ContainerTypeType = "normal" | ( [ ( "size" | "inline-size" ) ] , [ "scroll-state" ] ) ;

(* <content-replacement> *)
ContentReplacementType = ImageType ;

(* <content-list> *)
ContentListType = ContentListTypeItem , { ContentListTypeItem } ;
ContentListTypeItem = ( string_type | ImageType | AttrFn | "contents" | QuoteType | LeaderFn | TargetType | StringFn | ContentFn | CounterType ) ;

(* <counter> *)
CounterType = CounterFn | CountersFn ;

(* <quote> *)
QuoteType = "open-quote" | "close-quote" | "no-open-quote" | "no-close-quote" ;

(* <leader()> *)
LeaderFn = "leader" , "(" , LeaderTypeType , ")" ;

(* <target> *)
TargetType = TargetCounterFn | TargetCountersFn | TargetTextFn ;

(* <string()> *)
StringFn = "string" , "(" , custom_ident_type , "," , [ ( "first" | "start" | "last" | "first-except" ) ] , ")" ;

(* <content()> *)
ContentFn = "content" , "(" , [ ( "text" | "before" | "after" | "first-letter" | "marker" ) ] , ")" ;

(* <leader-type> *)
LeaderTypeType = "dotted" | "solid" | "space" | string_type ;

(* <target-counter()> *)
TargetCounterFn = "target-counter" , "(" , ( string_type | UrlType ) , "," , custom_ident_type , "," , [ CounterStyleType ] , ")" ;

(* <target-counters()> *)
TargetCountersFn = "target-counters" , "(" , ( string_type | UrlType ) , "," , custom_ident_type , "," , string_type , "," , [ CounterStyleType ] , ")" ;

(* <target-text()> *)
TargetTextFn = "target-text" , "(" , ( string_type | UrlType ) , "," , [ ( "content" | "before" | "after" | "first-letter" ) ] , ")" ;

(* <counter-name> *)
CounterNameType = custom_ident_type ;

(* <syntax> *)
SyntaxType = (* skip: * *) | SyntaxComponentType , { SyntaxCombinatorType , SyntaxComponentType } | SyntaxStringType ;

(* <attr-unit> *)
AttrUnitType = custom_ident_type ;

(* <counter-style-name> *)
CounterStyleNameType = custom_ident_type ;

(* <syntax-component> *)
SyntaxComponentType = SyntaxSingleComponentType , [ SyntaxMultiplierType ] | "transform-list" ;

(* <syntax-Combinator> *)
SyntaxCombinatorType = (* empty *) | (* empty *) ;

(* <syntax-string> *)
SyntaxStringType = string_type ;

(* <symbols-type> *)
SymbolsTypeType = "cyclic" | "numeric" | "alphabetic" | "symbolic" | "fixed" ;

(* <syntax-single-component> *)
SyntaxSingleComponentType = SyntaxTypeNameType | ident_type ;

(* <syntax-multiplier> *)
SyntaxMultiplierType = (* skip: # *) | (* skip: + *) ;

(* <syntax-type-name> *)
SyntaxTypeNameType = "angle" | "color" | "custom-ident" | "image" | "integer" | "length" | "length-percentage" | "number" | "percentage" | "resolution" | "string" | "time" | "url" | "transform-function" ;

(* <corner-top-left-shape> *)
CornerTopLeftShapeType = CornerShapeValueType ;

(* <reversed-counter-name> *)
ReversedCounterNameType = "reversed" , "(" , CounterNameType , ")" ;

(* <cursor-image> *)
CursorImageType = ( UrlType | UrlSetType ) , NumberType , NumberType , (* skip: ? *) ;

(* <cursor-predefined> *)
CursorPredefinedType = "auto" | "default" | "none" | "context-menu" | "help" | "pointer" | "progress" | "wait" | "cell" | "crosshair" | "text" | "vertical-text" | "alias" | "copy" | "move" | "no-drop" | "not-allowed" | "grab" | "grabbing" | "e-resize" | "n-resize" | "ne-resize" | "nw-resize" | "s-resize" | "se-resize" | "sw-resize" | "w-resize" | "ew-resize" | "ns-resize" | "nesw-resize" | "nwse-resize" | "col-resize" | "row-resize" | "all-scroll" | "zoom-in" | "zoom-out" ;

(* <opacity> *)
OpacityType = OpacityValueType ;

(* <opacity-value> *)
OpacityValueType = NonNegativeNumberType | PercentageType ;

(* <paint> *)
PaintType = "none" | ColorType | SvgPaintType ;

(* <svg-paint> *)
SvgPaintType = "child" , [ "(" , IntegerType , ")" ] ;

(* <flex-direction> *)
FlexDirectionType = "row" | "row-reverse" | "column" | "column-reverse" ;

(* <flex-wrap> *)
FlexWrapType = "nowrap" | "wrap" | "wrap-reverse" ;

(* <flex-grow> *)
FlexGrowType = NumberType ;

(* <flex-shrink> *)
FlexShrinkType = NumberType ;

(* <flex-basis> *)
FlexBasisType = "content" | "width" ;

(* <snap-block()> *)
SnapBlockFn = "snap-block" , "(" , LengthType , [ "," , ( "start" | "end" | "near" ) ] , ")" ;

(* <snap-inline()> *)
SnapInlineFn = "snap-inline" , "(" , LengthType , [ "," , ( "left" | "right" | "near" ) ] , ")" ;

(* <font-family-name> *)
FontFamilyNameType = string_type | custom_ident_type , { custom_ident_type } ;

(* <generic-font-family> *)
GenericFontFamilyType = GenericFontScriptSpecificType | GenericFontCompleteType | GenericFontIncompleteType ;

(* <generic-font-script-specific> *)
GenericFontScriptSpecificType = "generic" , "(" , ( "fangsong" | "kai" | "khmer-mul" | "nastaliq" ) , ")" ;

(* <generic-font-complete> *)
GenericFontCompleteType = "serif" | "sans-serif" | "system-ui" | "cursive" | "fantasy" | "math" | "monospace" ;

(* <generic-font-incomplete> *)
GenericFontIncompleteType = "ui-serif" | "ui-sans-serif" | "ui-monospace" | "ui-rounded" ;

(* <feature-tag-value> *)
FeatureTagValueType = FeatureTagType , [ ( IntegerType | "on" | "off" ) ] ;

(* <opentype-tag> — split into feature vs axis tags so each gets a real,
   context-valid sample (a feature tag like "liga" is not a valid variation
   axis, and vice-versa). Both are still just <string> leaves. *)
OpentypeTagType = string_type ;
FeatureTagType = string_type ;
AxisTagType = string_type ;

(* a variation-axis value is a <number>, but its meaningful range is axis-specific
   and far above the generic <number> rep, so it gets its own leaf (see reps.go). *)
AxisValueType = number_type ;

(* <palette-identifier> *)
PaletteIdentifierType = dashed_ident_type ;

(* <font-feature-value-name> *)
FontFeatureValueNameType = ident_type ;

(* <east-asian-variant-values> *)
EastAsianVariantValuesType = "jis78" | "jis83" | "jis90" | "jis04" | "simplified" | "traditional" ;

(* <east-asian-width-values> *)
EastAsianWidthValuesType = "full-width" | "proportional-width" ;

(* <common-lig-values> *)
CommonLigValuesType = "common-ligatures" | "no-common-ligatures" ;

(* <discretionary-lig-values> *)
DiscretionaryLigValuesType = "discretionary-ligatures" | "no-discretionary-ligatures" ;

(* <historical-lig-values> *)
HistoricalLigValuesType = "historical-ligatures" | "no-historical-ligatures" ;

(* <contextual-alt-values> *)
ContextualAltValuesType = "contextual" | "no-contextual" ;

(* <numeric-figure-values> *)
NumericFigureValuesType = "lining-nums" | "oldstyle-nums" ;

(* <numeric-spacing-values> *)
NumericSpacingValuesType = "proportional-nums" | "tabular-nums" ;

(* <numeric-fraction-values> *)
NumericFractionValuesType = "diagonal-fractions" | "stacked-fractions" ;

(* <font-weight-absolute> *)
FontWeightAbsoluteType = "normal" | "bold" | FontWeightNumberType ;

(* <font-style> *)
FontStyleType = "normal" | "italic" | "left" | "right" | "oblique" , [ ObliqueAngleType ] ;

(* <font-variant-css2> *)
FontVariantCss2Type = "normal" | "small-caps" ;

(* <font-weight> *)
FontWeightType = FontWeightAbsoluteType | "bolder" | "lighter" ;

(* <font-width-css3> *)
FontWidthCss3Type = "normal" | "ultra-condensed" | "extra-condensed" | "condensed" | "semi-condensed" | "semi-expanded" | "expanded" | "extra-expanded" | "ultra-expanded" ;

(* <font-size> *)
FontSizeType = AbsoluteSizeType | RelativeSizeType | LengthPercentageType | "math" ;

(* <line-height> *)
LineHeightType = "normal" | NumberType | LengthPercentageType ;

(* <font-family> *)
FontFamilyType = FontFamilyTypeItem , { "," , FontFamilyTypeItem } ;
FontFamilyTypeItem = ( FontFamilyNameType | GenericFontFamilyType ) ;

(* <system-font-family-name> *)
SystemFontFamilyNameType = "caption" | "icon" | "menu" | "message-box" | "small-caption" | "status-bar" ;

(* <row-gap> *)
RowGapType = "normal" | LengthPercentageType | LineWidthType ;

(* <column-gap> *)
ColumnGapType = "normal" | LengthPercentageType | LineWidthType ;

(* <grid-line> *)
GridLineType = "auto" | custom_ident_type | ( ( positive_integer_type | negative_integer_type ) , [ custom_ident_type ] ) | ( "span" , ( [ positive_integer_type ] , [ custom_ident_type ] ) ) ;

(* <track-list> *)
TrackListType = TrackListTypeItem , { TrackListTypeItem } , [ LineNamesType ] ;
TrackListTypeItem = [ LineNamesType ] , ( TrackSizeType | TrackRepeatType ) ;

(* <auto-track-list> *)
AutoTrackListType = { [ LineNamesType ] , ( FixedSizeType | FixedRepeatType ) } , [ LineNamesType ] , AutoRepeatType , { [ LineNamesType ] , ( FixedSizeType | FixedRepeatType ) } , [ LineNamesType ] ;

(* <line-name-list> *)
LineNameListType = LineNameListTypeItem , { LineNameListTypeItem } ;
LineNameListTypeItem = ( LineNamesType | NameRepeatType ) ;

(* <track-repeat> *)
TrackRepeatType = RepeatFn ;
TrackRepeatTypeItem = [ LineNamesType ] , TrackSizeType ;

(* <fixed-size> *)
FixedSizeType = FixedBreadthType | MinmaxFn ;

(* <fixed-repeat> *)
FixedRepeatType = RepeatFn ;
FixedRepeatTypeItem = [ LineNamesType ] , FixedSizeType ;

(* <auto-repeat> *)
AutoRepeatType = RepeatFn ;
AutoRepeatTypeItem = [ LineNamesType ] , TrackSizeType ;

(* <name-repeat> *)
NameRepeatType = NameRepeatFn ;

(* <grid-template-rows> *)
GridTemplateRowsType = "none" | TrackListType | AutoTrackListType | "subgrid" , [ LineNameListType ] ;

(* <grid-template-columns> *)
GridTemplateColumnsType = "none" | TrackListType | AutoTrackListType | "subgrid" , [ LineNameListType ] ;

(* <explicit-track-list> *)
ExplicitTrackListType = ExplicitTrackListTypeItem , { ExplicitTrackListTypeItem } , [ LineNamesType ] ;
ExplicitTrackListTypeItem = [ LineNamesType ] , TrackSizeType ;

(* <grid-template> *)
GridTemplateType = "none" | "grid-template-rows" , "/" , "grid-template-columns" | GridTemplateTypeItem , { GridTemplateTypeItem } , [ "/" , ExplicitTrackListType ] ;
GridTemplateTypeItem = [ LineNamesType ] , string_type , [ TrackSizeType ] , [ LineNamesType ] ;

(* <grid-auto-columns> *)
GridAutoColumnsType = TrackSizeType , { TrackSizeType } ;

(* <grid-auto-rows> *)
GridAutoRowsType = TrackSizeType , { TrackSizeType } ;

(* <top> *)
TopType = "auto" | LengthPercentageType | AnchorFn | AnchorSizeFn ;

(* <interest-delay-start> *)
InterestDelayStartType = "normal" | TimeType ;

(* <isolation-mode> *)
IsolationModeType = "auto" | "isolate" ;

(* <block-ellipsis> *)
BlockEllipsisType = "no-ellipsis" | "auto" | string_type ;

(* <list-style-position> *)
ListStylePositionType = "inside" | "outside" ;

(* <list-style-image> *)
ListStyleImageType = ImageType | "none" ;

(* <list-style-type> *)
ListStyleTypeType = CounterStyleType | string_type | "none" ;

(* <margin-top> *)
MarginTopType = LengthPercentageType | "auto" | AnchorSizeFn ;

(* <marker-ref> *)
MarkerRefType = UrlType ;

(* <mask-border-source> *)
MaskBorderSourceType = "border-image-source" ;

(* <mask-border-slice> *)
MaskBorderSliceType = "border-image-slice" ;

(* <mask-border-width> *)
MaskBorderWidthType = "border-image-width" ;

(* <mask-border-outset> *)
MaskBorderOutsetType = "border-image-outset" ;

(* <mask-border-repeat> *)
MaskBorderRepeatType = "border-image-repeat" ;

(* <mask-border-mode> *)
MaskBorderModeType = "luminance" | "alpha" ;

(* <compositing-operator> *)
CompositingOperatorType = "add" | "subtract" | "intersect" | "exclude" ;

(* <mask-reference> *)
MaskReferenceType = ImageType | MaskSourceType | "none" ;

(* <mask-source> — its own url leaf (MaskUrlType) so the rep points at a real
   alpha cut-out source (a shape on transparent ground) instead of the opaque
   photo every other url leaf uses; an opaque source is a no-op full reveal. *)
MaskSourceType = MaskUrlType ;
MaskUrlType = "url" , "(" , [ string_type ] , ")" ;

(* <masking-mode> *)
MaskingModeType = "alpha" | "luminance" | "match-source" ;

(* <mask-layer> *)
MaskLayerType = [ MaskReferenceType ] , [ PositionType , [ "/" , BgSizeType ] ] , [ RepeatStyleType ] , [ GeometryBoxType ] , [ ( GeometryBoxType | "no-clip" ) ] , [ CompositingOperatorType ] , [ MaskingModeType ] ;

(* <max-width> *)
MaxWidthType = "none" | NonNegativeLengthPercentageType | "min-content" | "max-content" | FitContentFn | CalcSizeFn | AnchorSizeFn | "stretch" | "fit-content" | "contain" ;

(* <min-width> *)
MinWidthType = "auto" | NonNegativeLengthPercentageType | "min-content" | "max-content" | FitContentFn | CalcSizeFn | AnchorSizeFn | "stretch" | "fit-content" | "contain" ;

(* <offset-path> *)
OffsetPathType = RayFn | UrlType | BasicShapeType ;

(* <offset-position> *)
OffsetPositionType = "normal" | "auto" | PositionType ;

(* <offset-distance> *)
OffsetDistanceType = LengthPercentageType ;

(* <offset-rotate> *)
OffsetRotateType = [ ( "auto" | "reverse" ) ] , [ AngleType ] ;

(* <offset-anchor> *)
OffsetAnchorType = "auto" | PositionType ;

(* <outline-line-style> *)
OutlineLineStyleType = "none" | "auto" | "dotted" | "dashed" | "solid" | "double" | "groove" | "ridge" | "inset" | "outset" ;

(* <outline-width> *)
OutlineWidthType = LineWidthType ;

(* <outline-style> *)
OutlineStyleType = "auto" | OutlineLineStyleType ;

(* <outline-color> *)
OutlineColorType = "auto" | "border-top-color" ;

(* <overflow-block> *)
OverflowBlockType = "visible" | "hidden" | "clip" | "scroll" | "auto" ;

(* <padding-top> *)
PaddingTopType = LengthPercentageType ;

(* <align-content> *)
AlignContentType = "normal" | BaselinePositionType | ContentDistributionType | [ OverflowPositionType ] , ContentPositionType ;

(* <justify-content> *)
JustifyContentType = "normal" | ContentDistributionType | [ OverflowPositionType ] , ( ContentPositionType | "left" | "right" ) ;

(* <align-items> *)
AlignItemsType = "normal" | "stretch" | BaselinePositionType | [ OverflowPositionType ] , SelfPositionType ;

(* <justify-items> *)
JustifyItemsType = "normal" | "stretch" | BaselinePositionType | [ OverflowPositionType ] , ( SelfPositionType | "left" | "right" ) | "legacy" | "legacy" , ( "left" | "right" | "center" ) ;

(* <align-self> *)
AlignSelfType = "auto" | [ OverflowPositionType ] , ( "normal" | SelfPositionType ) | "stretch" | BaselinePositionType | "anchor-center" ;

(* <justify-self> *)
JustifySelfType = "auto" | [ OverflowPositionType ] , ( "normal" | SelfPositionType | "left" | "right" ) | "stretch" | BaselinePositionType | "anchor-center" ;

(* <try-tactic> *)
(* flip-block || flip-inline || flip-start || flip-x || flip-y — representative
   single/paired tactics instead of all five stacked. *)
TryTacticType =
    "flip-block" | "flip-inline" | "flip-start" | "flip-x" | "flip-y"
    | "flip-block" , "flip-inline" | "flip-start" , "flip-x" ;

(* <try-size> *)
TrySizeType = "most-width" | "most-height" | "most-block-size" | "most-inline-size" ;

(* <position-try-order> *)
PositionTryOrderType = "normal" | TrySizeType ;

(* <position-try-fallbacks> *)
PositionTryFallbacksType = "none" | PositionTryFallbacksTypeItem , { "," , PositionTryFallbacksTypeItem } ;
PositionTryFallbacksTypeItem = ( ( [ dashed_ident_type ] , [ TryTacticType ] ) | PositionAreaType ) ;

(* <running()> *)
RunningFn = "running" , "(" , custom_ident_type , ")" ;

(* <scroll-timeline-name> *)
ScrollTimelineNameType = ScrollTimelineNameTypeItem , { "," , ScrollTimelineNameTypeItem } ;
ScrollTimelineNameTypeItem = ( "none" | dashed_ident_type ) ;

(* <scroll-timeline-axis> *)
ScrollTimelineAxisType = ScrollTimelineAxisTypeItem , { "," , ScrollTimelineAxisTypeItem } ;
ScrollTimelineAxisTypeItem = ( "block" | "inline" | "x" | "y" | "horizontal" | "vertical" ) ;

(* <autospace> *)
AutospaceType = "no-autospace" | [ ( [ "ideograph-alpha" ] , [ "ideograph-numeric" ] , [ "punctuation" ] ) ] , [ ( "insert" | "replace" ) ] ;

(* <text-box-trim> *)
TextBoxTrimType = "none" | "trim-start" | "trim-end" | "trim-both" ;

(* <text-box-edge> *)
TextBoxEdgeType = "auto" | TextEdgeType ;

(* <text-decoration-line> *)
TextDecorationLineType = "none" | ( [ "underline" ] , [ "overline" ] , [ "line-through" ] , [ "blink" ] ) | "spelling-error" | "grammar-error" ;

(* <text-decoration-thickness> *)
TextDecorationThicknessType = "auto" | "from-font" | LengthPercentageType | LineWidthType ;

(* <text-decoration-style> *)
TextDecorationStyleType = "solid" | "double" | "dotted" | "dashed" | "wavy" ;

(* <text-decoration-color> *)
TextDecorationColorType = ColorType ;

(* <text-emphasis-style> *)
TextEmphasisStyleType = "none" | ( [ ( "filled" | "open" ) ] , [ ( "dot" | "circle" | "double-circle" | "triangle" | "sesame" ) ] ) | string_type ;

(* <text-emphasis-color> *)
TextEmphasisColorType = ColorType ;

(* <fade()> *)
FadeFn = "fade" , "(" , LengthPercentageType , ")" ;

(* <shadow> — color may appear before or after the lengths *)
(* text-shadow item: color? offX offY blur? — varied curated shadows as one rep. *)
ShadowType = length_type ;

(* <spacing-trim> *)
SpacingTrimType = "space-all" | "normal" | "space-first" | "trim-start" | "trim-both" | "trim-all" ;

(* <text-wrap-mode> *)
TextWrapModeType = "wrap" | "nowrap" ;

(* <text-wrap-style> *)
TextWrapStyleType = "auto" | "balance" | "stable" | "pretty" | "avoid-orphans" ;

(* <transition-behavior-value> *)
TransitionBehaviorValueType = "normal" | "allow-discrete" ;

(* <single-transition-Property> *)
(* the transitioned property name — a real animatable property (rep in reps.go)
   so the transition is meaningful, not the placeholder ident 'my-ident'. *)
TransitionPropertyNameType = custom_ident_type ;
SingleTransitionPropertyType = "all" | TransitionPropertyNameType ;

(* <single-transition> *)
(* <single-transition> = [none|<property>] || <duration> || <easing> || <delay> ||
   <behavior>. The loose form repeats the same TimeType for duration AND delay
   ("0.3s … 0.3s"); encode representative forms with distinct duration/delay. *)
SingleTransitionType =
    SingleTransitionPropertyType , "0.4s"
    | SingleTransitionPropertyType , "0.4s" , "ease-in-out"
    | SingleTransitionPropertyType , "0.6s" , "linear" , "0.1s"
    | SingleTransitionPropertyType , "0.4s" , "ease" , "0.1s" , TransitionBehaviorValueType ;

(* <alignment-baseline> *)
AlignmentBaselineType = "baseline" | BaselineMetricType ;

(* <baseline-shift> *)
BaselineShiftType = LengthPercentageType | "sub" | "super" | "top" | "center" | "bottom" ;

(* <view-timeline-name> *)
ViewTimelineNameType = ViewTimelineNameTypeItem , { "," , ViewTimelineNameTypeItem } ;
ViewTimelineNameTypeItem = ( "none" | dashed_ident_type ) ;

(* <view-timeline-axis> *)
ViewTimelineAxisType = ViewTimelineAxisTypeItem , { "," , ViewTimelineAxisTypeItem } ;
ViewTimelineAxisTypeItem = ( "block" | "inline" | "x" | "y" | "horizontal" | "vertical" ) ;

(* <white-space-collapse> *)
WhiteSpaceCollapseType = "collapse" | "discard" | "preserve" | "preserve-breaks" | "preserve-spaces" | "break-spaces" ;

(* <white-space-trim> *)
WhiteSpaceTrimType = "none" | [ "discard-before" ] , [ "discard-after" ] , [ "discard-inner" ] ;

(* <animateable-feature> *)
AnimateableFeatureType = "scroll-position" | "contents" | custom_ident_type ;

(* <border-width> *)
BorderWidthType = "border-top-width" , [ "border-top-width" ] , [ "border-top-width" ] , [ "border-top-width" ] ;

(* <border-style> *)
BorderStyleType = "border-top-style" , [ "border-top-style" ] , [ "border-top-style" ] , [ "border-top-style" ] ;


(* ── CSS Properties ────────────────────────────────────────────────────── *)

(* accent-color *)
AccentColorProp = "auto" | ColorType ;

(* align-content *)
AlignContentProp = "normal" | BaselinePositionType | ContentDistributionType | [ OverflowPositionType ] , ContentPositionType ;

(* align-items *)
AlignItemsProp = "normal" | "stretch" | BaselinePositionType | [ OverflowPositionType ] , SelfPositionType ;

(* align-self *)
AlignSelfProp = "auto" | [ OverflowPositionType ] , ( "normal" | SelfPositionType ) | "stretch" | BaselinePositionType | "anchor-center" ;

(* alignment-baseline *)
AlignmentBaselineProp = "baseline" | BaselineMetricType ;

(* all *)
AllProp = "initial" | "inherit" | "unset" | "revert" | "revert-layer" | "revert-rule" ;

(* anchor-name *)
AnchorNameProp = "none" | AnchorNameType , { "," , AnchorNameType } ;

(* anchor-scope *)
AnchorScopeProp = "none" | "all" | AnchorNameType , { "," , AnchorNameType } ;

(* animation-composition *)
AnimationCompositionProp = SingleAnimationCompositionType , { "," , SingleAnimationCompositionType } ;

(* animation-delay *)
AnimationDelayProp = TimeType , { "," , TimeType } ;

(* animation-direction *)
AnimationDirectionProp = SingleAnimationDirectionType , { "," , SingleAnimationDirectionType } ;

(* animation-duration *)
AnimationDurationProp = AnimationDurationPropItem , { "," , AnimationDurationPropItem } ;
(* auto | <time>. The generator can only feed MathFunctionType length operands
   (calc(24px)), which is invalid in a <time> slot, so math is omitted here. *)
AnimationDurationPropItem = ( "auto" | NonNegativeTimeType ) ;

(* animation-fill-mode *)
AnimationFillModeProp = SingleAnimationFillModeType , { "," , SingleAnimationFillModeType } ;

(* animation-iteration-count *)
AnimationIterationCountProp = SingleAnimationIterationCountType , { "," , SingleAnimationIterationCountType } ;

(* animation-name *)
AnimationNameProp = AnimationNamePropItem , { "," , AnimationNamePropItem } ;
AnimationNamePropItem = ( "none" | KeyframesNameType ) ;

(* animation-play-state *)
AnimationPlayStateProp = SingleAnimationPlayStateType , { "," , SingleAnimationPlayStateType } ;

(* animation-range-end *)
AnimationRangeEndProp = AnimationRangeEndPropItem , { "," , AnimationRangeEndPropItem } ;
AnimationRangeEndPropItem = ( "normal" | LengthPercentageType | TimelineRangeNameType , [ LengthPercentageType ] ) ;

(* animation-range-start *)
AnimationRangeStartProp = AnimationRangeStartPropItem , { "," , AnimationRangeStartPropItem } ;
AnimationRangeStartPropItem = ( "normal" | LengthPercentageType | TimelineRangeNameType , [ LengthPercentageType ] ) ;

(* animation-range *)
AnimationRangeProp = AnimationRangePropItem , { "," , AnimationRangePropItem } ;
AnimationRangePropItem = AnimationRangeStartTypeItem , [ AnimationRangeEndTypeItem ] ;

(* animation-timeline *)
AnimationTimelineProp = SingleAnimationTimelineType , { "," , SingleAnimationTimelineType } ;

(* animation-timing-function *)
AnimationTimingFunctionProp = EasingFunctionType , { "," , EasingFunctionType } ;

(* animation *)
AnimationProp = SingleAnimationType , { "," , SingleAnimationType } ;

(* appearance *)
AppearanceProp = "none" | "auto" | "base" | "base-select" | CompatAutoType | CompatSpecialType ;

(* aspect-ratio *)
AspectRatioProp =
    "auto" , [ RatioType ] | RatioType , [ "auto" ] ;

(* backdrop-filter *)
BackdropFilterProp = "none" | FilterValueListType ;

(* backface-visibility *)
BackfaceVisibilityProp = "visible" | "hidden" ;

(* background-attachment *)
BackgroundAttachmentProp = AttachmentType , { "," , AttachmentType } ;

(* background-blend-mode *)
BackgroundBlendModeProp = BlendModeType , { "," , BlendModeType } ;

(* background-clip *)
BackgroundClipProp = BgClipType , { "," , BgClipType } ;

(* background-color *)
BackgroundColorProp = ColorType ;

(* background-image *)
BackgroundImageProp = BgImageType , { "," , BgImageType } ;

(* background-origin *)
BackgroundOriginProp = VisualBoxType , { "," , VisualBoxType } ;

(* background-position-x *)
BackgroundPositionXProp = BackgroundPositionXPropItem , { "," , BackgroundPositionXPropItem } ;
BackgroundPositionXPropItem = "center"
    | ( "left" | "right" | "x-start" | "x-end" ) , [ LengthPercentageType ]
    | LengthPercentageType ;

(* background-position-y *)
BackgroundPositionYProp = BackgroundPositionYPropItem , { "," , BackgroundPositionYPropItem } ;
BackgroundPositionYPropItem = "center"
    | ( "top" | "bottom" | "y-start" | "y-end" ) , [ LengthPercentageType ]
    | LengthPercentageType ;

(* background-position *)
BackgroundPositionProp = BgPositionType , { "," , BgPositionType } ;

(* background-repeat *)
BackgroundRepeatProp = RepeatStyleType , { "," , RepeatStyleType } ;

(* background-repeat-x *)
BackgroundRepeatXProp = RepetitionType , { "," , RepetitionType } ;

(* background-repeat-y *)
BackgroundRepeatYProp = RepetitionType , { "," , RepetitionType } ;

(* background-size *)
BackgroundSizeProp = BgSizeType , { "," , BgSizeType } ;

(* background = <bg-layer>#? <final-bg-layer>, each layer a || of image, position[/size],
   repeat, attachment, box, box, color. The fully loose "{ item }" form explodes past the
   value cap and emits NOTHING; encode representative layers (complex → simple, wide
   position/size/box pinned, hex for colour) so each combination is shown. *)
BackgroundProp =
    BgImageType , "center" , "/" , "cover" , "no-repeat" , "fixed" , "padding-box" , hex_color_type
  | BgImageType , "top left" , "/" , "contain" , "repeat-x" , "scroll"
  | BgImageType , "center" , "no-repeat"
  | hex_color_type , BgImageType
  | BgImageType
  | hex_color_type ;

(* baseline-shift *)
BaselineShiftProp = LengthPercentageType | "sub" | "super" | "top" | "center" | "bottom" ;

(* baseline-source *)
BaselineSourceProp = "auto" | "first" | "last" ;

(* block-size *)
BlockSizeProp = WidthProp ;

(* border-block-color *)
BorderBlockColorProp = BorderTopColorProp , [ BorderTopColorProp ] ;

(* border-block-end-color *)
BorderBlockEndColorProp = ColorType | Image1dType ;

(* border-block-end-style *)
BorderBlockEndStyleProp = LineStyleType ;

(* border-block-end-width *)
BorderBlockEndWidthProp = LineWidthType ;

(* border-block-end *)
BorderBlockEndProp = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* border-block-start-color *)
BorderBlockStartColorProp = ColorType | Image1dType ;

(* border-block-start-style *)
BorderBlockStartStyleProp = LineStyleType ;

(* border-block-start-width *)
BorderBlockStartWidthProp = LineWidthType ;

(* border-block-start *)
BorderBlockStartProp = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* border-block-style *)
BorderBlockStyleProp = BorderTopStyleProp , [ BorderTopStyleProp ] ;

(* border-block-width *)
BorderBlockWidthProp = BorderTopWidthProp , [ BorderTopWidthProp ] ;

(* border-block *)
BorderBlockProp = BorderBlockStartProp ;

(* border-bottom-color *)
BorderBottomColorProp = ColorType | Image1dType ;

(* border-bottom-left-radius *)
BorderBottomLeftRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-bottom-right-radius *)
BorderBottomRightRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-bottom-style *)
BorderBottomStyleProp = LineStyleType ;

(* border-bottom-width *)
BorderBottomWidthProp = LineWidthType ;

(* border-bottom *)
BorderBottomProp =
    LineWidthType , [ LineStyleType , [ ColorType ] | ColorType , [ LineStyleType ] ]
    | LineStyleType , [ LineWidthType , [ ColorType ] | ColorType , [ LineWidthType ] ]
    | ColorType , [ LineWidthType , [ LineStyleType ] | LineStyleType , [ LineWidthType ] ] ;

(* border-collapse *)
BorderCollapseProp = "separate" | "collapse" ;

(* border-color *)
BorderColorProp = BorderColorPropItem , [ BorderColorPropItem ] , [ BorderColorPropItem ] , [ BorderColorPropItem ] ;
BorderColorPropItem = ( ColorType | Image1dType ) ;

(* border-end-end-radius *)
BorderEndEndRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-end-start-radius *)
BorderEndStartRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-image-outset — a <length>|<number>{1,4} list. The {1,4} of identical
   leaves collapses to one repeated default ("1 1 1 1"); supply varied 1-4 value
   tuples as one rep (cmd/gen/reps.go) so each card shows distinct edge values. *)
BorderImageOutsetProp = BorderImageOutsetList ;
BorderImageOutsetList = LengthType ;

(* border-image-repeat *)
BorderImageRepeatProp = BorderImageRepeatPropItem , [ BorderImageRepeatPropItem ] ;
BorderImageRepeatPropItem = ( "stretch" | "repeat" | "round" | "space" ) ;

(* border-image-slice — a <number-percentage>{1,4} list with optional fill. Varied
   1-4 value tuples come from one rep so the cards aren't all "1 1 1 X". *)
BorderImageSliceProp = BorderImageSliceList , [ "fill" ] ;
BorderImageSliceList = NonNegativeNumberType ;

(* border-image-source *)
BorderImageSourceProp = ImageType | "none" ;

(* border-image-width — a [<length-percentage>|<number>|auto]{1,4} list. Varied
   1-4 value tuples (incl. auto) come from one rep instead of "1 1 1 X". *)
BorderImageWidthProp = BorderImageWidthList ;
BorderImageWidthList = LengthType ;

(* border-image *)
BorderImageProp = [ BorderImageSourceProp ] , [ BorderImageSliceProp , [ ( "/" , BorderImageWidthProp | "/" , [ BorderImageWidthProp ] , "/" , BorderImageOutsetProp ) ] ] , [ BorderImageRepeatProp ] ;

(* border-inline-color *)
BorderInlineColorProp = BorderTopColorProp , [ BorderTopColorProp ] ;

(* border-inline-end-color *)
BorderInlineEndColorProp = ColorType | Image1dType ;

(* border-inline-end-style *)
BorderInlineEndStyleProp = LineStyleType ;

(* border-inline-end-width *)
BorderInlineEndWidthProp = LineWidthType ;

(* border-inline-end *)
BorderInlineEndProp = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* border-inline-start-color *)
BorderInlineStartColorProp = ColorType | Image1dType ;

(* border-inline-start-style *)
BorderInlineStartStyleProp = LineStyleType ;

(* border-inline-start-width *)
BorderInlineStartWidthProp = LineWidthType ;

(* border-inline-start *)
BorderInlineStartProp = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* border-inline-style *)
BorderInlineStyleProp = BorderTopStyleProp , [ BorderTopStyleProp ] ;

(* border-inline-width *)
BorderInlineWidthProp = BorderTopWidthProp , [ BorderTopWidthProp ] ;

(* border-inline *)
BorderInlineProp = BorderBlockStartProp ;

(* border-left-color *)
BorderLeftColorProp = ColorType | Image1dType ;

(* border-left-style *)
BorderLeftStyleProp = LineStyleType ;

(* border-left-width *)
BorderLeftWidthProp = LineWidthType ;

(* border-left *)
BorderLeftProp = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* border-radius *)
(* border-radius — <length-percentage>{1,4} [ / <length-percentage>{1,4} ]?. The
   {1,4} of identical leaves collapses to "24px 24px 24px 24px"; supply varied corner
   tuples (incl. the elliptical / form) as one rep so each corner differs. *)
BorderRadiusProp = BorderRadiusList ;
BorderRadiusList = NonNegativeLengthPercentageType ;

(* border-right-color *)
BorderRightColorProp = ColorType | Image1dType ;

(* border-right-style *)
BorderRightStyleProp = LineStyleType ;

(* border-right-width *)
BorderRightWidthProp = LineWidthType ;

(* border-right *)
BorderRightProp = [ LineWidthType ] , [ LineStyleType ] , [ ColorType ] ;

(* border-spacing *)
BorderSpacingProp = NonNegativeLengthType , [ NonNegativeLengthType ] ;

(* border-start-end-radius *)
BorderStartEndRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-start-start-radius *)
BorderStartStartRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-style *)
BorderStyleProp = BorderTopStyleProp , [ BorderTopStyleProp ] , [ BorderTopStyleProp ] , [ BorderTopStyleProp ] ;

(* border-top-color *)
BorderTopColorProp = ColorType | Image1dType ;

(* border-top-left-radius *)
BorderTopLeftRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-top-right-radius *)
BorderTopRightRadiusProp = NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] ;

(* border-top-style *)
BorderTopStyleProp = LineStyleType ;

(* border-top-width *)
BorderTopWidthProp = LineWidthType ;

(* border-top *)
BorderTopProp =
    LineWidthType , [ LineStyleType , [ ColorType ] | ColorType , [ LineStyleType ] ]
    | LineStyleType , [ LineWidthType , [ ColorType ] | ColorType , [ LineWidthType ] ]
    | ColorType , [ LineWidthType , [ LineStyleType ] | LineStyleType , [ LineWidthType ] ] ;

(* border-width *)
BorderWidthProp = BorderTopWidthProp , [ BorderTopWidthProp ] , [ BorderTopWidthProp ] , [ BorderTopWidthProp ] ;

(* border — components in any order per spec *)
BorderProp =
    LineWidthType , [ LineStyleType , [ ColorType ] | ColorType , [ LineStyleType ] ]
    | LineStyleType , [ LineWidthType , [ ColorType ] | ColorType , [ LineWidthType ] ]
    | ColorType , [ LineWidthType , [ LineStyleType ] | LineStyleType , [ LineWidthType ] ] ;

(* bottom *)
BottomProp = "auto" | LengthPercentageType | AnchorFn | AnchorSizeFn ;

(* box-align *)
BoxAlignProp = "start" | "center" | "end" | "baseline" | "stretch" ;

(* box-decoration-break *)
BoxDecorationBreakProp = "slice" | "clone" ;

(* box-direction *)
BoxDirectionProp = "normal" | "reverse" ;

(* box-flex-group *)
BoxFlexGroupProp = IntegerType ;

(* box-flex *)
BoxFlexProp = NumberType ;

(* box-lines *)
BoxLinesProp = "single" | "multiple" ;

(* box-ordinal-group *)
BoxOrdinalGroupProp = IntegerType ;

(* box-orient *)
BoxOrientProp = "horizontal" | "vertical" | "inline-axis" | "block-axis" ;

(* box-pack *)
BoxPackProp = "start" | "center" | "end" | "justify" ;

(* box-shadow *)
BoxShadowProp = "none" | SpreadShadowType , { "," , SpreadShadowType } ;

(* box-sizing *)
BoxSizingProp = "content-box" | "border-box" ;

(* break-after *)
BreakAfterProp = "auto" | "avoid" | "always" | "all" | "avoid-page" | "page" | "left" | "right" | "recto" | "verso" | "avoid-column" | "column" | "avoid-region" | "region" ;

(* break-before *)
BreakBeforeProp = "auto" | "avoid" | "always" | "all" | "avoid-page" | "page" | "left" | "right" | "recto" | "verso" | "avoid-column" | "column" | "avoid-region" | "region" ;

(* break-inside *)
BreakInsideProp = "auto" | "avoid" | "avoid-page" | "avoid-column" | "avoid-region" ;

(* caption-side *)
CaptionSideProp = "top" | "bottom" ;

(* caret-animation *)
CaretAnimationProp = "auto" | "manual" ;

(* caret-color *)
CaretColorProp = "auto" | ColorType ;

(* caret-shape *)
CaretShapeProp = "auto" | "bar" | "block" | "underscore" ;

(* caret *)
(* caret = <'caret-color'> || <'caret-animation'> || <'caret-shape'>. The full ||
   permutation over-generates ambiguous all-auto soup ("auto auto auto"); since an
   omitted component already means auto, emit clean canonical combos in shape →
   animation → color order, with a standalone "auto" for the all-default reset. *)
CaretProp =
    "auto"
    | ( "bar" | "block" | "underscore" ) , [ "manual" ] , [ hex_color_type ]
    | "manual" , [ hex_color_type ]
    | hex_color_type ;

(* clear *)
ClearProp = "inline-start" | "inline-end" | "block-start" | "block-end" | "left" | "right" | "top" | "bottom" | "both-inline" | "both-block" | "both" | "none" ;

(* clip-path *)
ClipPathProp =
    ClipSourceType
    | BasicShapeType , [ GeometryBoxType ] | GeometryBoxType , [ BasicShapeType ]
    | "none" ;

(* clip-rule *)
ClipRuleProp = "nonzero" | "evenodd" ;

(* clip = rect( <top>, <right>, <bottom>, <left> ) | auto (docs). The legacy
   comma rect() only — clip does NOT take the modern space/round rect(). *)
ClipProp = LegacyRectSyntaxType | "auto" ;

(* color-interpolation-filters *)
ColorInterpolationFiltersProp = "auto" | "srgb" | "linearRGB" ;

(* color-interpolation *)
ColorInterpolationProp = "auto" | "srgb" | "linearRGB" ;

(* color-scheme *)
ColorSchemeProp = "normal" | ColorSchemePropItem , { ColorSchemePropItem } , [ "only" ] | "only" , ColorSchemePropItem , { ColorSchemePropItem } ;
ColorSchemePropItem = ( "light" | "dark" | custom_ident_type ) ;

(* color *)
ColorProp = ColorType ;

(* column-count *)
ColumnCountProp = "auto" | positive_integer_type | IntegerVarFn ;

(* column-fill *)
ColumnFillProp = "auto" | "balance" | "balance-all" ;

(* column-gap *)
ColumnGapProp = "normal" | NonNegativeLengthPercentageType | LineWidthType ;

(* column-height *)
ColumnHeightProp = "auto" | LengthType ;

(* column-rule-color *)
ColumnRuleColorProp = LineColorListType | AutoLineColorListType ;

(* column-rule-style *)
ColumnRuleStyleProp = LineStyleListType | AutoLineStyleListType ;

(* column-rule-width *)
ColumnRuleWidthProp = LineWidthType ;

(* column-rule *)
ColumnRuleProp = GapRuleListType | GapAutoRuleListType ;

(* column-span *)
ColumnSpanProp = "none" | "all" ;

(* column-width *)
ColumnWidthProp = "auto" | NonNegativeLengthType | "min-content" | "max-content" | FitContentFn ;

(* column-wrap *)
ColumnWrapProp = "auto" | "nowrap" | "wrap" ;

(* columns *)
ColumnsProp = ( ( [ ColumnWidthProp ] , [ ColumnCountProp ] ) | ( [ ColumnCountProp ] , [ ColumnWidthProp ] ) ) , [ "/" , ColumnHeightProp ] ;

(* contain-intrinsic-block-size *)
ContainIntrinsicBlockSizeProp = [ "auto" ] , ( "none" | NonNegativeLengthType ) ;

(* contain-intrinsic-height *)
ContainIntrinsicHeightProp = [ "auto" ] , ( "none" | NonNegativeLengthType ) ;

(* contain-intrinsic-inline-size *)
ContainIntrinsicInlineSizeProp = [ "auto" ] , ( "none" | NonNegativeLengthType ) ;

(* contain-intrinsic-size *)
ContainIntrinsicSizeProp = ContainIntrinsicSizePropItem , [ ContainIntrinsicSizePropItem ] ;
ContainIntrinsicSizePropItem = [ "auto" ] , ( "none" | NonNegativeLengthType ) ;

(* contain-intrinsic-width *)
ContainIntrinsicWidthProp = [ "auto" ] , ( "none" | NonNegativeLengthType ) ;

(* contain *)
ContainPropSizeItem = ( "size" | "inline-size" ) ;
ContainProp = "none" | "strict" | "content"
    | ContainPropSizeItem , [ "layout" , [ "style" , [ "paint" ] | "paint" , [ "style" ] ] | "style" , [ "layout" , [ "paint" ] | "paint" , [ "layout" ] ] | "paint" , [ "layout" , [ "style" ] | "style" , [ "layout" ] ] ]
    | "layout" , [ ContainPropSizeItem , [ "style" , [ "paint" ] | "paint" , [ "style" ] ] | "style" , [ ContainPropSizeItem , [ "paint" ] | "paint" , [ ContainPropSizeItem ] ] | "paint" , [ ContainPropSizeItem , [ "style" ] | "style" , [ ContainPropSizeItem ] ] ]
    | "style" , [ ContainPropSizeItem , [ "layout" , [ "paint" ] | "paint" , [ "layout" ] ] | "layout" , [ ContainPropSizeItem , [ "paint" ] | "paint" , [ ContainPropSizeItem ] ] | "paint" , [ ContainPropSizeItem , [ "layout" ] | "layout" , [ ContainPropSizeItem ] ] ]
    | "paint" , [ ContainPropSizeItem , [ "layout" , [ "style" ] | "style" , [ "layout" ] ] | "layout" , [ ContainPropSizeItem , [ "style" ] | "style" , [ ContainPropSizeItem ] ] | "style" , [ ContainPropSizeItem , [ "layout" ] | "layout" , [ ContainPropSizeItem ] ] ] ;

(* container-name *)
ContainerNameProp = "none" | custom_ident_type , { custom_ident_type } ;

(* container-type *)
ContainerTypeProp = "normal" | ( "size" | "inline-size" ) , [ "scroll-state" ] | "scroll-state" , [ ( "size" | "inline-size" ) ] ;

(* container *)
ContainerProp = ContainerNameProp , [ "/" , ContainerTypeProp ] ;

(* content-visibility *)
ContentVisibilityProp = "visible" | "auto" | "hidden" ;

(* content *)
ContentProp = "normal" | "none" | ( ContentReplacementType | ContentListType ) , [ "/" , ContentPropItem , { ContentPropItem } ] | ElementFn ;
ContentPropItem = ( string_type | CounterType | AttrFn ) ;

(* corner-block-end-shape *)
CornerBlockEndShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-block-start-shape *)
CornerBlockStartShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-bottom-left-shape *)
CornerBottomLeftShapeProp = CornerShapeValueType ;

(* corner-bottom-right-shape *)
CornerBottomRightShapeProp = CornerShapeValueType ;

(* corner-bottom-shape *)
CornerBottomShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-end-end-shape *)
CornerEndEndShapeProp = CornerShapeValueType ;

(* corner-end-start-shape *)
CornerEndStartShapeProp = CornerShapeValueType ;

(* corner-inline-end-shape *)
CornerInlineEndShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-inline-start-shape *)
CornerInlineStartShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-left-shape *)
CornerLeftShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-right-shape *)
CornerRightShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* corner-shape *)
CornerShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] , [ CornerTopLeftShapeProp ] , [ CornerTopLeftShapeProp ] ;

(* corner-start-end-shape *)
CornerStartEndShapeProp = CornerShapeValueType ;

(* corner-start-start-shape *)
CornerStartStartShapeProp = CornerShapeValueType ;

(* corner-top-left-shape *)
CornerTopLeftShapeProp = CornerShapeValueType ;

(* corner-top-right-shape *)
CornerTopRightShapeProp = CornerShapeValueType ;

(* corner-top-shape *)
CornerTopShapeProp = CornerTopLeftShapeProp , [ CornerTopLeftShapeProp ] ;

(* counter-increment *)
CounterIncrementProp = CounterIncrementPropItem , { CounterIncrementPropItem } | "none" ;
CounterIncrementPropItem = CounterNameType , [ IntegerType ] ;

(* counter-reset *)
CounterResetProp = CounterResetPropItem , { CounterResetPropItem } | "none" ;
CounterResetPropItem = ( CounterNameType , [ IntegerType ] | ReversedCounterNameType , [ IntegerType ] ) ;

(* counter-set *)
CounterSetProp = CounterSetPropItem , { CounterSetPropItem } | "none" ;
CounterSetPropItem = CounterNameType , [ IntegerType ] ;

(* cursor *)
CursorProp = [ CursorImageType , { "," , CursorImageType } , "," ] , CursorPredefinedType ;

(* cx *)
CxProp = LengthPercentageType ;

(* cy *)
CyProp = LengthPercentageType ;

(* d *)
DProp = "none" | string_type ;

(* direction *)
DirectionProp = "ltr" | "rtl" ;

(* display *)
DisplayProp = ( [ DisplayOutsideType ] , [ DisplayInsideType ] ) | DisplayListitemType | DisplayInternalType | DisplayBoxType | DisplayLegacyType | "grid-lanes" | "inline-grid-lanes" | [ DisplayOutsideType ] , [ ( DisplayInsideType | "math" ) ] ;

(* dominant-baseline *)
DominantBaselineProp = "auto" | BaselineMetricType ;

(* dynamic-range-limit *)
DynamicRangeLimitProp = "standard" | "no-limit" | "constrained" | DynamicRangeLimitMixFn ;

(* empty-cells *)
EmptyCellsProp = "show" | "hide" ;

(* field-sizing *)
FieldSizingProp = "fixed" | "content" ;

(* fill-opacity *)
FillOpacityProp = OpacityProp ;

(* fill-rule *)
FillRuleProp = "nonzero" | "evenodd" ;

(* fill *)
FillProp = PaintType ;

(* filter *)
FilterProp = "none" | FilterValueListType ;

(* flex-basis *)
FlexBasisProp = "content" | WidthProp ;

(* flex-direction *)
FlexDirectionProp = "row" | "row-reverse" | "column" | "column-reverse" ;

(* flex-flow *)
FlexFlowProp =
    FlexDirectionProp , [ FlexWrapProp ] | FlexWrapProp , [ FlexDirectionProp ] ;

(* flex-grow *)
FlexGrowProp = NonNegativeNumberType ;

(* flex-shrink *)
FlexShrinkProp = NonNegativeNumberType ;

(* flex-wrap = nowrap | wrap | wrap-reverse (docs/syntax/properties.txt). 'balance'
   is not a flex-wrap value (Chrome drops 'wrap balance'); removed. *)
FlexWrapProp = "nowrap" | "wrap" | "wrap-reverse" ;

(* flex *)
FlexProp = "none"
    | FlexGrowProp , FlexShrinkProp , FlexBasisProp
    | FlexGrowProp , FlexShrinkProp
    | FlexGrowProp , FlexBasisProp
    | FlexBasisProp
    | FlexGrowProp ;

(* float *)
FloatProp = "block-start" | "block-end" | "inline-start" | "inline-end" | "snap-block" | SnapBlockFn | "snap-inline" | SnapInlineFn | "left" | "right" | "top" | "bottom" | "none" | "footnote" ;

(* flood-color *)
FloodColorProp = ColorType ;

(* flood-opacity *)
FloodOpacityProp = OpacityProp ;

(* font-family *)
FontFamilyProp = FontFamilyPropItem , { "," , FontFamilyPropItem } ;
FontFamilyPropItem = ( FontFamilyNameType | GenericFontFamilyType ) ;

(* font-feature-settings *)
FontFeatureSettingsProp = "normal" | FeatureTagValueType , { "," , FeatureTagValueType } ;

(* font-kerning *)
FontKerningProp = "auto" | "normal" | "none" ;

(* font-language-override *)
FontLanguageOverrideProp = "normal" | string_type ;

(* font-optical-sizing *)
FontOpticalSizingProp = "auto" | "none" ;

(* font-palette *)
FontPaletteProp = "normal" | "light" | "dark" | PaletteIdentifierType | PaletteMixFn ;

(* font-size-adjust *)
FontSizeAdjustProp = "none" | VarFn | [ ( "ex-height" | "cap-height" | "ch-width" | "ic-width" | "ic-height" ) ] , ( "from-font" | NonNegativeNumberType ) ;

(* font-size *)
FontSizeProp = AbsoluteSizeType | RelativeSizeType | NonNegativeLengthPercentageType | "math" ;

(* font-smooth *)
FontSmoothProp = "auto" | "never" | "always" | AbsoluteSizeType | LengthType ;

(* font-stretch *)
FontStretchProp = "normal" | NonNegativePercentageType | "ultra-condensed" | "extra-condensed" | "condensed" | "semi-condensed" | "semi-expanded" | "expanded" | "extra-expanded" | "ultra-expanded" ;

(* font-style *)
FontStyleProp = "normal" | "italic" | "left" | "right" | "oblique" , [ ObliqueAngleType ] ;

(* font-synthesis-position *)
FontSynthesisPositionProp = "auto" | "none" ;

(* font-synthesis-small-caps *)
FontSynthesisSmallCapsProp = "auto" | "none" ;

(* font-synthesis-style *)
FontSynthesisStyleProp = "auto" | "none" | "oblique-only" ;

(* font-synthesis-weight *)
FontSynthesisWeightProp = "auto" | "none" ;

(* font-synthesis *)
FontSynthesisBCD =
    "style" , [ "small-caps" , [ "position" ] | "position" , [ "small-caps" ] ]
    | "small-caps" , [ "style" , [ "position" ] | "position" , [ "style" ] ]
    | "position" , [ "style" , [ "small-caps" ] | "small-caps" , [ "style" ] ] ;

FontSynthesisACD =
    "weight" , [ "small-caps" , [ "position" ] | "position" , [ "small-caps" ] ]
    | "small-caps" , [ "weight" , [ "position" ] | "position" , [ "weight" ] ]
    | "position" , [ "weight" , [ "small-caps" ] | "small-caps" , [ "weight" ] ] ;

FontSynthesisABD =
    "weight" , [ "style" , [ "position" ] | "position" , [ "style" ] ]
    | "style" , [ "weight" , [ "position" ] | "position" , [ "weight" ] ]
    | "position" , [ "weight" , [ "style" ] | "style" , [ "weight" ] ] ;

FontSynthesisABC =
    "weight" , [ "style" , [ "small-caps" ] | "small-caps" , [ "style" ] ]
    | "style" , [ "weight" , [ "small-caps" ] | "small-caps" , [ "weight" ] ]
    | "small-caps" , [ "weight" , [ "style" ] | "style" , [ "weight" ] ] ;

FontSynthesisProp =
    "none"
    | "weight" , [ FontSynthesisBCD ]
    | "style" , [ FontSynthesisACD ]
    | "small-caps" , [ FontSynthesisABD ]
    | "position" , [ FontSynthesisABC ] ;

(* font-variant-alternates — functional notation helpers *)
FontVariantAlternatesStylisticFn       = "stylistic"        , "(" , FontFeatureValueNameType , ")" ;
FontVariantAlternatesSwashFn           = "swash"            , "(" , FontFeatureValueNameType , ")" ;
FontVariantAlternatesOrnamentsFn       = "ornaments"        , "(" , FontFeatureValueNameType , ")" ;
FontVariantAlternatesAnnotationFn      = "annotation"       , "(" , FontFeatureValueNameType , ")" ;
FontVariantAlternatesStylesetFn        = "styleset"         , "(" , FontFeatureValueNameType , { "," , FontFeatureValueNameType } , ")" ;
FontVariantAlternatesCharacterVariantFn = "character-variant" , "(" , FontFeatureValueNameType , { "," , FontFeatureValueNameType } , ")" ;
FontVariantAlternatesFnType = FontVariantAlternatesStylisticFn | FontVariantAlternatesSwashFn | FontVariantAlternatesOrnamentsFn | FontVariantAlternatesAnnotationFn | FontVariantAlternatesStylesetFn | FontVariantAlternatesCharacterVariantFn ;

(* font-variant-alternates — normal | one-or-more of historical-forms / functional notations, in any order *)
FontVariantAlternatesPropItem = "historical-forms" | FontVariantAlternatesFnType ;
FontVariantAlternatesProp = "normal" | FontVariantAlternatesPropItem , { FontVariantAlternatesPropItem } ;

(* font-variant-caps *)
FontVariantCapsProp = "normal" | "small-caps" | "all-small-caps" | "petite-caps" | "all-petite-caps" | "unicase" | "titling-caps" ;

(* font-variant-east-asian *)
FontVariantEastAsianProp = "normal" | ( [ EastAsianVariantValuesType ] , [ EastAsianWidthValuesType ] , [ "ruby" ] ) ;

(* font-variant-emoji *)
FontVariantEmojiProp = "normal" | "text" | "emoji" | "unicode" ;

(* font-variant-ligatures *)
FontVariantLigaturesProp = "normal" | "none" | ( [ CommonLigValuesType ] , [ DiscretionaryLigValuesType ] , [ HistoricalLigValuesType ] , [ ContextualAltValuesType ] ) ;

(* font-variant-numeric *)
(* normal | [ <figure> || <spacing> || <fraction> || ordinal || slashed-zero ] —
   representative single/paired combos instead of all five stacked. *)
FontVariantNumericProp =
    "normal"
    | NumericFigureValuesType
    | NumericSpacingValuesType
    | NumericFractionValuesType
    | "ordinal"
    | "slashed-zero"
    | NumericFigureValuesType , NumericFractionValuesType , "slashed-zero"
    | NumericSpacingValuesType , "ordinal" ;

(* font-variant-position *)
FontVariantPositionProp = "normal" | "sub" | "super" ;

(* font-variant *)
(* the font-variant shorthand spans ligature/caps/alternate/numeric/east-asian/
   position/emoji groups; the full || stacks them ALL ("common-ligatures … sub text").
   Encode representative single-group + a couple cross-group combos instead. *)
FontVariantProp =
    "normal"
    | "none"
    | CommonLigValuesType
    | ( "small-caps" | "all-small-caps" | "petite-caps" | "titling-caps" )
    | NumericFigureValuesType
    | NumericFractionValuesType
    | "ordinal"
    | "slashed-zero"
    | "ruby"
    | ( "sub" | "super" )
    | "small-caps" , "ordinal"
    | CommonLigValuesType , "small-caps" , NumericFractionValuesType ;

(* font-variation-settings *)
FontVariationSettingsProp = "normal" | FontVariationSettingsPropItem , { "," , FontVariationSettingsPropItem } ;
FontVariationSettingsPropItem = AxisTagType , AxisValueType ;

(* font-weight *)
FontWeightProp = FontWeightAbsoluteType | "bolder" | "lighter" ;

(* font-width *)
FontWidthProp = "normal" | PercentageType | "ultra-condensed" | "extra-condensed" | "condensed" | "semi-condensed" | "semi-expanded" | "expanded" | "extra-expanded" | "ultra-expanded" ;

(* font = [ <font-style> || <font-variant-css2> || <font-weight> || <font-width-css3> ]?
   <font-size> [ / <line-height> ]? <font-family># | <system-font-family-name>.
   Walking the full || with the whole font-family list drowns the value cap in
   "normal normal normal normal <size>/ normal <family>" rows. Encode the documented
   CANONICAL order with NON-default leading bits (an omitted component already means
   normal), a real size, an OPTIONAL real line-height (slash only when present), and a
   few generic families — so the cards read like real font declarations. *)
FontShortSizeType       = length_type ;
FontShortLineHeightType = number_type ;
FontShortFamilyType     = "serif" | "sans-serif" ;
(* explicit representative combinations (subrules), complex → simple, so each leading
   subset is shown — with the leading keywords pinned per row so the cap isn't drowned
   by one combinatorial alternative. An omitted component already means normal. *)
FontProp =
    SystemFontFamilyNameType
  | "italic" , "small-caps" , "bold" , "condensed" , FontShortSizeType , "/" , FontShortLineHeightType , FontShortFamilyType
  | "small-caps" , "bold" , FontShortSizeType , "/" , FontShortLineHeightType , FontShortFamilyType
  | "italic" , "lighter" , FontShortSizeType , FontShortFamilyType
  | "oblique" , "expanded" , FontShortSizeType , "/" , FontShortLineHeightType , FontShortFamilyType
  | "bold" , FontShortSizeType , FontShortFamilyType
  | FontShortSizeType , "/" , FontShortLineHeightType , FontShortFamilyType
  | FontShortSizeType , FontShortFamilyType ;

(* forced-color-adjust *)
ForcedColorAdjustProp = "auto" | "none" | "preserve-parent-color" ;

(* gap *)
GapProp = RowGapProp , [ ColumnGapProp ] ;

(* grid-area *)
GridAreaProp = GridLineType , [ GridAreaPropItem ] , [ GridAreaPropItem ] , [ GridAreaPropItem ] ;
GridAreaPropItem = "/" , GridLineType ;

(* grid-auto-columns *)
GridAutoColumnsProp = TrackSizeType , { TrackSizeType } ;

(* grid-auto-flow *)
GridAutoFlowProp =
    ( "row" | "column" ) , [ "dense" ] | "dense" , [ ( "row" | "column" ) ] ;

(* grid-auto-rows *)
GridAutoRowsProp = TrackSizeType , { TrackSizeType } ;

(* grid-column-end *)
GridColumnEndProp = GridLineType ;

(* grid-column-start *)
GridColumnStartProp = GridLineType ;

(* grid-column *)
GridColumnProp = GridLineType , [ "/" , GridLineType ] ;

(* grid-row-end *)
GridRowEndProp = GridLineType ;

(* grid-row-start *)
GridRowStartProp = GridLineType ;

(* grid-row *)
GridRowProp = GridLineType , [ "/" , GridLineType ] ;

(* grid-template-areas *)
GridTemplateAreasProp = "none" | string_type , { string_type } ;

(* grid-template-columns *)
GridTemplateColumnsProp = "none" | TrackListType | AutoTrackListType | "subgrid" , [ LineNameListType ] ;

(* grid-template-rows *)
GridTemplateRowsProp = "none" | TrackListType | AutoTrackListType | "subgrid" , [ LineNameListType ] ;

(* grid-template *)
GridTemplateProp = "none" | GridTemplateRowsProp , "/" , GridTemplateColumnsProp | GridTemplatePropItem , { GridTemplatePropItem } , [ "/" , ExplicitTrackListType ] ;
GridTemplatePropItem = [ LineNamesType ] , string_type , [ TrackSizeType ] , [ LineNamesType ] ;

(* grid *)
GridProp = GridTemplateProp | GridTemplateRowsProp , "/" , ( "auto-flow" , [ "dense" ] ) , [ GridAutoColumnsProp ] | ( "auto-flow" , [ "dense" ] ) , [ GridAutoRowsProp ] , "/" , GridTemplateColumnsProp ;

(* hanging-punctuation *)
HangingPunctuationForceItem = ( "force-end" | "allow-end" ) ;
HangingPunctuationProp = "none"
    | "first" , [ HangingPunctuationForceItem , [ "last" ] | "last" , [ HangingPunctuationForceItem ] ]
    | HangingPunctuationForceItem , [ "first" , [ "last" ] | "last" , [ "first" ] ]
    | "last" , [ "first" , [ HangingPunctuationForceItem ] | HangingPunctuationForceItem , [ "first" ] ] ;

(* height *)
HeightProp = "auto" | NonNegativeLengthPercentageType | "min-content" | "max-content" | FitContentFn | CalcSizeFn | AnchorSizeFn | "stretch" | "fit-content" | "contain" ;

(* hyphenate-character *)
HyphenateCharacterProp = "auto" | string_type ;

(* hyphenate-limit-chars *)
HyphenateLimitCharsProp = HyphenateLimitCharsPropItem , [ HyphenateLimitCharsPropItem ] , [ HyphenateLimitCharsPropItem ] ;
HyphenateLimitCharsPropItem = ( "auto" | IntegerType ) ;

(* hyphens *)
HyphensProp = "none" | "manual" | "auto" ;

(* image-orientation *)
ImageOrientationProp = "from-image" | "none" | AngleType , [ "flip" ] | "flip" , [ AngleType ] ;

(* image-rendering *)
ImageRenderingProp = "auto" | "smooth" | "high-quality" | "pixelated" | "crisp-edges" ;

(* image-resolution *)
ImageResolutionProp =
    "from-image" , [ ResolutionType ] , [ "snap" ]
    | ResolutionType , [ "from-image" ] , [ "snap" ]
    | "snap" , ( "from-image" , [ ResolutionType ] | ResolutionType , [ "from-image" ] ) ;

(* initial-letter *)
InitialLetterProp = "normal" | InitialLetterSizeType , IntegerType | InitialLetterSizeType , [ ( "drop" | "raise" ) ] ;

(* inline-size *)
InlineSizeProp = WidthProp ;

(* inset-block-end *)
InsetBlockEndProp = "auto" | LengthPercentageType ;

(* inset-block-start *)
InsetBlockStartProp = "auto" | LengthPercentageType ;

(* inset-block *)
InsetBlockProp = TopProp , [ TopProp ] ;

(* inset-inline-end *)
InsetInlineEndProp = "auto" | LengthPercentageType ;

(* inset-inline-start *)
InsetInlineStartProp = "auto" | LengthPercentageType ;

(* inset-inline *)
InsetInlineProp = TopProp , [ TopProp ] ;

(* inset *)
InsetProp = TopProp , [ TopProp ] , [ TopProp ] , [ TopProp ] ;

(* interactivity *)
InteractivityProp = "auto" | "inert" ;

(* interest-delay *)
InterestDelayProp = InterestDelayStartProp , [ InterestDelayStartProp ] ;

(* interest-delay-end *)
InterestDelayEndProp = "normal" | TimeType ;

(* interest-delay-start *)
InterestDelayStartProp = "normal" | TimeType ;

(* interpolate-size *)
InterpolateSizeProp = "numeric-only" | "allow-keywords" ;

(* isolation *)
IsolationProp = IsolationModeType ;

(* justify-content *)
JustifyContentProp = "normal" | ContentDistributionType | [ OverflowPositionType ] , ( ContentPositionType | "left" | "right" ) ;

(* justify-items *)
JustifyItemsProp = "normal" | "stretch" | BaselinePositionType | [ OverflowPositionType ] , ( SelfPositionType | "left" | "right" ) | "legacy" | "legacy" , ( "left" | "right" | "center" ) | "anchor-center" ;

(* justify-self *)
JustifySelfProp = "auto" | [ OverflowPositionType ] , ( "normal" | SelfPositionType | "left" | "right" ) | "stretch" | BaselinePositionType | "anchor-center" ;

(* left *)
LeftProp = "auto" | LengthPercentageType | AnchorFn | AnchorSizeFn ;

(* letter-spacing *)
LetterSpacingProp = "normal" | LengthPercentageType ;

(* lighting-color *)
LightingColorProp = ColorType ;

(* line-break *)
LineBreakProp = "auto" | "loose" | "normal" | "strict" | "anywhere" ;

(* line-clamp *)
LineClampProp = "none" | ( [ IntegerType ] , [ BlockEllipsisType ] ) , [ "-webkit-legacy" ] ;

(* line-height-step *)
LineHeightStepProp = LengthType ;

(* line-height *)
LineHeightProp = "normal" | NumberType | NonNegativeLengthPercentageType ;

(* list-style-image *)
ListStyleImageProp = ImageType | "none" ;

(* list-style-position *)
ListStylePositionProp = "inside" | "outside" ;

(* list-style-type *)
ListStyleTypeProp = CounterStyleType | string_type | "none" ;

(* list-style — components in any order per spec *)
ListStyleProp =
    ListStylePositionProp , [ ListStyleImageProp , [ ListStyleTypeProp ] | ListStyleTypeProp , [ ListStyleImageProp ] ]
    | ListStyleImageProp , [ ListStylePositionProp , [ ListStyleTypeProp ] | ListStyleTypeProp , [ ListStylePositionProp ] ]
    | ListStyleTypeProp , [ ListStylePositionProp , [ ListStyleImageProp ] | ListStyleImageProp , [ ListStylePositionProp ] ] ;

(* margin-block-end *)
MarginBlockEndProp = MarginTopProp ;

(* margin-block-start *)
MarginBlockStartProp = MarginTopProp ;

(* margin-block *)
MarginBlockProp = MarginTopProp , [ MarginTopProp ] ;

(* margin-bottom *)
MarginBottomProp = LengthPercentageType | "auto" | AnchorSizeFn ;

(* margin-inline-end *)
MarginInlineEndProp = MarginTopProp ;

(* margin-inline-start *)
MarginInlineStartProp = MarginTopProp ;

(* margin-inline *)
MarginInlineProp = MarginTopProp , [ MarginTopProp ] ;

(* margin-left *)
MarginLeftProp = LengthPercentageType | "auto" | AnchorSizeFn ;

(* margin-right *)
MarginRightProp = LengthPercentageType | "auto" | AnchorSizeFn ;

(* margin-top *)
MarginTopProp = LengthPercentageType | "auto" | AnchorSizeFn ;

(* margin-trim *)
MarginTrimProp = "none"
    | "block" , [ "inline" ] | "inline" , [ "block" ]
    | "block-start" , [ "inline-start" , [ "block-end" , [ "inline-end" ] | "inline-end" , [ "block-end" ] ] | "block-end" , [ "inline-start" , [ "inline-end" ] | "inline-end" , [ "inline-start" ] ] | "inline-end" , [ "inline-start" , [ "block-end" ] | "block-end" , [ "inline-start" ] ] ]
    | "inline-start" , [ "block-start" , [ "block-end" , [ "inline-end" ] | "inline-end" , [ "block-end" ] ] | "block-end" , [ "block-start" , [ "inline-end" ] | "inline-end" , [ "block-start" ] ] | "inline-end" , [ "block-start" , [ "block-end" ] | "block-end" , [ "block-start" ] ] ]
    | "block-end" , [ "block-start" , [ "inline-start" , [ "inline-end" ] | "inline-end" , [ "inline-start" ] ] | "inline-start" , [ "block-start" , [ "inline-end" ] | "inline-end" , [ "block-start" ] ] | "inline-end" , [ "block-start" , [ "inline-start" ] | "inline-start" , [ "block-start" ] ] ]
    | "inline-end" , [ "block-start" , [ "inline-start" , [ "block-end" ] | "block-end" , [ "inline-start" ] ] | "inline-start" , [ "block-start" , [ "block-end" ] | "block-end" , [ "block-start" ] ] | "block-end" , [ "block-start" , [ "inline-start" ] | "inline-start" , [ "block-start" ] ] ] ;

