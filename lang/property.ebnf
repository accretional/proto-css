    ( "auto" | "none" | "inter-word" | "inter-character" | "inter-ideograph" | "distribute" | "ruby" ) , [ "no-compress" ]
    | "no-compress" , [ ( "auto" | "none" | "inter-word" | "inter-character" | "inter-ideograph" | "distribute" | "ruby" ) ] ;

(* text-orientation *)
TextOrientationProp = "mixed" | "upright" | "sideways" ;

(* text-overflow *)
