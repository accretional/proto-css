PaintOrderProp =
    "normal"
    | "fill" , [ "stroke" , [ "markers" ] | "markers" , [ "stroke" ] ]
    | "stroke" , [ "fill" , [ "markers" ] | "markers" , [ "fill" ] ]
    | "markers" , [ "fill" , [ "stroke" ] | "stroke" , [ "fill" ] ] ;

