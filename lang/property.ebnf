    "auto"
    | ( "over" | "under" ) , [ ( "right" | "left" ) ]
    | ( "right" | "left" ) , ( "over" | "under" ) ;

(* text-emphasis-style *)
TextEmphasisStyleProp = "dot" | "circle" | "double-circle" | "triangle" | "sesame" | ( "open" , "dot" ) | ( "open" , "circle" ) | ( "open" , "double-circle" ) | ( "open" , "triangle" ) | ( "open" , "sesame" ) | "none" | string_type ;

