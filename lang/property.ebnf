(* text-transform *)
TextTransformProp = "none" | [ ( "capitalize" | "uppercase" | "lowercase" ) ] , [ "full-width" ] , [ "full-size-kana" ] | "math-auto" ;

(* text-underline-offset *)
TextUnderlineOffsetProp = "auto" | LengthPercentageType ;

(* text-underline-position *)
TextUnderlinePositionProp = "auto" | [ ( "from-font" | "under" ) ] , [ ( "left" | "right" ) ] ;

(* text-wrap-mode *)
TextWrapModeProp = "wrap" | "nowrap" ;

(* text-wrap-style *)
TextWrapStyleProp = "auto" | "balance" | "stable" | "pretty" | "avoid-orphans" ;

(* text-wrap *)
TextWrapProp = [ TextWrapModeProp ] , [ TextWrapStyleProp ] ;

(* timeline-scope *)
TimelineScopeProp = "none" | "all" | dashed_ident_type , { "," , dashed_ident_type } ;

(* top *)
TopProp = "auto" | LengthPercentageType | AnchorFn | AnchorSizeFn ;

(* touch-action *)
TouchActionProp = "auto" | "none" | ( [ ( "pan-x" | "pan-left" | "pan-right" ) ] , [ ( "pan-y" | "pan-up" | "pan-down" ) ] , [ "pinch-zoom" ] ) | "manipulation" ;

(* transform-box *)
TransformBoxProp = "content-box" | "border-box" | "fill-box" | "stroke-box" | "view-box" ;

(* transform-origin *)
TransformOriginProp = ( "left" | "center" | "right" | "top" | "bottom" | LengthPercentageType ) | ( "left" | "center" | "right" | LengthPercentageType ) , ( "top" | "center" | "bottom" | LengthPercentageType ) , [ LengthType ] | ( ( "center" | "left" | "right" ) , ( "center" | "top" | "bottom" ) ) , [ LengthType ] ;

(* transform-style *)
TransformStyleProp = "flat" | "preserve-3d" ;

(* transform *)
TransformProp = "none" | TransformListType ;

(* transition-behavior *)
TransitionBehaviorProp = TransitionBehaviorValueType , { "," , TransitionBehaviorValueType } ;

(* transition-delay *)
TransitionDelayProp = TimeType , { "," , TimeType } ;

(* transition-duration *)
TransitionDurationProp = NonNegativeTimeType , { "," , NonNegativeTimeType } ;

(* transition-Property *)
TransitionPropertyProp = "none" | SingleTransitionPropertyType , { "," , SingleTransitionPropertyType } ;

(* transition-timing-function *)
TransitionTimingFunctionProp = EasingFunctionType , { "," , EasingFunctionType } ;

(* transition *)
TransitionProp = SingleTransitionType , { "," , SingleTransitionType } ;

(* translate *)
(* translate: x [y [z]] — identical leaves collapse to "24px 24px 24px"; varied tuples. *)
TranslateProp = "none" | TranslateList ;
TranslateList = length_type ;

(* unicode-bidi *)
UnicodeBidiProp = "normal" | "embed" | "isolate" | "bidi-override" | "isolate-override" | "plaintext" ;

(* user-modify *)
UserModifyProp = "read-only" | "read-write" | "read-write-plaintext-only" | "write-only" ;

(* user-select *)
UserSelectProp = "auto" | "text" | "none" | "contain" | "all" ;

(* vector-effect *)
VectorEffectProp = "none" | "non-scaling-stroke" | "non-scaling-size" | "non-rotation" | "fixed-position" ;

(* vertical-align *)
(* the classic, browser-supported vertical-align (the Inline-Layout-3
   first/last + baseline syntax is unimplemented in Chrome) *)
VerticalAlignProp = "baseline" | "sub" | "super" | "text-top" | "text-bottom" | "middle" | "top" | "bottom" | LengthPercentageType ;

(* view-timeline-axis *)
ViewTimelineAxisProp = ViewTimelineAxisPropItem , { "," , ViewTimelineAxisPropItem } ;
ViewTimelineAxisPropItem = ( "block" | "inline" | "x" | "y" ) ;

(* view-timeline-inset *)
ViewTimelineInsetProp = ViewTimelineInsetPropItem , { "," , ViewTimelineInsetPropItem } ;
ViewTimelineInsetPropItem2 = ( "auto" | LengthPercentageType ) ;
ViewTimelineInsetPropItem = ViewTimelineInsetPropItem2 , [ ViewTimelineInsetPropItem2 ] ;

(* view-timeline-name *)
ViewTimelineNameProp = ViewTimelineNamePropItem , { "," , ViewTimelineNamePropItem } ;
ViewTimelineNamePropItem = ( "none" | dashed_ident_type ) ;

(* view-timeline *)
ViewTimelineProp = ViewTimelinePropItem , { "," , ViewTimelinePropItem } ;
ViewTimelinePropItem = ViewTimelineNamePropItem , [ ViewTimelineAxisPropItem , [ ViewTimelineInsetPropItem ] | ViewTimelineInsetPropItem , [ ViewTimelineAxisPropItem ] ] ;

(* view-transition-class *)
ViewTransitionClassProp = "none" | custom_ident_type , { custom_ident_type } ;

(* view-transition-name *)
ViewTransitionNameProp = "none" | "match-element" | custom_ident_type ;

(* visibility *)
VisibilityProp = "visible" | "hidden" | "force-hidden" | "collapse" ;

(* white-space-collapse *)
WhiteSpaceCollapseProp = "collapse" | "discard" | "preserve" | "preserve-breaks" | "preserve-spaces" | "break-spaces" ;

(* white-space *)
WhiteSpaceProp = "normal" | "pre" | "pre-wrap" | "pre-line" | [ WhiteSpaceCollapseProp ] , [ TextWrapModeProp ] , [ "white-space-trim" ] ;

(* widows *)
WidowsProp = positive_integer_type | VarFn ;

(* width *)
WidthProp = "auto" | NonNegativeLengthPercentageType | "min-content" | "max-content" | FitContentFn | CalcSizeFn | AnchorSizeFn | "stretch" | "fit-content" | "contain" ;

(* will-change *)
WillChangeProp = "auto" | AnimateableFeatureType , { "," , AnimateableFeatureType } ;

(* word-break *)
WordBreakProp = "normal" | "break-all" | "keep-all" | "manual" | "auto-phrase" | "break-word" ;

(* word-spacing *)
WordSpacingProp = "normal" | NonNegativeLengthPercentageType ;

(* writing-mode *)
WritingModeProp = "horizontal-tb" | "vertical-rl" | "vertical-lr" | "sideways-rl" | "sideways-lr" ;

(* x *)
XProp = LengthPercentageType ;

(* y *)
YProp = LengthPercentageType ;

(* z-index *)
ZIndexProp = "auto" | IntegerType | "inherit" ;

(* zoom *)
ZoomProp = NonNegativeNumberType | PercentageType ;

(* grid-gap / grid-row-gap / grid-column-gap — deprecated gap shorthands *)
GridGapExpr    = "grid-gap"    , ":" , ( GridGapProp    | AllProp ) , [ "!" , "important" ] ;
GridRowGapExpr    = "grid-row-gap"    , ":" , ( GridGapProp    | AllProp ) , [ "!" , "important" ] ;
GridColumnGapExpr = "grid-column-gap" , ":" , ( GridGapProp    | AllProp ) , [ "!" , "important" ] ;
GridGapProp = ( LengthPercentageType | "normal" ) , [ LengthPercentageType | "normal" ] ;
(* row-gap / column-gap (and the grid-*-gap aliases) take a SINGLE value *)
GridRowGapProp = LengthPercentageType | "normal" ;
GridColumnGapProp = LengthPercentageType | "normal" ;

(* Vendor-prefixed property — -vendor-name: <value> ;
   Not included in generation — not a real CSS property. *)
VendorPropRule = "-" , ident_type , ":" , VendorPropValue , [ "!" , "important" ] ;
VendorPropValue = string_type | ColorType | LengthPercentageType | NumberType | ident_type ;

