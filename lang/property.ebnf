(* scroll-timeline-name *)
ScrollTimelineNameProp = ScrollTimelineNamePropItem , { "," , ScrollTimelineNamePropItem } ;
ScrollTimelineNamePropItem = ( "none" | dashed_ident_type ) ;

(* scroll-timeline *)
ScrollTimelineProp = ScrollTimelinePropItem , { "," , ScrollTimelinePropItem } ;
ScrollTimelinePropItem = ScrollTimelineNamePropItem , [ ScrollTimelineAxisPropItem ] ;

(* scrollbar-color *)
ScrollbarColorProp = "auto" | ColorType , ColorType ;

(* scrollbar-gutter *)
ScrollbarGutterProp = "auto" | "stable" , [ "both-edges" ] ;

