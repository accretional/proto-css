(* rx *)
RxProp = LengthPercentageType | "auto" ;

(* ry *)
RyProp = LengthPercentageType | "auto" ;

(* scale *)
(* scale: sx [sy [sz]] — identical leaves collapse; varied tuples. *)
ScaleProp = "none" | ScaleList ;
ScaleList = number_type ;

