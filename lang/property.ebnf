    "none"
    | OffsetPathType , [ CoordBoxType ] | CoordBoxType , [ OffsetPathType ] ;

(* offset-position *)
OffsetPositionProp = "normal" | "auto" | PositionType ;

(* offset-rotate *)
OffsetRotateProp =
    ( "auto" | "reverse" ) , [ angle_type ] | angle_type , [ ( "auto" | "reverse" ) ] ;

(* offset — [ <offset-position>? [ <offset-path> [...] ]? ]! : at least one of position or path must be present *)
OffsetPathGroup = OffsetPathProp , [ ( [ OffsetDistanceProp ] , [ OffsetRotateProp ] ) ] ;
(* offset = [ <position>? <path>? ] [ <distance> || <rotate> ]? [ / <anchor> ]?. The
   loose form stacks every component ("normal none 24px auto 45deg/ auto"); encode
   representative forms (path supplies the variety, other parts pinned). *)
OffsetProp =
    "normal" , OffsetPathProp , "50%" , "auto 45deg" , "/" , "center"
  | OffsetPathProp , "50%"
  | OffsetPositionProp ;

