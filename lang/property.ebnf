    "normal"
    | "spell-out" , [ "digits" , [ ( "literal-punctuation" | "no-punctuation" ) ] | ( "literal-punctuation" | "no-punctuation" ) , [ "digits" ] ]
    | "digits" , [ "spell-out" , [ ( "literal-punctuation" | "no-punctuation" ) ] | ( "literal-punctuation" | "no-punctuation" ) , [ "spell-out" ] ]
    | ( "literal-punctuation" | "no-punctuation" ) , [ "spell-out" , [ "digits" ] | "digits" , [ "spell-out" ] ] ;

