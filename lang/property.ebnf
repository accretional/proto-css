   single/paired combos instead of the full stacked permutation. *)
PositionVisibilityProp =
    "always"
    | "anchors-valid"
    | "anchors-visible"
    | "no-overflow"
    | "anchors-valid" , "anchors-visible"
    | "anchors-visible" , "no-overflow"
    | "anchors-valid" , "anchors-visible" , "no-overflow" ;

