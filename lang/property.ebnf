(* text-decoration-style *)
TextDecorationStyleProp = "solid" | "double" | "dotted" | "dashed" | "wavy" ;

(* text-decoration-thickness *)
TextDecorationThicknessProp = "auto" | "from-font" | LengthPercentageType | LineWidthType ;

(* text-decoration — components in any order per spec *)
TextDecorationBCD =
    TextDecorationThicknessProp , [ TextDecorationStyleProp , [ TextDecorationColorProp ] | TextDecorationColorProp , [ TextDecorationStyleProp ] ]
    | TextDecorationStyleProp , [ TextDecorationThicknessProp , [ TextDecorationColorProp ] | TextDecorationColorProp , [ TextDecorationThicknessProp ] ]
    | TextDecorationColorProp , [ TextDecorationThicknessProp , [ TextDecorationStyleProp ] | TextDecorationStyleProp , [ TextDecorationThicknessProp ] ] ;

TextDecorationACD =
    TextDecorationLineProp , [ TextDecorationStyleProp , [ TextDecorationColorProp ] | TextDecorationColorProp , [ TextDecorationStyleProp ] ]
    | TextDecorationStyleProp , [ TextDecorationLineProp , [ TextDecorationColorProp ] | TextDecorationColorProp , [ TextDecorationLineProp ] ]
    | TextDecorationColorProp , [ TextDecorationLineProp , [ TextDecorationStyleProp ] | TextDecorationStyleProp , [ TextDecorationLineProp ] ] ;

TextDecorationABD =
    TextDecorationLineProp , [ TextDecorationThicknessProp , [ TextDecorationColorProp ] | TextDecorationColorProp , [ TextDecorationThicknessProp ] ]
    | TextDecorationThicknessProp , [ TextDecorationLineProp , [ TextDecorationColorProp ] | TextDecorationColorProp , [ TextDecorationLineProp ] ]
    | TextDecorationColorProp , [ TextDecorationLineProp , [ TextDecorationThicknessProp ] | TextDecorationThicknessProp , [ TextDecorationLineProp ] ] ;

TextDecorationABC =
    TextDecorationLineProp , [ TextDecorationThicknessProp , [ TextDecorationStyleProp ] | TextDecorationStyleProp , [ TextDecorationThicknessProp ] ]
    | TextDecorationThicknessProp , [ TextDecorationLineProp , [ TextDecorationStyleProp ] | TextDecorationStyleProp , [ TextDecorationLineProp ] ]
    | TextDecorationStyleProp , [ TextDecorationLineProp , [ TextDecorationThicknessProp ] | TextDecorationThicknessProp , [ TextDecorationLineProp ] ] ;

TextDecorationProp =
    TextDecorationLineProp , [ TextDecorationBCD ]
    | TextDecorationThicknessProp , [ TextDecorationACD ]
    | TextDecorationStyleProp , [ TextDecorationABD ]
    | TextDecorationColorProp , [ TextDecorationABC ] ;

(* text-emphasis-color *)
TextEmphasisColorProp = ColorType ;

(* text-emphasis-position *)
