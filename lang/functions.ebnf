(* CSS Function definitions
   Generated / hand-authored from docs/syntax/functions.txt and docs/syntax/datatypes.txt.
   See docs/GUIDE_TO_EBNF_TRANSFORMATION.md for transformation rationale.

   Functions already defined here were originally in datatype.ebnf; moved here
   so datatypes.ebnf can reference them. Cross-file references are resolved at
   compile time by the gluon compiler.
*)


(* <contrast-color()> *)
ContrastColorFn = "contrast-color" , "(" , ColorType , ")" ;

(* <sibling-count()> — takes no parameters; returns sibling count as integer *)
SiblingCountFn = "sibling-count" , "(" , ")" ;

(* <sibling-index()> — takes no parameters; returns element's 1-based sibling position *)
SiblingIndexFn = "sibling-index" , "(" , ")" ;

(* <device-cmyk()> *)
DeviceCmykFn = LegacyDeviceCmykSyntaxType | ModernDeviceCmykSyntaxType ;

(* <color-mix()> *)
ColorMixFn = "color-mix" , "(" , [ ColorInterpolationMethodType ] , "," , ColorMixFnItem , { "," , ColorMixFnItem } , ")" ;

(* <rgb()> *)
RgbFn = LegacyRgbSyntaxType | ModernRgbSyntaxType ;

(* <rgba()> *)
RgbaFn = LegacyRgbaSyntaxType | ModernRgbaSyntaxType ;

(* <hsl()> *)
HslFn = LegacyHslSyntaxType | ModernHslSyntaxType ;

(* <hsla()> *)
HslaFn = LegacyHslaSyntaxType | ModernHslaSyntaxType ;

(* <hwb()> *)
HwbFn = "hwb" , "(" , [ "from" , ColorType ] , ( HueType | "none" ) , ( PercentageType | NumberType | "none" ) , ( PercentageType | NumberType | "none" ) , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <lab()> *)
LabFn = "lab" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ColorChannelValue , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <lch()> *)
LchFn = "lch" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ( HueType | "none" | ident_type | MathFunctionType ) , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <oklab()> *)
OklabFn = "oklab" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ColorChannelValue , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <oklch()> *)
OklchFn = "oklch" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ( HueType | "none" | ident_type | MathFunctionType ) , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <ictcp()> *)
IctcpFn = "ictcp" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ColorChannelValue , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <jzazbz()> *)
JzazbzFn = "jzazbz" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ColorChannelValue , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <jzczhz()> *)
JzczhzFn = "jzczhz" , "(" , [ "from" , ColorType ] , ColorChannelValue , ColorChannelValue , ( HueType | "none" | ident_type | MathFunctionType ) , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <color-channel-value> — for relative color syntax: number, percentage, none, or channel ident *)
ColorChannelValue = percentage_type | number_type | "none" | ident_type | MathFunctionType | VarFn ;

(* <alpha()> *)
AlphaFn = "alpha" , "(" , "from" , ColorType , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <color()> *)
ColorFn = "color" , "(" , [ "from" , ColorType ] , ColorspaceParamsType , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <hdr-color()> *)
HdrColorFn = "color-hdr" , "(" , HdrColorFnItem , "," , HdrColorFnItem , ")" ;

(* <superellipse()> *)
SuperellipseFn = "superellipse" , "(" , ( NumberType | "infinity" | "-infinity" ) , ")" ;

(* <linear()> *)
LinearFn = "linear" , "(" , LinearFnItem , { "," , LinearFnItem } , ")" ;

(* <cubic-bezier()> *)
CubicBezierFn = "cubic-bezier" , "(" , CubicBezierFnItem , "," , CubicBezierFnItem , ")" ;

(* <steps()> *)
StepsFn = "steps" , "(" , IntegerType , "," , [ StepPositionType ] , ")" ;

(* <blur()> *)
BlurFn = "blur" , "(" , [ LengthType ] , ")" ;

(* <brightness()> *)
BrightnessFn = "brightness" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <contrast()> *)
ContrastFn = "contrast" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <drop-shadow()> *)
DropShadowFn = "drop-shadow" , "(" ,
    ( [ ColorType ] , LengthType , LengthType , [ LengthType ]
    | LengthType , LengthType , [ LengthType ] , ColorType ) ,
    ")" ;

(* <grayscale()> *)
GrayscaleFn = "grayscale" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <hue-rotate()> *)
HueRotateFn = "hue-rotate" , "(" , [ ( AngleType | "0" ) ] , ")" ;

(* <invert()> *)
InvertFn = "invert" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <opacity()> *)
OpacityFn = "opacity" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <sepia()> *)
SepiaFn = "sepia" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <saturate()> *)
SaturateFn = "saturate" , "(" , [ ( FilterAmountType | PercentageType ) ] , ")" ;

(* <linear-gradient()> *)
LinearGradientFn = "linear-gradient" , "(" , LinearGradientSyntaxType , ")" ;

(* <repeating-linear-gradient()> *)
RepeatingLinearGradientFn = "repeating-linear-gradient" , "(" , LinearGradientSyntaxType , ")" ;

(* <radial-gradient()> *)
RadialGradientFn = "radial-gradient" , "(" , RadialGradientSyntaxType , ")" ;

(* <repeating-radial-gradient()> *)
RepeatingRadialGradientFn = "repeating-radial-gradient" , "(" , RadialGradientSyntaxType , ")" ;

(* <conic-gradient()> *)
ConicGradientFn = "conic-gradient" , "(" , ConicGradientSyntaxType , ")" ;

(* <repeating-conic-gradient()> *)
RepeatingConicGradientFn = "repeating-conic-gradient" , "(" , ConicGradientSyntaxType , ")" ;

(* <image()> — [ <image-src>? , <color>? ]! : at least one of src or color must be present;
   comma only appears when both are present. *)
ImageFn = "image" , "(" ,
    [ ImageTagsType ] ,
    ( ImageSrcType | ColorType | ( ImageSrcType , "," , ColorType ) ) ,
    ")" ;

(* <image-set()> *)
ImageSetFn = "image-set" , "(" , ImageSetOptionType , { "," , ImageSetOptionType } , ")" ;

(* <cross-fade()> *)
CrossFadeFn = "cross-fade" , "(" , CfImageType , { "," , CfImageType } , ")" ;

(* <element()> *)
ElementFn = "element" , "(" , IdSelectorType , ")" ;

(* scale3d( [ <number> | <percentage> ]#{3} ) *)
Scale3dFn =
  "scale3d" , "(" ,
    ( ScaleFactorType | PercentageType ) , "," ,
    ( ScaleFactorType | PercentageType ) , "," ,
    ( ScaleFactorType | PercentageType ) ,
  ")" ;

(* scale( <number> , <number>? ) *)
ScaleFn = "scale" , "(" , ScaleFactorType , [ "," , ScaleFactorType ] , ")" ;

(* scaleX( <number> ) *)
ScalexFn = "scaleX" , "(" , ScaleFactorType , ")" ;

(* scaleY( <number> ) *)
ScaleyFn = "scaleY" , "(" , ScaleFactorType , ")" ;

(* scaleZ( [ <number> | <percentage> ] ) *)
ScalezFn = "scaleZ" , "(" , ( ScaleFactorType | PercentageType ) , ")" ;

(* translate3d( <length-percentage> , <length-percentage> , <length> ) *)
Translate3dFn =
  "translate3d" , "(" ,
    LengthPercentageType , "," ,
    LengthPercentageType , "," ,
    LengthType ,
  ")" ;

(* translate( <length-percentage> , <length-percentage>? ) *)
TranslateFn = "translate" , "(" , LengthPercentageType , [ "," , LengthPercentageType ] , ")" ;

(* translateX( <length-percentage> ) *)
TranslatexFn = "translateX" , "(" , LengthPercentageType , ")" ;

(* translateY( <length-percentage> ) *)
TranslateyFn = "translateY" , "(" , LengthPercentageType , ")" ;

(* translateZ( <length> ) *)
TranslatezFn = "translateZ" , "(" , LengthType , ")" ;

(* rotate3d( <number> , <number> , <number> , [ <angle> | <0> ] ) *)
Rotate3dFn =
  "rotate3d" , "(" ,
    NumberType , "," , NumberType , "," , NumberType , "," ,
    ( AngleType | "0" ) ,
  ")" ;

(* rotate( [ <angle> | <0> ] ) *)
RotateFn = "rotate" , "(" , ( AngleType | MathFunctionType | "0" ) , ")" ;

(* rotateX( [ <angle> | <0> ] ) *)
RotatexFn = "rotateX" , "(" , ( AngleType | MathFunctionType | "0" ) , ")" ;

(* rotateY( [ <angle> | <0> ] ) *)
RotateyFn = "rotateY" , "(" , ( AngleType | MathFunctionType | "0" ) , ")" ;

(* rotateZ( [ <angle> | <0> ] ) *)
RotatezFn = "rotateZ" , "(" , ( AngleType | MathFunctionType | "0" ) , ")" ;

(* skew( [ <angle> | <0> ] , [ <angle> | <0> ]? ) *)
SkewFn = "skew" , "(" , ( AngleType | MathFunctionType | "0" ) , [ "," , ( AngleType | MathFunctionType | "0" ) ] , ")" ;

(* skewX( [ <angle> | <0> ] ) *)
SkewxFn = "skewX" , "(" , ( AngleType | MathFunctionType | "0" ) , ")" ;

(* skewY( [ <angle> | <0> ] ) *)
SkewyFn = "skewY" , "(" , ( AngleType | MathFunctionType | "0" ) , ")" ;

(* matrix3d( <number>#{16} ) — 4×4 homogeneous matrix, 16 comma-separated numbers *)
Matrix3dFn =
  "matrix3d" , "(" ,
    NumberType , "," , NumberType , "," , NumberType , "," , NumberType , "," ,
    NumberType , "," , NumberType , "," , NumberType , "," , NumberType , "," ,
    NumberType , "," , NumberType , "," , NumberType , "," , NumberType , "," ,
    NumberType , "," , NumberType , "," , NumberType , "," , NumberType ,
  ")" ;

(* matrix( <number>#{6} ) — 2D homogeneous matrix, 6 comma-separated numbers *)
MatrixFn =
  "matrix" , "(" ,
    NumberType , "," , NumberType , "," ,
    NumberType , "," , NumberType , "," ,
    NumberType , "," , NumberType ,
  ")" ;

(* perspective( [ <length [0,∞]> | none ] ) *)
PerspectiveFn = "perspective" , "(" , ( LengthType | "none" ) , ")" ;

(* inset( <length-percentage>{1,4} [ round <border-radius> ]? ) *)
InsetFn = "inset" , "(" ,
    LengthPercentageType , [ LengthPercentageType ] , [ LengthPercentageType ] , [ LengthPercentageType ] ,
    [ "round" , BorderRadiusType ] ,
  ")" ;

(* circle( <radial-size>? [ at <position> ]? ) *)
CircleFn = "circle" , "(" , [ ShapeRadiusType ] , [ "at" , PositionType ] , ")" ;

(* ellipse( <shape-radius>{2}? [ at <position> ]? ) *)
EllipseFn = "ellipse" , "(" , [ ShapeRadiusType , ShapeRadiusType ] , [ "at" , PositionType ] , ")" ;

(* polygon( <fill-rule>? [ round <length> ]? , [ <length-percentage> <length-percentage> ]# ) *)
PolygonFn = "polygon" , "(" ,
    [ FillRuleType , "," ] , [ "round" , LengthType , "," ] ,
    LengthPercentageType , LengthPercentageType , { "," , LengthPercentageType , LengthPercentageType } ,
  ")" ;

(* path( <fill-rule>? , <string> )  — comma only present when fill-rule given *)
PathFn = "path" , "(" , [ FillRuleType , "," ] , string_type , ")" ;

(* rect( [ <length-percentage> | auto ]{4} [ round <border-radius> ]? ) *)
LegacyRectSyntaxType = "rect" , "(" , ClipRectEdgesType , ")" ;

RectFn = LegacyRectSyntaxType
    | "rect" , "(" ,
        ( LengthPercentageType | "auto" ) , ( LengthPercentageType | "auto" ) ,
        ( LengthPercentageType | "auto" ) , ( LengthPercentageType | "auto" ) ,
        [ "round" , BorderRadiusType ] ,
      ")" ;

(* xywh( <length-percentage>{2} <length-percentage>{2} [ round <border-radius> ]? ) *)
XywhFn = "xywh" , "(" ,
    LengthPercentageType , LengthPercentageType ,
    LengthPercentageType , LengthPercentageType ,
    [ "round" , BorderRadiusType ] ,
  ")" ;

(* ── shape() ─────────────────────────────────────────────────────────────── *)

(* shape( <fill-rule>? from <position> , <shape-command># ) *)
ShapeFn = "shape" , "(" ,
    [ FillRuleType ] , "from" , PositionType , "," ,
    ShapeCommandType , { "," , ShapeCommandType } ,
  ")" ;


(* ── Math functions ─────────────────────────────────────────────────────── *)

(* abs( <calc-sum> ) *)
AbsFn = "abs" , "(" , CalcSumType , ")" ;

(* acos( <calc-sum> ) *)
AcosFn = "acos" , "(" , CalcSumType , ")" ;

(* asin( <calc-sum> ) *)
AsinFn = "asin" , "(" , CalcSumType , ")" ;

(* atan( <calc-sum> ) *)
AtanFn = "atan" , "(" , CalcSumType , ")" ;

(* atan2( <calc-sum> , <calc-sum> ) *)
Atan2Fn = "atan2" , "(" , CalcSumType , "," , CalcSumType , ")" ;

(* calc( <calc-sum> ) *)
CalcFn = "calc" , "(" , CalcSumType , ")" ;

(* clamp( [ <calc-sum> | none ] , <calc-sum> , [ <calc-sum> | none ] ) *)
ClampFn = "clamp" , "(" , ( CalcSumType | "none" ) , "," , CalcSumType , "," , ( CalcSumType | "none" ) , ")" ;

(* cos( <calc-sum> ) *)
CosFn = "cos" , "(" , CalcSumType , ")" ;

(* exp( <calc-sum> ) *)
ExpFn = "exp" , "(" , CalcSumType , ")" ;

(* hypot( <calc-sum># ) *)
HypotFn = "hypot" , "(" , CalcSumType , { "," , CalcSumType } , ")" ;

(* log( <calc-sum> , <calc-sum>? ) *)
LogFn = "log" , "(" , CalcSumType , [ "," , CalcSumType ] , ")" ;

(* max( <calc-sum># ) *)
MaxFn = "max" , "(" , CalcSumType , { "," , CalcSumType } , ")" ;

(* min( <calc-sum># ) *)
MinFn = "min" , "(" , CalcSumType , { "," , CalcSumType } , ")" ;

(* mod( <calc-sum> , <calc-sum> ) *)
ModFn = "mod" , "(" , CalcSumType , "," , CalcSumType , ")" ;

(* pow( <calc-sum> , <calc-sum> ) *)
PowFn = "pow" , "(" , CalcSumType , "," , CalcSumType , ")" ;

(* progress( <calc-sum> , <calc-sum> , <calc-sum> ) *)
ProgressFn = "progress" , "(" , CalcSumType , "," , CalcSumType , "," , CalcSumType , ")" ;

(* rem( <calc-sum> , <calc-sum> ) *)
RemFn = "rem" , "(" , CalcSumType , "," , CalcSumType , ")" ;

(* round( <rounding-strategy>? , <calc-sum> , <calc-sum>? )
   <rounding-strategy> = nearest | up | down | to-0 | line-width *)
RoundingStrategyType = "nearest" | "up" | "down" | "to-zero" | "line-width" ;
RoundFn = "round" , "(" , [ RoundingStrategyType , "," ] , CalcSumType , [ "," , CalcSumType ] , ")" ;

(* sign( <calc-sum> ) *)
SignFn = "sign" , "(" , CalcSumType , ")" ;

(* sin( <calc-sum> ) *)
SinFn = "sin" , "(" , CalcSumType , ")" ;

(* sqrt( <calc-sum> ) *)
SqrtFn = "sqrt" , "(" , CalcSumType , ")" ;

(* tan( <calc-sum> ) *)
TanFn = "tan" , "(" , CalcSumType , ")" ;


(* ── Sizing / layout functions ──────────────────────────────────────────── *)

(* anchor( <anchor-name>? && <anchor-side> , <length-percentage>? )
   <anchor-name> = <dashed-ident>
   <anchor-side> = inside | outside | top | left | right | bottom | start | end
                 | self-start | self-end | <percentage> | center
   Note: && allows any order; grammar places optional anchor-name before anchor-side *)
AnchorSideType = "inside" | "outside" | "top" | "left" | "right" | "bottom" | "start" | "end"
                 | "self-start" | "self-end" | percentage_type | "center" ;
AnchorFn = "anchor" , "(" , [ dashed_ident_type ] , AnchorSideType , [ "," , LengthPercentageType ] , ")" ;

(* anchor-size( [ <anchor-name> || <anchor-size-dimension> ]? , <length-percentage>? )
   <anchor-size-dimension> = width | height | block | inline | self-block | self-inline
   Note: || means one or both in any order; grammar places anchor-name before dimension *)
AnchorDimType = "width" | "height" | "block" | "inline" | "self-block" | "self-inline" ;
AnchorSizeFn = "anchor-size" , "(" , [ dashed_ident_type ] , [ AnchorDimType ] , [ "," , LengthPercentageType ] , ")" ;

(* calc-size( <calc-size-basis> , <calc-sum> )
   <calc-size-basis> = <size-keyword> | <calc-size()> | any | <calc-sum>
   <size-keyword>    = auto | min-content | max-content | fit-content | contain | stretch *)
SizeKeywordType = "auto" | "min-content" | "max-content" | "fit-content" | "contain" | "stretch" ;
CalcSizeBasisType = SizeKeywordType | CalcSizeFn | "any" | CalcSumType ;
CalcSizeFn = "calc-size" , "(" , CalcSizeBasisType , "," , CalcSumType , ")" ;

(* env( <custom-ident> <integer [0,∞]>* , <declaration-value>? )
   <declaration-value>: any sequence of CSS component values, stopping before { } ;

   Two variants:
   - DeclarationValueType: includes ( and ) — used in free-form positions like
     MediaQueryListType where parens are just value tokens, not structure.
   - DeclarationValueInParensType: excludes ) — used inside explicit "(" ... ")"
     wrappers (SupportsDeclType, QueryInParensType, etc.) so the structural )
     is not consumed by the greedy repetition. *)
(* Scalar token alternatives shared by both declaration-value variants.
   Does not include ( or ) — parens are handled structurally. *)
DeclarationValueTokenType = ident_type | number_type | percentage_type | length_type
                           | time_type | angle_type | frequency_type | resolution_type
                           | string_type | hex_color_type | dashed_ident_type
                           | "," | "/" | ":"
                           | "=" | "*" | "-"
                           | "+" | "<" | ">"
                           | "!" ;

(* Balanced parenthesis group: ( <declaration-value-in-parens> ) — allows nesting. *)
DeclarationValueParenGroupType = "(" , DeclarationValueInParensType , ")" ;

(* Used inside explicit "(" … ")" wrappers (SupportsDeclType, QueryInParensType, etc.)
   Handles nested function calls via the recursive paren-group alternative. *)
DeclarationValueInParensType = { DeclarationValueTokenType | DeclarationValueParenGroupType } ;

(* Free-form variant: includes bare ( and ) as flat tokens.
   Used where parens are just part of the value stream (e.g. MediaQueryListType). *)
DeclarationValueType = { DeclarationValueTokenType | "(" | ")" } ;
EnvFn = "env" , "(" , custom_ident_type , { IntegerType } , [ "," , ( length_type | percentage_type | number_type ) ] , ")" ;

(* fit-content( <length-percentage> ) *)
FitContentFn = "fit-content" , "(" , LengthPercentageType , ")" ;

(* minmax( <inflexible-breadth> , <track-breadth> )
   <track-breadth>      = <length-percentage> | <flex> | min-content | max-content | auto
   <inflexible-breadth> = <length-percentage> | min-content | max-content | auto
   <fixed-breadth>      = <length-percentage> *)
TrackBreadthType = LengthPercentageType | NonNegativeFlexType | "min-content" | "max-content" | "auto" ;
InflexibleBreadthType = LengthPercentageType | "min-content" | "max-content" | "auto" ;
FixedBreadthType = LengthPercentageType ;
MinmaxFn = "minmax" , "(" , ( InflexibleBreadthType | FixedBreadthType ) , "," , TrackBreadthType , ")" ;

(* repeat( ... ) — three forms for CSS Grid track lists
   track-repeat: repeat( <integer [1,∞]> , [ <line-names>? <track-size> ]+ <line-names>? )
   auto-repeat:  repeat( auto-fill | auto-fit , [ <line-names>? <track-size> ]+ <line-names>? )
   name-repeat:  repeat( <integer [1,∞]> | auto-fill , <line-names>+ )
   <track-size>  = <track-breadth> | minmax(...) | fit-content(...)
   <line-names>  = '[' <custom-ident>* ']' *)
TrackSizeType = TrackBreadthType | MinmaxFn | FitContentFn ;
(* <line-names> = '[' <custom-ident>* ']' — the empty "[ ]" form is pointless (it
   equals no line-names, already covered by the surrounding optional), so require at
   least one name; brackets then only ever appear WITH a value. *)
LineNamesType = "[" , custom_ident_type , { custom_ident_type } , "]" ;
TrackRepeatFn = "repeat" , "(" , IntegerType , "," ,
    { LineNamesType } , TrackSizeType , { [ LineNamesType ] , TrackSizeType } , { LineNamesType } , ")" ;
AutoRepeatFn = "repeat" , "(" , ( "auto-fill" | "auto-fit" ) , "," ,
    { LineNamesType } , TrackSizeType , { LineNamesType , TrackSizeType } , { LineNamesType } , ")" ;
NameRepeatFn = "repeat" , "(" , ( IntegerType | "auto-fill" ) , "," , LineNamesType , { LineNamesType } , ")" ;
RepeatFn = TrackRepeatFn | AutoRepeatFn | NameRepeatFn ;

(* scroll( [ <scroller> || <axis> ]? )
   <scroller> = root | nearest | self
   Note: || means one or both in any order *)
ScrollerType = "root" | "nearest" | "self" ;
ScrollFn = "scroll" , "(" , [ ScrollerType ] , [ AxisType ] , ")" ;

(* view( [ <axis> || <view-timeline-inset> ]? )
   <view-timeline-inset> = [ auto | <length-percentage> ]{1,2}
   Note: || means one or both in any order *)
ViewTimelineInsetType = ( "auto" | LengthPercentageType ) , [ "auto" | LengthPercentageType ] ;
ViewFn = "view" , "(" , [ AxisType ] , [ ViewTimelineInsetType ] , ")" ;


(* ── Color functions ─────────────────────────────────────────────────────── *)

(* dynamic-range-limit-mix( [ <'dynamic-range-limit'> && <percentage [0,100]> ]#{2,} )
   <dynamic-range-limit> = standard | no-limit | constrained | <dynamic-range-limit-mix()> *)
DynamicRangeLimitType = "standard" | "no-limit" | "constrained" | DynamicRangeLimitMixFn ;
DynamicRangeLimitMixItem = DynamicRangeLimitType , PercentageType ;
DynamicRangeLimitMixFn = "dynamic-range-limit-mix" , "(" ,
    DynamicRangeLimitMixItem , "," , DynamicRangeLimitMixItem ,
    { "," , DynamicRangeLimitMixItem } ,
  ")" ;

(* light-dark( <color> , <color> )            — color variant *)
LightDarkColorFn = "light-dark" , "(" , ColorType , "," , ColorType , ")" ;

(* light-dark( [ <image> | none ] , [ <image> | none ] ) — image variant *)
LightDarkImageFn = "light-dark" , "(" , ( ImageType | "none" ) , "," , ( ImageType | "none" ) , ")" ;

(* palette-mix( <color-interpolation-method> , [ palette-entry && <percentage [0,100]>? ]#{2} )
   palette-entry = normal | light | dark | <palette-identifier> | <palette-mix()>
   <palette-identifier> = <dashed-ident>
   Note: && allows any order; grammar places entry before percentage *)
PaletteEntryType = "normal" | "light" | "dark" | dashed_ident_type | PaletteMixFn ;
PaletteMixItem = PaletteEntryType , [ PercentageType ] ;
PaletteMixFn = "palette-mix" , "(" , ColorInterpolationMethodType , "," ,
    PaletteMixItem , "," , PaletteMixItem ,
  ")" ;


(* ── Content / value functions ───────────────────────────────────────────── *)

(* attr( <attr-name> <attr-type>? , <declaration-value>? )
   <attr-name>  = [ <ident> '|' ]? <ident>
   <attr-type>  = type( <syntax> ) | raw-string | number | <custom-ident>
   <syntax>     = complex typed-OM syntax string; approximated as string_literal *)
AttrNameType = [ ident_type , "|" ] , ident_type ;
AttrTypeType = TypeFn | "raw-string" | "number" | custom_ident_type ;
AttrFn = "attr" , "(" , AttrNameType , [ AttrTypeType ] , [ "," , DeclarationValueInParensType ] , ")" ;

(* counter( <counter-name> , <counter-style>? )
   <counter-name>        = <custom-ident>
   <counter-style>       = <counter-style-name> | <symbols()>
   <counter-style-name>  = <custom-ident> *)
CounterStyleType = custom_ident_type | SymbolsFn ;
CounterFn = "counter" , "(" , custom_ident_type , [ "," , CounterStyleType ] , ")" ;

(* counters( <counter-name> , <string> , <counter-style>? ) *)
CountersFn = "counters" , "(" , custom_ident_type , "," , string_type , [ "," , CounterStyleType ] , ")" ;

(* layer( <layer-name> )
   <layer-name> = <ident> [ '.' <ident> ]* *)
LayerNameType = ident_type , { "." , ident_type } ;
LayerFn = "layer" , "(" , LayerNameType , ")" ;

(* paint( <ident> , <declaration-value>? ) *)
PaintFn = "paint" , "(" , ident_type , [ "," , DeclarationValueTokenType ] , ")" ;

(* symbols( <symbols-type>? [ <string> | <image> ]+ )
   <symbols-type> = cyclic | numeric | alphabetic | symbolic | fixed *)
SymbolsFn = "symbols" , "(" , [ "cyclic" | "numeric" | "alphabetic" | "symbolic" | "fixed" ] , ( string_type | ImageType ) , { string_type | ImageType } , ")" ;

(* type( <string> ) *)
TypeFn = "type" , "(" , string_type , ")" ;

(* url( <string> <url-modifier>* ) | <url-token>
   url-modifier and url-token are low-level CSS token forms; simplified to string argument *)
UrlFn = "url" , "(" , string_type , ")" ;

(* var( <custom-Property-name> , <declaration-value>? )
   <custom-Property-name> = --<ident>  (same form as <dashed-ident>) *)
(* Fallback for var(): contextually-safe CSS value types only.
   Per spec, <declaration-value> allows any token except ), ], }, ;, ! but types
   like ident, time, angle, and string produce invalid fallbacks for most properties. *)
VarFallbackType = number_type | percentage_type | length_type | hex_color_type ;
VarFn = "var" , "(" , dashed_ident_type , [ "," , VarFallbackType ] , ")" ;

(* Typed var() wrappers — the fallback must be valid for the typed slot the var()
   sits in. The generic VarFn above used a number fallback (e.g. 0.5) which is
   invalid in length/integer/angle/time contexts (a bare number is not a length).
   These give var() a context-correct fallback so the declaration is never
   dropped when the custom property is undefined. *)
LengthVarFn            = "var" , "(" , dashed_ident_type , [ "," , length_type ] , ")" ;
LengthPercentageVarFn  = "var" , "(" , dashed_ident_type , [ "," , ( length_type | percentage_type ) ] , ")" ;
PercentageVarFn        = "var" , "(" , dashed_ident_type , [ "," , percentage_type ] , ")" ;
IntegerVarFn           = "var" , "(" , dashed_ident_type , [ "," , integer_type ] , ")" ;
NumberVarFn            = "var" , "(" , dashed_ident_type , [ "," , number_type ] , ")" ;
AngleVarFn             = "var" , "(" , dashed_ident_type , [ "," , angle_type ] , ")" ;
TimeVarFn              = "var" , "(" , dashed_ident_type , [ "," , time_type ] , ")" ;


(* ── Animation / motion functions ────────────────────────────────────────── *)

(* random( <random-key>? , <calc-sum> , <calc-sum> , <calc-sum>? )
   <random-key>       = auto | <random-cache-key> | fixed <number [0,1]>
   <random-cache-key> = <dashed-ident> || element-scoped
                      || [ Property-scoped | Property-index-scoped | <custom-ident> ] *)
RandomCacheKeyType = dashed_ident_type | "element-scoped" | "property-scoped" | "property-index-scoped" | custom_ident_type ;
RandomKeyType = "auto" | RandomCacheKeyType | ( "fixed" , NumberType ) ;
RandomFn = "random" , "(" , [ RandomKeyType , "," ] , CalcSumType , "," , CalcSumType , [ "," , CalcSumType ] , ")" ;

(* ray( <angle> && <ray-size>? && contain? && [ at <position> ]? )
   <ray-size> = <radial-extent> | sides
   Note: && allows any order; grammar approximates angle-first canonical order *)
RaySizeType = RadialExtentType | "sides" ;
RayFn = "ray" , "(" , AngleType , [ RaySizeType ] , [ "contain" ] , [ "at" , PositionType ] , ")" ;
