(* <number> CSS type: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/number *)
number_type = fraction , [ "e" , integer_type ] ;
fraction = integer_type , [ "." , whole_number ] | [ "+" | "-" ] , "." , whole_number ;   (* .5 and -.5 are legal *)

(* <integer> CSS type: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/integer*)
integer_type = [ "+" | "-" ], whole_number ;

(* <percentage> CSS type: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/percentage *)
percentage_type = number_type , "%" ;

(* <length> CSS type: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/length *)
length_type = "0" | length_number ;
length_number = number_type , length_unit ;

length_unit = font_relative_length_unit
            | root_font_relative_length_unit
            | viewport_length_unit
            | container_query_length_unit
            | absolute_length_unit ;

font_relative_length_unit = "cap" | "ch" | "em" | "ex" | "ic" | "lh" ;

root_font_relative_length_unit = "rcap" | "rch" | "rem" | "rex" | "ric" | "rlh" ;

viewport_length_unit = default_viewport_length_unit
                     | small_viewport_length_unit
                     | large_viewport_length_unit
                     | dynamic_viewport_length_unit ;

viewport_length_suffix = "h" | "w" | "max" | "min" | "b" | "i" ;

default_viewport_length_unit = "v" , viewport_length_suffix ;

small_viewport_length_unit   = "s" , "v" , viewport_length_suffix ;

large_viewport_length_unit   = "l" , "v" , viewport_length_suffix ;

dynamic_viewport_length_unit = "d" , "v" , viewport_length_suffix ;

container_query_length_unit = "cqw" | "cqh" | "cqi" | "cqb" | "cqmin" | "cqmax" ;

absolute_length_unit = "px" | "cm" | "mm" | "Q" | "in" | "pc" | "pt" ;

(* <time> CSS type: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/time *)
time_type = number_type , time_unit ;
time_unit = "s" | "ms" ;

(* ── Range-qualified type aliases ───────────────────────────────────────────
   These parallel the base types above but encode the sign constraint from
   CSS VDS range annotations directly in the grammar rather than relying on
   runtime validation.

   [0,∞]  → non_negative_*  : leading minus not permitted (plus sign still allowed)
   [1,∞]  → positive_*      : leading minus not permitted; zero not permitted
                               (uses natural_number = non_zero , { digit } from primitive.ebnf)
   [-∞,-1] → negative_*     : leading minus required; zero not permitted

   Upper-bound ranges ([0,1], [0,100], [-90deg,90deg], [2,4], [1,1000]) cannot
   be expressed in a CFG and remain runtime-only constraints.
   ──────────────────────────────────────────────────────────────────────── *)

(* [0,∞] non-negative integer — <integer [0,∞]> *)
non_negative_integer_type = [ "+" ] , whole_number ;

(* [0,∞] non-negative number — <number [0,∞]> *)
non_negative_fraction    = non_negative_integer_type , [ "." , whole_number ] | "." , whole_number ;
non_negative_number_type = non_negative_fraction , [ "e" , integer_type ] ;

(* [0,∞] non-negative length — <length [0,∞]> *)
non_negative_length_type = "0" | ( non_negative_number_type , length_unit ) ;

(* [0,∞] non-negative percentage — <percentage [0,∞]> *)
non_negative_percentage_type = non_negative_number_type , "%" ;

(* [0,∞] non-negative flex — <flex [0,∞]> *)
non_negative_flex_type = non_negative_number_type , "fr" ;

(* [0s,∞] non-negative time — <time [0s,∞]> *)
non_negative_time_type = non_negative_number_type , time_unit ;

(* [1,∞] positive integer — <integer [1,∞]>
   natural_number (non_zero , { digit }) is defined in primitive.ebnf *)
positive_integer_type = [ "+" ] , natural_number ;

(* [-∞,-1] negative integer — <integer [-∞,-1]> *)
negative_integer_type = "-" , natural_number ;

(* <length-percentage [0,∞]> — composite non-negative length-or-percentage.
   Math functions (calc, min, max, …) are included: their sign cannot be known
   at parse time, so they are accepted here and validated at runtime. *)
NonNegativeLengthPercentageType = NonNegativeLengthType | NonNegativePercentageType
                                | MathFunctionType | EnvFn ;

(* ── VarFn-lifting wrappers ──────────────────────────────────────────────────
   These syntactic (PascalCase) wrappers allow var() to substitute any typed
   primitive value position in property-value rules.  The CSS spec permits
   var() to replace "any part of a value of another property", so every typed
   position in a syntactic rule should accept it.

   Rule: use these wrappers *only* inside other syntactic (PascalCase) rules.
   Never replace primitive refs inside lowercase (lexical) rules.
   ──────────────────────────────────────────────────────────────────────────── *)
NumberType              = number_type | NumberVarFn ;
IntegerType             = integer_type | IntegerVarFn ;
NonNegativeIntegerType  = non_negative_integer_type | IntegerVarFn ;
NonNegativeNumberType   = non_negative_number_type | NumberVarFn ;
NonNegativeLengthType   = non_negative_length_type | LengthVarFn ;
NonNegativePercentageType = non_negative_percentage_type | PercentageVarFn ;
NonNegativeFlexType     = non_negative_flex_type | VarFn ;
NonNegativeTimeType     = non_negative_time_type | TimeVarFn ;
AngleType               = angle_type | AngleVarFn ;
TimeType                = time_type | TimeVarFn ;
FrequencyType           = frequency_type | VarFn ;
ResolutionType          = resolution_type | VarFn ;
FlexType                = flex_type | VarFn ;
LengthType              = length_type | LengthVarFn ;
PercentageType          = percentage_type | PercentageVarFn ;

(* Range-constrained scalar wrappers. The CFG cannot encode upper-bound ranges
   (see the range note above), so these dedicated rules exist only to carry a
   range-safe representative sample (defined in cmd/gen/reps.go): oblique angle
   ∈ [-90deg,90deg], cubic-bezier control-point x ∈ [0,1], miterlimit ∈ [1,∞]. *)
ObliqueAngleType        = angle_type ;
CubicBezierProgressType = number_type ;
MiterlimitType          = number_type ;
(* initial-letter SIZE operand ∈ <number [1,∞]> — Chrome drops sizes < 1. *)
InitialLetterSizeType   = number_type ;
(* Dedicated <number> wrappers whose reps are VISIBLE (non-identity) samples, so the
   generated value actually changes the render instead of collapsing to the default:
   filter amounts (brightness(1)=identity → use 0.4/1.8), scale factors (scale(1)=
   identity → 2/0.5), font-weight numbers (1..5 are all ~thin → 100..900). All remain
   doc-valid <number>; only the representative sample differs (defined in cmd/gen/reps.go). *)
FilterAmountType        = number_type ;
ScaleFactorType         = number_type ;
FontWeightNumberType    = number_type ;

(* <absolute-size> CSS type: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/absolute-size *)
AbsoluteSizeType = "xx-small" | "x-small" | "small" | "medium" | "large" | "x-large" | "xx-large" | "xxx-large" ;

(* <alpha-value> *)
AlphaValueType = NumberType | PercentageType ;

(* <angle-percentage> *)
AnglePercentageType = AngleType | PercentageType ;

(* <axis> *)
AxisType = "block" | "inline" | "x" | "y" ;

(* <blend-mode> *)
BlendModeType = "normal" | "darken" | "multiply" | "color-burn" | "lighten" | "screen" | "color-dodge" | "overlay" | "soft-light" | "hard-light" | "difference" | "exclusion" | "hue" | "saturation" | "color" | "luminosity" ;

(* <color> *)
ColorType = ColorBaseType | "currentcolor" | SystemColorType | ContrastColorFn | DeviceCmykFn | LightDarkColorType | VarFn ;

(* <color-base> *)
ColorBaseType = hex_color_type | ColorFunctionType | NamedColorType | ColorMixFn | "transparent" ;

(* <system-color> *)
SystemColorType = "accentcolor" | "accentcolortext" | "activetext" | "buttonborder" | "buttonface" | "buttontext" | "canvas" | "canvastext" | "field" | "fieldtext" | "graytext" | "highlight" | "highlighttext" | "linktext" | "mark" | "marktext" | "selecteditem" | "selecteditemtext" | "visitedtext" | DeprecatedColorType ;

(* <light-dark-color> *)
LightDarkColorType = LightDarkColorFn ;

(* <color-function> *)
(* Order preserved from the original <color-function> list so colour properties
   regenerate identically. The HDR/wide-gamut research functions
   (ictcp/jzazbz/jzczhz/alpha, and color-hdr below) are in the <color> grammar
   (docs/syntax/datatypes.txt) but NOT implemented by Chrome — grouped into
   UnimplementedColorFunctionType so the UI can flag them; Chrome drops them, so
   properties that include them are category 3 (valid CSS rendered identically). *)
ColorFunctionType = RgbFn | RgbaFn | HslFn | HslaFn | HwbFn | LabFn | LchFn | OklabFn | OklchFn | UnimplementedColorFunctionType | ColorFn | HdrColorFn ;
UnimplementedColorFunctionType = IctcpFn | JzazbzFn | JzczhzFn | AlphaFn ;

(* <named-color> *)
NamedColorType = "aliceblue" | "antiquewhite" | "aqua" | "aquamarine" | "azure" | "beige" | "bisque" | "black" | "blanchedalmond" | "blue" | "blueviolet" | "brown" | "burlywood" | "cadetblue" | "chartreuse" | "chocolate" | "coral" | "cornflowerblue" | "cornsilk" | "crimson" | "cyan" | "darkblue" | "darkcyan" | "darkgoldenrod" | "darkgray" | "darkgreen" | "darkgrey" | "darkkhaki" | "darkmagenta" | "darkolivegreen" | "darkorange" | "darkorchid" | "darkred" | "darksalmon" | "darkseagreen" | "darkslateblue" | "darkslategray" | "darkslategrey" | "darkturquoise" | "darkviolet" | "deeppink" | "deepskyblue" | "dimgray" | "dimgrey" | "dodgerblue" | "firebrick" | "floralwhite" | "forestgreen" | "fuchsia" | "gainsboro" | "ghostwhite" | "gold" | "goldenrod" | "gray" | "green" | "greenyellow" | "grey" | "honeydew" | "hotpink" | "indianred" | "indigo" | "ivory" | "khaki" | "lavender" | "lavenderblush" | "lawngreen" | "lemonchiffon" | "lightblue" | "lightcoral" | "lightcyan" | "lightgoldenrodyellow" | "lightgray" | "lightgreen" | "lightgrey" | "lightpink" | "lightsalmon" | "lightseagreen" | "lightskyblue" | "lightslategray" | "lightslategrey" | "lightsteelblue" | "lightyellow" | "lime" | "limegreen" | "linen" | "magenta" | "maroon" | "mediumaquamarine" | "mediumblue" | "mediumorchid" | "mediumpurple" | "mediumseagreen" | "mediumslateblue" | "mediumspringgreen" | "mediumturquoise" | "mediumvioletred" | "midnightblue" | "mintcream" | "mistyrose" | "moccasin" | "navajowhite" | "navy" | "oldlace" | "olive" | "olivedrab" | "orange" | "orangered" | "orchid" | "palegoldenrod" | "palegreen" | "paleturquoise" | "palevioletred" | "papayawhip" | "peachpuff" | "peru" | "pink" | "plum" | "powderblue" | "purple" | "rebeccapurple" | "red" | "rosybrown" | "royalblue" | "saddlebrown" | "salmon" | "sandybrown" | "seagreen" | "seashell" | "sienna" | "silver" | "skyblue" | "slateblue" | "slategray" | "slategrey" | "snow" | "springgreen" | "steelblue" | "tan" | "teal" | "thistle" | "tomato" | "turquoise" | "violet" | "wheat" | "white" | "whitesmoke" | "yellow" | "yellowgreen" | "transparent" ;
ColorMixFnItem = ( ColorType , [ PercentageType ] ) ;

(* <deprecated-color> *)
DeprecatedColorType = "activeborder" | "activecaption" | "appworkspace" | "background" | "buttonhighlight" | "buttonshadow" | "captiontext" | "inactiveborder" | "inactivecaption" | "inactivecaptiontext" | "infobackground" | "infotext" | "menu" | "menutext" | "scrollbar" | "threeddarkshadow" | "threedface" | "threedhighlight" | "threedlightshadow" | "threedshadow" | "window" | "windowframe" | "windowtext" ;

(* <target-contrast> *)
TargetContrastType = Wcag2Type ;

(* <legacy-device-cmyk-syntax> *)
LegacyDeviceCmykSyntaxType = "device-cmyk" , "(" , NumberType , "," , NumberType , "," , NumberType , "," , NumberType , ")" ;

(* <modern-device-cmyk-syntax> *)
ModernDeviceCmykSyntaxType = "device-cmyk" , "(" , CmykComponentType , CmykComponentType , CmykComponentType , CmykComponentType , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;
HdrColorFnItem = ( ColorType , [ NumberType ] ) ;

(* <color-interpolation-method> *)
ColorInterpolationMethodType = "in" , ( RectangularColorSpaceType | PolarColorSpaceType , [ HueInterpolationMethodType ] | CustomColorSpaceType ) ;

(* <wcag2> *)
Wcag2Type = "wcag2" , [ "(" , ( NumberType | ( "aa" | "aaa" ) , [ "large" ] ) , ")" ] ;

(* <cmyk-component> *)
CmykComponentType = NumberType | PercentageType | "none" ;

(* <legacy-rgb-syntax> *)
LegacyRgbSyntaxType = "rgb" , "(" , PercentageType , "," , PercentageType , "," , PercentageType , "," , [ AlphaValueType ] , ")" | "rgb" , "(" , NumberType , "," , NumberType , "," , NumberType , "," , [ AlphaValueType ] , ")" ;

(* <modern-rgb-syntax> *)
ModernRgbSyntaxType = "rgb" , "(" , [ "from" , ColorType ] , ModernRgbSyntaxItem , ModernRgbSyntaxItem , ModernRgbSyntaxItem , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;
ModernRgbSyntaxItem = ( PercentageType | NumberType | "none" ) ;

(* <legacy-rgba-syntax> *)
LegacyRgbaSyntaxType = "rgba" , "(" , PercentageType , "," , PercentageType , "," , PercentageType , "," , [ AlphaValueType ] , ")" | "rgba" , "(" , NumberType , "," , NumberType , "," , NumberType , "," , [ AlphaValueType ] , ")" ;

(* <modern-rgba-syntax> *)
ModernRgbaSyntaxType = "rgba" , "(" , [ "from" , ColorType ] , ModernRgbaSyntaxItem , ModernRgbaSyntaxItem , ModernRgbaSyntaxItem , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;
ModernRgbaSyntaxItem = ( PercentageType | NumberType | "none" ) ;

(* <legacy-hsl-syntax> *)
LegacyHslSyntaxType = "hsl" , "(" , HueType , "," , PercentageType , "," , PercentageType , [ "," , AlphaValueType ] , ")" ;

(* <modern-hsl-syntax> *)
ModernHslSyntaxType = "hsl" , "(" , [ "from" , ColorType ] , ( HueType | "none" ) , ( PercentageType | NumberType | "none" ) , ( PercentageType | NumberType | "none" ) , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <legacy-hsla-syntax> *)
LegacyHslaSyntaxType = "hsla" , "(" , HueType , "," , PercentageType , "," , PercentageType , [ "," , AlphaValueType ] , ")" ;

(* <modern-hsla-syntax> *)
ModernHslaSyntaxType = "hsla" , "(" , [ "from" , ColorType ] , ( HueType | "none" ) , ( PercentageType | NumberType | "none" ) , ( PercentageType | NumberType | "none" ) , [ "/" , ( AlphaValueType | "none" ) ] , ")" ;

(* <hue> *)
HueType = AngleType | NumberType ;

(* <colorspace-params> *)
ColorspaceParamsType = CustomParamsType | PredefinedRgbParamsType | XyzParamsType ;

(* <rectangular-color-space> *)
RectangularColorSpaceType = "srgb" | "srgb-linear" | "display-p3" | "display-p3-linear" | "a98-rgb" | "prophoto-rgb" | "rec2020" | "lab" | "oklab" | XyzSpaceType ;

(* <polar-color-space> *)
PolarColorSpaceType = "hsl" | "hwb" | "lch" | "oklch" ;

(* <hue-interpolation-method> *)
HueInterpolationMethodType = ( "shorter" | "longer" | "increasing" | "decreasing" | VarFn ) , "hue" ;

(* <custom-color-space> *)
CustomColorSpaceType = dashed_ident_type ;

(* <custom-params> *)
CustomParamsType = dashed_ident_type , CustomParamsItem , { CustomParamsItem } ;
CustomParamsItem = ( NumberType | PercentageType | "none" ) ;

(* <predefined-rgb-params> *)
PredefinedRgbParamsType = PredefinedRgbType , PredefinedRgbParamsItem , PredefinedRgbParamsItem , PredefinedRgbParamsItem ;
PredefinedRgbParamsItem = ( NumberType | PercentageType | "none" ) ;

(* <xyz-params> *)
XyzParamsType = XyzSpaceType , XyzParamsItem , XyzParamsItem , XyzParamsItem ;
XyzParamsItem = ( NumberType | PercentageType | "none" ) ;

(* <xyz-space> *)
XyzSpaceType = "xyz" | "xyz-d50" | "xyz-d65" ;

(* <predefined-rgb> *)
PredefinedRgbType = "srgb" | "srgb-linear" | "display-p3" | "display-p3-linear" | "a98-rgb" | "prophoto-rgb" | "rec2020" | "rec2100-pq" | "rec2100-hlg" | "rec2100-linear" ;

(* <corner-shape-value> *)
CornerShapeValueType = "round" | "scoop" | "bevel" | "notch" | "square" | "squircle" | SuperellipseFn ;

(* <display-box> *)
DisplayBoxType = "contents" | "none" ;

(* <display-inside> *)
DisplayInsideType = "flow" | "flow-root" | "table" | "flex" | "grid" | "ruby" ;

(* <display-internal> *)
DisplayInternalType = "table-row-group" | "table-header-group" | "table-footer-group" | "table-row" | "table-cell" | "table-column-group" | "table-column" | "table-caption" | "ruby-base" | "ruby-text" | "ruby-base-container" | "ruby-text-container" ;

(* <display-legacy> *)
DisplayLegacyType = "inline-block" | "inline-table" | "inline-flex" | "inline-grid" ;

(* <display-listitem> *)
DisplayListitemType = [ DisplayOutsideType ] , [ ( "flow" | "flow-root" ) ] , "list-item" ;

(* <display-outside> *)
DisplayOutsideType = "block" | "inline" | "run-in" ;

(* <easing-function> *)
EasingFunctionType = LinearEasingFunctionType | CubicBezierEasingFunctionType | StepEasingFunctionType ;

(* <linear-easing-function> *)
LinearEasingFunctionType = "linear" | LinearFn ;

(* <cubic-bezier-easing-function> *)
CubicBezierEasingFunctionType = "ease" | "ease-in" | "ease-out" | "ease-in-out" | CubicBezierFn ;

(* <step-easing-function> *)
StepEasingFunctionType = "step-start" | "step-end" | StepsFn ;
LinearFnItem = ( NumberType , [ PercentageType ] , [ PercentageType ] ) ;
(* cubic-bezier( <x1> <y1> , <x2> <y2> ) — the control-point x (first of each
   pair) must be in [0,1]; y is unrestricted. *)
CubicBezierFnItem = CubicBezierProgressType , "," , NumberType ;

(* <step-position> *)
StepPositionType = "jump-start" | "jump-end" | "jump-none" | "jump-both" | "start" | "end" ;

(* <filter-function> *)
FilterFunctionType = BlurFn | BrightnessFn | ContrastFn | DropShadowFn | GrayscaleFn | HueRotateFn | InvertFn | OpacityFn | SepiaFn | SaturateFn ;

(* <frequency-percentage> *)
FrequencyPercentageType = FrequencyType | PercentageType ;

(* <generic-family> *)
GenericFamilyType = "serif" | "sans-serif" | "monospace" | "cursive" | "fantasy" | "system-ui" | "ui-serif" | "ui-sans-serif" | "ui-monospace" | "ui-rounded" | "math" | "fangsong" ;

(* <gradient> *)
GradientType = LinearGradientFn | RepeatingLinearGradientFn | RadialGradientFn | RepeatingRadialGradientFn | ConicGradientFn | RepeatingConicGradientFn ;

(* <linear-gradient-syntax> *)
LinearGradientDirection = AngleType | MathFunctionType | "0" | "to" , SideOrCornerType ;
LinearGradientSyntaxType =
    [ ( ( LinearGradientDirection , [ ColorInterpolationMethodType ]
        | ColorInterpolationMethodType , [ LinearGradientDirection ]
        ) , "," )
    ] , ColorStopListType ;

(* <radial-gradient-syntax> *)
RadialGradientHeader = ( [ RadialShapeType ] , [ RadialSizeType ] ) , [ "at" , PositionType ] ;
RadialGradientSyntaxType =
    [ ( ( RadialGradientHeader , [ ColorInterpolationMethodType ]
        | ColorInterpolationMethodType , [ RadialGradientHeader ]
        ) , "," )
    ] , ColorStopListType ;

(* <conic-gradient-syntax> *)
ConicGradientHeader = [ "from" , ( AngleType | MathFunctionType | "0" ) ] , [ "at" , PositionType ] ;
ConicGradientSyntaxType =
    [ ( ( ConicGradientHeader , [ ColorInterpolationMethodType ]
        | ColorInterpolationMethodType , [ ConicGradientHeader ]
        ) , "," )
    ] , AngularColorStopListType ;

(* <side-or-corner> *)
SideOrCornerType =
    ( "left" | "right" ) , [ ( "top" | "bottom" ) ]
    | ( "top" | "bottom" ) , [ ( "left" | "right" ) ] ;

(* <color-stop-list> *)
ColorStopListType = LinearColorStopType , { "," , [ LinearColorHintType , "," ] , LinearColorStopType } ;
ColorStopListItem = [ LinearColorHintType , "," ] , LinearColorStopType ;

(* <radial-shape> *)
RadialShapeType = "circle" | "ellipse" ;

(* <radial-size> *)
RadialSizeType = RadialExtentType | LengthType | LengthPercentageType , LengthPercentageType ;

(* <shape-radius> — for circle() and ellipse() *)
ShapeRadiusType = NonNegativeLengthPercentageType | "closest-side" | "farthest-side" ;

(* <position> *)
PositionType = PositionOneType | PositionTwoType | PositionFourType ;

(* <angular-color-stop-list> *)
AngularColorStopListType = AngularColorStopType , { "," , [ AngularColorHintType , "," ] , AngularColorStopType } ;
AngularColorStopListItem = [ AngularColorHintType , "," ] , AngularColorStopType ;

(* <linear-color-stop> *)
LinearColorStopType = ColorType , [ ColorStopLengthType ] ;

(* <linear-color-hint> *)
LinearColorHintType = LengthPercentageType ;

(* <radial-extent> *)
RadialExtentType = "closest-corner" | "closest-side" | "farthest-corner" | "farthest-side" ;

(* Math functions valid where a <length>/<dimension> is expected: only the
   type-preserving / length-resolving ones. Per CSS Values 4 the trig/number
   functions (sin cos tan asin acos atan atan2 exp log pow sign) resolve to a
   <number> or <angle>, never a <length>, so they are NOT valid as a bare
   length value and were previously emitted as invalid `sin(24px)` etc. (the
   generator can only feed them a length argument). They are omitted here so the
   grammar never produces a value Chrome drops. abs()/round()/min()/max()/
   clamp()/calc() preserve or compute the operand's type and stay. *)
MathFunctionType = CalcFn | ClampFn | MinFn | MaxFn | RoundFn | AbsFn ;
LengthPercentageType = length_type | percentage_type | MathFunctionType | LengthPercentageVarFn | EnvFn ;

(* <position-one> *)
PositionOneType = "left" | "center" | "right" | "top" | "bottom" | "x-start" | "x-end" | "y-start" | "y-end" | "block-start" | "block-end" | "inline-start" | "inline-end" | LengthPercentageType ;

(* <position-two> — horizontal then vertical, OR vertical then horizontal *)
PositionTwoType =
    ( "left" | "center" | "right" | "x-start" | "x-end" ) , ( "top" | "center" | "bottom" | "y-start" | "y-end" )
    | ( "top" | "center" | "bottom" | "y-start" | "y-end" ) , ( "left" | "center" | "right" | "x-start" | "x-end" )
    | ( "left" | "center" | "right" | "x-start" | "x-end" | LengthPercentageType ) , ( "top" | "center" | "bottom" | "y-start" | "y-end" | LengthPercentageType )
    | ( "top" | "center" | "bottom" | "y-start" | "y-end" | LengthPercentageType ) , ( "left" | "center" | "right" | "x-start" | "x-end" | LengthPercentageType )
    | ( "block-start" | "center" | "block-end" ) , ( "inline-start" | "center" | "inline-end" )
    | PositionTwoItem , PositionTwoItem ;
PositionTwoItem = ( "start" | "center" | "end" ) ;

(* <position-four> *)
PositionFourType = ( "left" | "right" | "x-start" | "x-end" ) , LengthPercentageType , ( "top" | "bottom" | "y-start" | "y-end" ) , LengthPercentageType | ( "block-start" | "block-end" ) , LengthPercentageType , ( "inline-start" | "inline-end" ) , LengthPercentageType | PositionFourItem , PositionFourItem ;
PositionFourItem = ( "start" | "end" ) , LengthPercentageType ;

(* <angular-color-stop> *)
AngularColorStopType = ColorType , [ ColorStopAngleType ] ;

(* <angular-color-hint> *)
AngularColorHintType = AnglePercentageType | "0" ;

(* <color-stop-length> *)
ColorStopLengthType = LengthPercentageType , [ LengthPercentageType ] ;

(* <color-stop-angle> *)
ColorStopAngleType = ColorStopAngleItem , [ ColorStopAngleItem ] ;
ColorStopAngleItem = ( AnglePercentageType | "0" ) ;

(* <image> *)
ImageType = UrlType | ImageFn | ImageSetFn | CrossFadeFn | ElementFn | GradientType | LightDarkImageFn ;

(* <image-tags> *)
ImageTagsType = "ltr" | "rtl" ;

(* <image-src> *)
ImageSrcType = UrlType | string_type ;

(* <image-set-option> *)
ImageSetOptionType = ( ImageType | string_type ) , [ ( [ ResolutionType ] , [ TypeFn ] ) ] ;

(* <cf-image> *)
CfImageType = ( ImageType | ColorType ) , [ PercentageType ] ;

(* <id-selector> *)
IdSelectorType = "#" , ident_type ;

(* <line-style> *)
LineStyleType = "solid" | "none" | "hidden" | "dotted" | "dashed" | "double" | "groove" | "ridge" | "inset" | "outset" ;

(* <ratio> *)
RatioType = NumberType , [ "/" , NumberType ] ;

(* <text-edge> *)
TextEdgeType = ( "text" | "ideographic" | "ideographic-ink" ) | ( "text" | "ideographic" | "ideographic-ink" | "cap" | "ex" ) , ( "text" | "ideographic" | "ideographic-ink" | "alphabetic" ) ;

(* <timeline-range-name> *)
TimelineRangeNameType = "cover" | "contain" | "entry" | "exit" | "entry-crossing" | "exit-crossing" ;

(* <time-percentage> *)
TimePercentageType = TimeType | PercentageType ;

(* <baseline-position> — [ first | last ]? && baseline *)
BaselinePositionType = [ ( "first" | "last" ) ] , "baseline" ;

(* <content-distribution> — space-between | space-around | space-evenly | stretch *)
ContentDistributionType = "space-between" | "space-around" | "space-evenly" | "stretch" ;

(* <content-position> — center | start | end | flex-start | flex-end *)
ContentPositionType = "center" | "start" | "end" | "flex-start" | "flex-end" ;

(* <overflow-position> — unsafe | safe *)
OverflowPositionType = "unsafe" | "safe" ;

(* <overflow> — visible | hidden | clip | scroll | auto *)
OverflowType = "visible" | "hidden" | "clip" | "scroll" | "auto" ;

(* <relative-size> — smaller | larger *)
RelativeSizeType = "smaller" | "larger" ;

(* <self-position> — center | start | end | self-start | self-end | flex-start | flex-end *)
SelfPositionType = "center" | "start" | "end" | "self-start" | "self-end" | "flex-start" | "flex-end" ;

(* <url> — url( <string> ) *)
UrlType = "url" , "(" , [ string_type | url_token_type ] , ")" ;

(* <url-set> — restricted image-set() where <image> is limited to <url> strings only.
   Per CSS UI Level 4, support for the broader <image> type is "allowed but optional",
   so aliasing to ImageSetFn (which accepts the full image-set syntax) is within spec.
   No MDN page exists; defined in drafts.csswg.org/css-ui-4/#cursor. *)
UrlSetType = ImageSetFn ;
VisualBoxType   = "content-box" | "padding-box" | "border-box" ;
ShapeBoxType    = VisualBoxType | "margin-box" ;
LayoutBoxType   = ShapeBoxType ;
PaintBoxType    = VisualBoxType | "fill-box" | "stroke-box" ;
CoordBoxType    = PaintBoxType | "view-box" ;
GeometryBoxType = ShapeBoxType | "fill-box" | "stroke-box" | "view-box" ;
BoxEdgeType     = GeometryBoxType | CoordBoxType ;
PositionAreaType =
    [ PositionAreaX ] , [ PositionAreaY ]
  | [ PositionAreaBlockKw ] , [ PositionAreaInlineKw ]
  | [ PositionAreaSelfBlockKw ] , [ PositionAreaSelfInlineKw ] ;

PositionAreaX =
  "left" | "center" | "right" | "span-left" | "span-right"
  | "x-start" | "x-end" | "span-x-start" | "span-x-end"
  | "self-x-start" | "self-x-end" | "span-self-x-start" | "span-self-x-end"
  | "span-all" ;

PositionAreaY =
  "top" | "center" | "bottom" | "span-top" | "span-bottom"
  | "y-start" | "y-end" | "span-y-start" | "span-y-end"
  | "self-y-start" | "self-y-end" | "span-self-y-start" | "span-self-y-end"
  | "span-all" ;

PositionAreaBlockKw =
  "block-start" | "center" | "block-end" | "span-block-start" | "span-block-end" | "span-all" ;

PositionAreaInlineKw =
  "inline-start" | "center" | "inline-end" | "span-inline-start" | "span-inline-end" | "span-all" ;

PositionAreaSelfBlockKw =
  "self-block-start" | "self-block-end" | "span-self-block-start" | "span-self-block-end" | "span-all" ;

PositionAreaSelfInlineKw =
  "self-inline-start" | "self-inline-end" | "span-self-inline-start" | "span-self-inline-end" | "span-all" ;

(* <angle> — <number> + angle unit; 0 is valid without unit *)
angle_type      = "0" | angle_value ;
angle_value = number_type , angle_unit ;
angle_unit = "deg" | "grad" | "rad" | "turn" ;

(* <dimension> — <number> immediately followed by a unit identifier (generic) *)
DimensionType = length_type | angle_type | time_type | frequency_type | resolution_type | flex_type ;

(* <flex> — <number> fr *)
flex_type = number_type , "fr" ;

(* <frequency> — <number> + Hz or kHz *)
frequency_type      = number_type , frequency_unit ;
frequency_unit = "Hz" | "kHz" ;

(* <resolution> — strictly positive <number> + unit *)
resolution_type      = number_type , resolution_unit ;
resolution_unit = "dpi" | "dpcm" | "dppx" | "x" ;

(* <calc-keyword> — numeric constants usable in CSS math functions *)
calc_keyword_type = "e" | "pi" | "infinity" | "-infinity" | "NaN" ;
ident_type     = ident_start , { ident_continue } ;
ident_start    = letter | "_" | "" ... "￿" | "𐀀" ... "􏿿" ;
ident_continue = letter | digit | "_" | "-" | "" ... "￿" | "𐀀" ... "􏿿" ;

(* <custom-ident> — user-defined, case-sensitive identifier (structurally same as ident) *)
custom_ident_type = ident_type ;

(* <dashed-ident> — custom Property name: two dashes followed by an identifier *)
dashed_ident_type = "--" , ident_type ;

(* <hex-color> — # followed by 3, 4, 6, or 8 hex digits (longest match first) *)
hex_color_type   = "#" , ( hex_color_8 | hex_color_6 | hex_color_4 | hex_color_3 ) ;
hex_color_3 = hex_digit , hex_digit , hex_digit ;
hex_color_4 = hex_digit , hex_digit , hex_digit , hex_digit ;
hex_color_6 = hex_digit , hex_digit , hex_digit , hex_digit , hex_digit , hex_digit ;
hex_color_8 = hex_digit , hex_digit , hex_digit , hex_digit
            , hex_digit , hex_digit , hex_digit , hex_digit ;

(* <string> — CSS quoted string; lexer-level primitive. *)
string_type = string_literal ;

(* <calc-sum> = <calc-product> [ [ '+' | '-' ] <calc-product> ]* *)
CalcSumType = CalcProductType , { ( "+" | "-" ) , CalcProductType } ;

(* <calc-product> = <calc-value> [ [ '*' | '/' ] <calc-value> ]* *)
CalcProductType = CalcValueType , { ( "*" | "/" ) , CalcValueType } ;

(* <calc-value> = <number> | <dimension> | <percentage> | <calc-keyword> | ( <calc-sum> )
   Browsers also allow var(), env(), anchor(), anchor-size(), and math functions as calc values
   via custom-property substitution, even though the formal BNF omits them. *)
(* DimensionType first so calc()/clamp()/min()/max() in the (dominant) length
   contexts resolve to a real length — calc(24px + 48px), not the unitless
   calc(1) — and the per-position cycling then varies the operands. *)
CalcValueType = DimensionType | percentage_type | number_type | calc_keyword_type
              | MathFunctionType | VarFn | EnvFn | AnchorFn | AnchorSizeFn
              | ( "(" , CalcSumType , ")" ) ;

(* <transform-list> *)
TransformListType = TransformFunctionType , { TransformFunctionType } ;

(* <transform-function> *)
TransformFunctionType =
    Scale3dFn | ScaleFn | ScalexFn | ScaleyFn | ScalezFn
  | Translate3dFn | TranslateFn | TranslatexFn | TranslateyFn | TranslatezFn
  | Rotate3dFn | RotateFn | RotatexFn | RotateyFn | RotatezFn
  | SkewFn | SkewxFn | SkewyFn
  | Matrix3dFn | MatrixFn
  | PerspectiveFn ;

(* <basic-shape> *)
BasicShapeType =
    InsetFn | CircleFn | EllipseFn | PolygonFn
  | PathFn | ShapeFn | RectFn | XywhFn ;

(* Shared: fill-rule and border-radius *)
FillRuleType = "nonzero" | "evenodd" ;

(* <border-radius> = <length-percentage [0,∞]>{1,4} [ / <length-percentage [0,∞]>{1,4} ]? *)
BorderRadiusType =
    NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] , [ NonNegativeLengthPercentageType ] , [ NonNegativeLengthPercentageType ]
  , [ "/" , NonNegativeLengthPercentageType , [ NonNegativeLengthPercentageType ] , [ NonNegativeLengthPercentageType ] , [ NonNegativeLengthPercentageType ] ] ;

(* <shape-command> *)
ShapeCommandType =
    MoveCommandType | LineCommandType | "close"
  | HorizontalLineCommandType | VerticalLineCommandType
  | CurveCommandType | SmoothCommandType | ArcCommandType ;

(* move <command-end-point> *)
MoveCommandType = "move" , CommandEndPointType ;

(* line <command-end-point> *)
LineCommandType = "line" , CommandEndPointType ;

(* <command-end-point> = to <position> | by <coordinate-pair> *)
CommandEndPointType = ( "to" , PositionType ) | ( "by" , CoordinatePairType ) ;
CoordinatePairType    = LengthPercentageType , LengthPercentageType ;

(* hline [ to [ <length-percentage> | left | center | right | x-start | x-end ] | by <length-percentage> ] *)
HorizontalLineCommandType = "hline" , (
    ( "to" , ( LengthPercentageType | "left" | "center" | "right" | "x-start" | "x-end" ) )
  | ( "by" , LengthPercentageType ) ) ;

(* vline [ to [ <length-percentage> | top | center | bottom | y-start | y-end ] | by <length-percentage> ] *)
VerticalLineCommandType = "vline" , (
    ( "to" , ( LengthPercentageType | "top" | "center" | "bottom" | "y-start" | "y-end" ) )
  | ( "by" , LengthPercentageType ) ) ;
RelativeControlPointType = CoordinatePairType , [ "from" , ( "start" | "end" | "origin" ) ] ;
ControlPointType          = PositionType | RelativeControlPointType ;
CurveCommandType = "curve" , (
    ( "to" , PositionType , "with" , ControlPointType , [ "/" , ControlPointType ] )
  | ( "by" , CoordinatePairType , "with" , RelativeControlPointType , [ "/" , RelativeControlPointType ] ) ) ;
SmoothCommandType = "smooth" , (
    ( "to" , PositionType , [ "with" , ControlPointType ] )
  | ( "by" , CoordinatePairType , [ "with" , RelativeControlPointType ] ) ) ;
ArcSweepType = "cw" | "ccw" ;
ArcSizeType  = "large" | "small" ;

ArcCommandType = "arc" , CommandEndPointType ,
  [ [ "of" , LengthPercentageType , [ LengthPercentageType ] ] ,
    [ ArcSweepType ] ,
    [ ArcSizeType ] ,
    [ "rotate" , AngleType ] ] ;

