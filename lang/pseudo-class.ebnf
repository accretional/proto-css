(* pseudo-class.ebnf — CSS pseudo-class selectors
   Sources: 
     MDN pseudo-class reference : https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/Pseudo-classes 
     CSS Selectors Level 4 spec : 

   Naming convention: pc_ prefix for every pseudo-class rule.

   Circular-reference note:
     Functional pseudo-classes like :is(), :not(), :has(), :where(),
     and the [of <selector-list>] clause in :nth-child() take selector
     lists as arguments. Because PseudoClass is itself part of the
     selector grammar (via SimpleSelector → CompoundSelector → ...) this
     creates mutual recursion. The types are aliased at the bottom of this
     file and resolve to their real definitions in selector.ebnf.

   An+B note:
     The <An+B> microsyntax is defined locally as AnPlusBType.
     "even" and "odd" are shorthands and are listed explicitly.
*)


(* ── Top-level union ─────────────────────────────────────────────────────── *)

PseudoClass =
    (* Elemental / general *)
    PcDefined | PcHeading
    (* Element-display-state *)
    | PcOpen | PcPopoverOpen | PcModal | PcFullscreen
    | PcPictureInPicture | PcXrOverlay
    (* Input *)
    | PcEnabled | PcDisabled | PcReadOnly | PcReadWrite
    | PcPlaceholderShown | PcAutofill
    | PcDefault | PcChecked | PcIndeterminate | PcBlank
    | PcValid | PcInvalid | PcInRange | PcOutOfRange
    | PcRequired | PcOptional | PcUserValid | PcUserInvalid
    (* Linguistic *)
    | PcDir | PcLang
    (* Location *)
    | PcAnyLink | PcVisited | PcLink | PcLocalLink
    | PcTarget | PcScope
    (* Resource state (media) *)
    | PcPlaying | PcPaused | PcSeeking | PcBuffering
    | PcStalled | PcMuted | PcVolumeLocked
    (* Time-dimensional *)
    | PcCurrent | PcPast | PcFuture
    (* Tree-structural *)
    | PcRoot | PcEmpty
    | PcNthChild | PcNthLastChild
    | PcFirstChild | PcLastChild | PcOnlyChild
    | PcNthOfType | PcNthLastOfType
    | PcFirstOfType | PcLastOfType | PcOnlyOfType
    (* Shadow DOM *)
    | PcHost | PcHostContext | PcHasSlotted
    (* User-action *)
    | PcHover | PcActive | PcFocus | PcFocusVisible | PcFocusWithin
    (* Scroll-target *)
    | PcTargetCurrent
    (* Logical combination *)
    | PcIs | PcNot | PcWhere | PcHas
    (* Custom state *)
    | PcState
    (* @page *)
    | PcLeft | PcRight | PcFirst
    (* View-transition *)
    | PcActiveViewTransition | PcActiveViewTransitionType
    (* Experimental / future *)
    | PcInterestSource | PcInterestTarget
    | PcTargetAfter | PcTargetBefore
    (* Vendor-prefixed (Firefox /-moz-/) *)
    | PcMozBroken | PcMozDragOver | PcMozFirstNode
    | PcMozHandlerBlocked | PcMozHandlerCrashed | PcMozHandlerDisabled
    | PcMozLastNode | PcMozLoading | PcMozLocaleDir
    | PcMozOnlyWhitespace | PcMozSubmitInvalid | PcMozSuppressed
    | PcMozUserDisabled | PcMozWindowInactive
    (* Generic vendor-prefixed: :-webkit-*, :-moz-*, :-ms-*, etc. *)
    | PcVendor ;


(* ── Elemental / general ─────────────────────────────────────────────────── *)

PcDefined         = ":" , "defined" ;
(* :heading — also has a functional form :heading(<integer>#) handled below *)
PcHeading         = ":" , "heading" , [ "(" , IntegerType , { "," , IntegerType } , ")" ] ;


(* ── Element-display-state ───────────────────────────────────────────────── *)

PcOpen              = ":" , "open" ;
PcPopoverOpen      = ":" , "popover-open" ;
PcModal             = ":" , "modal" ;
PcFullscreen        = ":" , "fullscreen" ;
PcPictureInPicture = ":" , "picture-in-picture" ;
PcXrOverlay        = ":" , "xr-overlay" ;


(* ── Input pseudo-classes ────────────────────────────────────────────────── *)

PcEnabled           = ":" , "enabled" ;
PcDisabled          = ":" , "disabled" ;
PcReadOnly         = ":" , "read-only" ;
PcReadWrite        = ":" , "read-write" ;
PcPlaceholderShown = ":" , "placeholder-shown" ;
PcAutofill          = ":" , "autofill" ;
PcDefault           = ":" , "default" ;
PcChecked           = ":" , "checked" ;
PcIndeterminate     = ":" , "indeterminate" ;
PcBlank             = ":" , "blank" ;
PcValid             = ":" , "valid" ;
PcInvalid           = ":" , "invalid" ;
PcInRange          = ":" , "in-range" ;
PcOutOfRange      = ":" , "out-of-range" ;
PcRequired          = ":" , "required" ;
PcOptional          = ":" , "optional" ;
PcUserValid        = ":" , "user-valid" ;
PcUserInvalid      = ":" , "user-invalid" ;


(* ── Linguistic ──────────────────────────────────────────────────────────── *)

(* :dir(ltr | rtl) *)
PcDir  = ":" , "dir" , "(" , ( "ltr" | "rtl" ) , ")" ;

(* :lang(<language-code>[,<language-code>]* ) — language code is an ident or string *)
PcLang = ":" , "lang" , "(" , LanguageCodeType , { "," , LanguageCodeType } , ")" ;


(* ── Location ────────────────────────────────────────────────────────────── *)

PcAnyLink   = ":" , "any-link" ;
PcVisited    = ":" , "visited" ;
PcLink       = ":" , "link" ;
PcLocalLink = ":" , "local-link" ;
PcTarget     = ":" , "target" ;
PcScope      = ":" , "scope" ;


(* ── Resource-state (media playback) ─────────────────────────────────────── *)

PcPlaying      = ":" , "playing" ;
PcPaused       = ":" , "paused" ;
PcSeeking      = ":" , "seeking" ;
PcBuffering    = ":" , "buffering" ;
PcStalled      = ":" , "stalled" ;
PcMuted        = ":" , "muted" ;
PcVolumeLocked = ":" , "volume-locked" ;


(* ── Time-dimensional (WebVTT) ───────────────────────────────────────────── *)

(* :current — also accepts an optional compound-selector-list argument *)
PcCurrent = ":" , "current" , [ "(" , CompoundSelectorListType , ")" ] ;
PcPast    = ":" , "past" ;
PcFuture  = ":" , "future" , [ "(" , ForgivingSelectorListType , ")" ] ;


(* ── Tree-structural ─────────────────────────────────────────────────────── *)

PcRoot  = ":" , "root" ;
PcEmpty = ":" , "empty" ;

(* :nth-child([ <An+B> | even | odd ] [of <complex-selector-list>]?) *)
PcNthChild      = ":" , "nth-child" , "(" ,
                      ( AnPlusBType | "even" | "odd" ) ,
                      [ "of" , ComplexSelectorListType ] ,
                      ")" ;

(* :nth-last-child(<nth> [of <complex-selector-list>]?) *)
PcNthLastChild = ":" , "nth-last-child" , "(" ,
                      ( AnPlusBType | "even" | "odd" ) ,
                      [ "of" , ComplexSelectorListType ] ,
                      ")" ;

PcFirstChild = ":" , "first-child" ;
PcLastChild  = ":" , "last-child" ;
PcOnlyChild  = ":" , "only-child" ;

(* :nth-of-type(<An+B> | even | odd) *)
PcNthOfType      = ":" , "nth-of-type" , "(" ,
                        ( AnPlusBType | "even" | "odd" ) ,
                        ")" ;

(* :nth-last-of-type(<An+B> | even | odd) *)
PcNthLastOfType = ":" , "nth-last-of-type" , "(" ,
                        ( AnPlusBType | "even" | "odd" ) ,
                        ")" ;

PcFirstOfType = ":" , "first-of-type" ;
PcLastOfType  = ":" , "last-of-type" ;
PcOnlyOfType  = ":" , "only-of-type" ;


(* ── Shadow DOM ──────────────────────────────────────────────────────────── *)

(* :host — also has functional form :host(<compound-selector>) *)
PcHost         = ":" , "host" , [ "(" , CompoundSelectorType , ")" ] ;
PcHostContext = ":" , "host-context" , "(" , CompoundSelectorType , ")" ;
PcHasSlotted  = ":" , "has-slotted" ;


(* ── User-action ─────────────────────────────────────────────────────────── *)

PcHover         = ":" , "hover" ;
PcActive        = ":" , "active" ;
PcFocus         = ":" , "focus" ;
PcFocusVisible = ":" , "focus-visible" ;
PcFocusWithin  = ":" , "focus-within" ;


(* ── Scroll-target ───────────────────────────────────────────────────────── *)

PcTargetCurrent = ":" , "target-current" ;


(* ── Logical combination ─────────────────────────────────────────────────── *)

(* :is(<forgiving-selector-list>) — invalid selectors silently ignored *)
PcIs    = ":" , "is"    , "(" , ForgivingSelectorListType , ")" ;

(* :not(<complex-selector-list>) *)
PcNot   = ":" , "not"   , "(" , ComplexSelectorListType   , ")" ;

(* :where(<complex-selector-list>) — like :is() but zero specificity *)
PcWhere = ":" , "where" , "(" , ComplexSelectorListType   , ")" ;

(* :has(<relative-selector-list>) *)
PcHas   = ":" , "has"   , "(" , RelativeSelectorListType  , ")" ;


(* ── Custom state ────────────────────────────────────────────────────────── *)

(* :state(<custom-ident>) — custom element internal state *)
PcState = ":" , "state" , "(" , custom_ident_type , ")" ;


(* ── @page pseudo-classes ───────────────────────────────────────────────── *)

PcLeft  = ":" , "left" ;
PcRight = ":" , "right" ;
PcFirst = ":" , "first" ;


(* ── View-transition ─────────────────────────────────────────────────────── *)

PcActiveViewTransition      = ":" , "active-view-transition" ;
PcActiveViewTransitionType = ":" , "active-view-transition-type" ,
                                   "(" ,
                                   custom_ident_type , { "," , custom_ident_type } ,
                                   ")" ;


(* ── Experimental / future ───────────────────────────────────────────────── *)

PcInterestSource = ":" , "interest-source" ;
PcInterestTarget = ":" , "interest-target" ;
PcTargetAfter    = ":" , "target-after" ;
PcTargetBefore   = ":" , "target-before" ;


(* ── Vendor-prefixed: Firefox (-moz-) ───────────────────────────────────── *)

PcMozBroken          = ":" , "-moz-broken" ;
PcMozDragOver       = ":" , "-moz-drag-over" ;
PcMozFirstNode      = ":" , "-moz-first-node" ;
PcMozHandlerBlocked = ":" , "-moz-handler-blocked" ;
PcMozHandlerCrashed = ":" , "-moz-handler-crashed" ;
PcMozHandlerDisabled = ":" , "-moz-handler-disabled" ;
PcMozLastNode       = ":" , "-moz-last-node" ;
PcMozLoading         = ":" , "-moz-loading" ;
(* :-moz-locale-dir(ltr | rtl) *)
PcMozLocaleDir      = ":" , "-moz-locale-dir" , "(" , ( "ltr" | "rtl" ) , ")" ;
PcMozOnlyWhitespace = ":" , "-moz-only-whitespace" ;
PcMozSubmitInvalid  = ":" , "-moz-submit-invalid" ;
PcMozSuppressed      = ":" , "-moz-suppressed" ;
PcMozUserDisabled   = ":" , "-moz-user-disabled" ;
PcMozWindowInactive = ":" , "-moz-window-inactive" ;

(* Generic vendor-prefixed pseudo-class: colon + hyphen + ident (+ optional arg)
   Matches :-webkit-any-link, :-moz-placeholder, :-ms-input-placeholder, etc. *)
PcVendor = ":" , "-" , ident_type ,
           [ "(" , { DeclarationValueInParensType } , ")" ] ;


(* ── Supporting types ────────────────────────────────────────────────────── *)

(* <An+B> microsyntax: 2n+1, -n+3, 3n, 5, even, odd
   A and B are integers; A may be omitted (= 1), B may be omitted (= 0).
   The sign between A*n and B is written as + or -.
   "even" = 2n, "odd" = 2n+1 are handled as keywords in the caller. *)
AnPlusBType =
    integer_type , [ "n" , [ ( "+" | "-" ) , whole_number ] ]
    | "n" , [ ( "+" | "-" ) , whole_number ]
    | "-" , "n" , [ ( "+" | "-" ) , whole_number ] ;

(* Language code: BCP 47 tag — <ident> or <string> per CSS Selectors 4 spec, e.g. en, "en", "zh-hans" *)
LanguageCodeType = ident_type | string_type ;

(* ── Circular-reference note ─────────────────────────────────────────────── *)
(* These types are defined in selector.ebnf, which in turn includes PseudoClass
   (via SimpleSelector). This creates a mutual recursion:
     PseudoClass → :is() → ForgivingSelectorList → ComplexSelector
                  → CompoundSelector → SimpleSelector → PseudoClass
   EBNF permits mutual recursion; gluon compiles all files together so the
   references resolve at grammar-compile time. *)

(* :not() uses _no_pe — pseudo-elements excluded per spec *)
ComplexSelectorListType    = ComplexSelectorListNoPe ;    (* <complex-selector-list> — no pseudo-elements *)
(* :is()/:where() use the full forgiving list — pseudo-elements are valid per CSS Selectors 4 *)
ForgivingSelectorListType  = ForgivingSelectorList ;
(* :has() and :current() use the full types — pseudo-elements are allowed there *)
RelativeSelectorListType   = RelativeSelectorList ;         (* <relative-selector-list> *)
CompoundSelectorType        = CompoundSelector ;              (* <compound-selector> *)
CompoundSelectorListType   = CompoundSelectorList ;         (* <compound-selector-list> *)
