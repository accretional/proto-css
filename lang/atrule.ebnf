(* CSS At-rule definitions
   Sources: MDN formal syntax, W3C CSS specifications
*)

(* ── AtRule — union used in css.ebnf ───────────────────────────────────── *)

AtRule =
    AtCharset
    | AtColorProfile
    | AtContainer
    | AtCounterStyle
    | AtCustomMedia
    | AtFontFace
    | AtFontFeatureValues
    | AtFontPaletteValues
    | AtFunction
    | AtImport
    | AtKeyframes
    | AtLayer
    | AtMedia
    | AtNamespace
    | AtPage
    | AtPositionTry
    | AtProperty
    | AtScope
    | AtStartingStyle
    | AtSupports
    | AtViewTransition ;


(* ── Placeholder types for sub-systems defined in other EBNF files ───────── *)
BlockContentsType        = RuleBody ;   (* rules + declarations — same shape as a rule body *)
DeclarationListType      = RuleBody ;   (* descriptor block  — same shape as a rule body *)
RuleListType             = CssStyleSheet ; (* list of rules — same shape as top-level sheet *)
DeclarationRuleListType = RuleBody ;   (* mixed declarations and rules *)
QualifiedRuleListType   = CssStyleSheet ; (* e.g. @keyframes body *)
(*
   Media Queries Level 4 — full implementation replacing the single-token placeholder.

   <mf-value>: number | dimension | ident | ratio
   <mf-plain>: <mf-name> : <mf-value>
   <mf-boolean>: <mf-name>  (bare ident or dashed-ident for @custom-media refs)
   <mf-range>: name op value | value op name | value op name op value
   <media-feature>: ( <mf-plain> | <mf-range> | <mf-boolean> )
   <media-in-parens>: ( <media-condition> ) | ( <media-feature> ) | <general-enclosed>
   <media-condition>: not? <media-in-parens> [ and/or <media-in-parens> ]*
   <media-query>: <media-condition> | [not|only]? <media-type> [and <condition-without-or>]?
   <media-query-list>: <media-query>#
*)

MediaFeatureValueType = NumberType | DimensionType | ident_type | RatioType ;

MediaFeaturePlainType  = ident_type , ":" , MediaFeatureValueType ;
MediaFeatureBooleanType = ident_type | dashed_ident_type ;
MediaFeatureRangeType =
    ident_type , MfComparisonType , MediaFeatureValueType
    | MediaFeatureValueType , MfComparisonType , ident_type
    | MediaFeatureValueType , MfLtType , ident_type , MfLtType , MediaFeatureValueType
    | MediaFeatureValueType , MfGtType , ident_type , MfGtType , MediaFeatureValueType ;

MediaFeatureType = MediaFeaturePlainType | MediaFeatureRangeType | MediaFeatureBooleanType ;

MediaInParensType =
    "(" , MediaConditionType , ")"
    | "(" , MediaFeatureType , ")"
    | GeneralEnclosedType ;

MediaConditionType =
    "not" , MediaInParensType
    | MediaInParensType , { "and" , MediaInParensType }
    | MediaInParensType , { "or" , MediaInParensType } ;

MediaConditionWithoutOrType =
    "not" , MediaInParensType
    | MediaInParensType , { "and" , MediaInParensType } ;

MediaTypeType = ident_type ;

MediaQueryType =
    MediaConditionType
    | [ "not" | "only" ] , MediaTypeType , [ "and" , MediaConditionWithoutOrType ] ;

MediaQueryListType = MediaQueryType , { "," , MediaQueryType } ;
SelectorListType         = ComplexSelectorList ;   (* forward ref to selector.ebnf *)
AnyValueType             = DeclarationValueInParensType ;  (* any CSS token sequence — no ) so structural parens are not consumed *)

(* ── Shared: general-enclosed (used in container/supports queries) ───────── *)
GeneralEnclosedType =
    custom_ident_type , "(" , [ AnyValueType ] , ")"
    | "(" , [ AnyValueType ] , ")" ;

(* ── Shared: @supports condition (used in @import and @supports) ─────────── *)
FontTechAtruleType =
    "features-opentype" | "features-aat" | "features-graphite"
    | "color-COLRv0" | "color-COLRv1" | "color-SVG" | "color-sbix" | "color-CBDT"
    | "variations" | "palettes" | "incremental" ;

FontFormatAtruleType =
    string_type
    | "collection" | "embedded-opentype" | "opentype"
    | "svg" | "truetype" | "woff" | "woff2" ;

SupportsSelectorFnType      = "selector" , "(" , AnyValueType , ")" ;
SupportsFontTechFnType     = "font-tech" , "(" , FontTechAtruleType , ")" ;
SupportsFontFormatFnType   = "font-format" , "(" , FontFormatAtruleType , ")" ;
SupportsAtRuleFnType       = AtRule , "(" , custom_ident_type , ")" ;
SupportsNamedFeatureFnType = "named-feature" , "(" , custom_ident_type , ")" ;
SupportsEnvFnType           = EnvFn ;
SupportsDeclType             = "(" , DeclarationValueInParensType , ")" ;

SupportsFeatureType =
    SupportsSelectorFnType
    | SupportsFontTechFnType
    | SupportsFontFormatFnType
    | SupportsAtRuleFnType
    | SupportsNamedFeatureFnType
    | SupportsEnvFnType
    | SupportsDeclType ;

SupportsInParensType =
    "(" , SupportsConditionType , ")"
    | SupportsFeatureType
    | GeneralEnclosedType ;

SupportsConditionType =
    "not" , SupportsInParensType
    | SupportsInParensType , { "and" , SupportsInParensType }
    | SupportsInParensType , { "or" , SupportsInParensType } ;

(* ── @charset ────────────────────────────────────────────────────────────── *)

(* Common IANA charset names. Use custom_ident_type for any other valid value. *)
CharsetNameType =
    (* Unicode *)
    "UTF-8" | "UTF-16" | "UTF-16BE" | "UTF-16LE"
    | "UTF-32" | "UTF-32BE" | "UTF-32LE" | "UTF-7"
    (* ASCII / Latin *)
    | "US-ASCII"
    | "ISO-8859-1" | "ISO-8859-2" | "ISO-8859-3" | "ISO-8859-4"
    | "ISO-8859-5" | "ISO-8859-6" | "ISO-8859-7" | "ISO-8859-8"
    | "ISO-8859-9" | "ISO-8859-10" | "ISO-8859-11" | "ISO-8859-13"
    | "ISO-8859-14" | "ISO-8859-15" | "ISO-8859-16"
    (* Windows code pages *)
    | "windows-874" | "windows-1250" | "windows-1251" | "windows-1252"
    | "windows-1253" | "windows-1254" | "windows-1255" | "windows-1256"
    | "windows-1257" | "windows-1258"
    (* East Asian *)
    | "Shift_JIS" | "EUC-JP" | "ISO-2022-JP" | "ISO-2022-JP-2"
    | "EUC-KR" | "ISO-2022-KR"
    | "GB2312" | "GBK" | "GB18030"
    | "Big5" | "Big5-HKSCS"
    (* Cyrillic *)
    | "KOI8-R" | "KOI8-U"
    (* Other *)
    | "macintosh" | "TIS-620" | "IBM866" | "IBM850"
    (* Custom / non-standard *)
    | custom_ident_type ;

AtCharset = "@" , "charset" , CharsetNameType , ";" ;

(* ── @color-profile ──────────────────────────────────────────────────────── *)

AtColorProfile = "@" , "color-profile" , ( dashed_ident_type | "device-cmyk" ) , "{" , DeclarationListType , "}" ;

(* ── @container ──────────────────────────────────────────────────────────── *)

MfLtType         = [ "<" ], "=" ;
MfGtType         = [ ">" ], "=" ;
MfComparisonType = MfLtType | MfGtType | "=" ;

SizeFeatureType         = DeclarationValueInParensType ;  (* defined with media features — no ) so structural paren is not consumed *)
ScrollStateFeatureType = DeclarationValueInParensType ;  (* defined with scroll state *)
StyleFeatureNameType   = custom_ident_type ;
StyleFeatureValueType  = DeclarationValueInParensType ;

StyleFeaturePlainType   = StyleFeatureNameType , ":" , StyleFeatureValueType ;
StyleFeatureBooleanType = StyleFeatureNameType ;
StyleRangeValueType     = CustomPropertyNameType | StyleFeatureValueType ;
StyleRangeType =
    StyleRangeValueType , MfComparisonType , StyleRangeValueType
    | StyleRangeValueType , MfLtType , StyleRangeValueType , MfLtType , StyleRangeValueType
    | StyleRangeValueType , MfGtType , StyleRangeValueType , MfGtType , StyleRangeValueType ;
StyleFeatureType = StyleFeaturePlainType | StyleFeatureBooleanType | StyleRangeType ;

StyleInParensType =
    "(" , StyleQueryType , ")"
    | "(" , StyleFeatureType , ")"
    | GeneralEnclosedType ;

StyleQueryType =
    "not" , StyleInParensType
    | StyleInParensType , { "and" , StyleInParensType }
    | StyleInParensType , { "or" , StyleInParensType }
    | StyleFeatureType ;

ScrollStateInParensType =
    "(" , ScrollStateQueryType , ")"
    | "(" , ScrollStateFeatureType , ")"
    | GeneralEnclosedType ;

ScrollStateQueryType =
    "not" , ScrollStateInParensType
    | ScrollStateInParensType , { "and" , ScrollStateInParensType }
    | ScrollStateInParensType , { "or" , ScrollStateInParensType } ;

QueryInParensType =
    "(" , ContainerQueryType , ")"
    | "(" , SizeFeatureType , ")"
    | "style" , "(" , StyleQueryType , ")"
    | "scroll-state" , "(" , ScrollStateQueryType , ")"
    | GeneralEnclosedType ;

ContainerQueryType =
    "not" , QueryInParensType
    | QueryInParensType , { "and" , QueryInParensType }
    | QueryInParensType , { "or" , QueryInParensType } ;

ContainerConditionType = [ custom_ident_type ] , ContainerQueryType ;

AtContainer = "@" , "container" , ContainerConditionType , { "," , ContainerConditionType } , "{" , BlockContentsType , "}" ;

(* ── @counter-style ──────────────────────────────────────────────────────── *)

(* <symbol> in the context of @counter-style descriptors (not the symbols() fn) *)
CounterStyleSymbolType = string_type | ImageType | custom_ident_type ;

CounterStyleAdditiveSymbolsType =
    IntegerType , CounterStyleSymbolType ,
    { "," , IntegerType , CounterStyleSymbolType } ;

CounterStyleNegativeType = CounterStyleSymbolType , [ CounterStyleSymbolType ] ;
CounterStylePadType      = IntegerType , CounterStyleSymbolType ;
CounterStyleRangeValueType = IntegerType | "infinite" ;
CounterStyleRangeType =
    CounterStyleRangeValueType , CounterStyleRangeValueType ,
    { "," , CounterStyleRangeValueType , CounterStyleRangeValueType }
    | "auto" ;

CounterStyleSpeakAsType =
    "auto" | "bullets" | "numbers" | "words" | "spell-out"
    | CounterStyleNameType ;

CounterStyleSystemType =
    "cyclic" | "numeric" | "alphabetic" | "symbolic" | "additive"
    | ( "fixed" , [ IntegerType ] )
    | ( "extends" , CounterStyleNameType ) ;

(* @counter-style descriptor block — system/symbols/range/negative/pad/speak-as descriptors *)
AtCounterStyleSystemDesc   = "system"   , ":" , CounterStyleSystemType , ";" ;
AtCounterStyleSymbolsDesc  = "symbols"  , ":" , CounterStyleSymbolType , { CounterStyleSymbolType } , ";" ;
AtCounterStyleRangeDesc    = "range"    , ":" , CounterStyleRangeType , ";" ;
AtCounterStyleNegativeDesc = "negative" , ":" , CounterStyleNegativeType , ";" ;
AtCounterStylePadDesc      = "pad"      , ":" , CounterStylePadType , ";" ;
AtCounterStyleSpeakAsDesc  = "speak-as" , ":" , CounterStyleSpeakAsType , ";" ;

AtCounterStyleAdditiveSymbolsDesc = "additive-symbols" , ":" , CounterStyleAdditiveSymbolsType , ";" ;
AtCounterStyleFallbackDesc        = "fallback"         , ":" , CounterStyleNameType , ";" ;
AtCounterStyleSuffixDesc          = "suffix"           , ":" , CounterStyleSymbolType , ";" ;
AtCounterStylePrefixDesc          = "prefix"           , ":" , CounterStyleSymbolType , ";" ;

AtCounterStyleBlock = { DeclarationItem | AtCounterStyleSystemDesc | AtCounterStyleSymbolsDesc
                      | AtCounterStyleRangeDesc | AtCounterStyleNegativeDesc
                      | AtCounterStylePadDesc | AtCounterStyleSpeakAsDesc
                      | AtCounterStyleAdditiveSymbolsDesc | AtCounterStyleFallbackDesc
                      | AtCounterStyleSuffixDesc | AtCounterStylePrefixDesc } , [ Declaration ] ;

AtCounterStyle = "@" , "counter-style" , custom_ident_type , "{" , AtCounterStyleBlock , "}" ;

(* ── @custom-media ───────────────────────────────────────────────────────── *)

AtCustomMedia = "@" , "custom-media" , dashed_ident_type , ( MediaQueryListType | "true" | "false" ) , ";" ;

(* ── @font-face ──────────────────────────────────────────────────────────── *)

FontFaceSrcType         = DeclarationValueTokenType ;  (* url() with optional format()/tech() hints *)
UnicodeRangeTokenType   = custom_ident_type ;       (* e.g. U+0025, U+4??, U+0025-00FF *)

FontFaceOverrideType    = "normal" | PercentageType ;   (* ascent/descent/line-gap override *)
FontFaceDisplayType     = "auto" | "block" | "swap" | "fallback" | "optional" ;

FontFaceStyleDescType  =
    "auto" | "normal" | "italic" | "left" | "right"
    | ( "oblique" , [ angle_type , [ angle_type ] ] ) ;

FontFaceWeightDescType =
    "auto" | FontWeightAbsoluteType | ( FontWeightAbsoluteType , FontWeightAbsoluteType ) ;

FontFaceWidthDescType  = "auto" | FontWidthCss3Type | ( FontWidthCss3Type , FontWidthCss3Type )
                       | PercentageType | ( PercentageType , PercentageType ) ;

(* OpentypeTagType: defined in Property.ebnf *)
FontFaceFeatureTagValueType = OpentypeTagType , [ IntegerType | "on" | "off" ] ;
FontFaceFeatureSettingsType = "normal" | FontFaceFeatureTagValueType , { "," , FontFaceFeatureTagValueType } ;

(* @font-face src descriptor: url() or local() with optional format()/tech() hints
   format() and tech() may appear in either order per spec *)
AtFontFaceSrcFormatHint = "format" , "(" , FontFormatAtruleType , ")" ;
AtFontFaceSrcTechHint   = "tech"   , "(" , FontTechAtruleType   , ")" ;
AtFontFaceSrcItem =
    UrlType , [ AtFontFaceSrcFormatHint ] , [ AtFontFaceSrcTechHint ]
    | UrlType , [ AtFontFaceSrcTechHint ] , [ AtFontFaceSrcFormatHint ]
    | "local" , "(" , ( string_type | ident_type ) , ")" ;

AtFontFaceSrcDesc    = "src"        , ":" , AtFontFaceSrcItem , { "," , AtFontFaceSrcItem } , ";" ;
AtFontFaceWeightDesc = "font-weight" , ":" , FontFaceWeightDescType , ";" ;
AtFontFaceStyleDesc  = "font-style"  , ":" , FontFaceStyleDescType  , ";" ;
AtFontFaceWidthDesc  = "font-stretch" , ":" , FontFaceWidthDescType  , ";" ;
AtFontFaceDisplayDesc             = "font-display"      , ":" , FontFaceDisplayType , ";" ;
AtFontFaceVariationSettingsDesc   = "font-variation-settings" , ":" , FontFaceFeatureSettingsType , ";" ;
AtFontFaceSizeAdjustDesc          = "size-adjust"        , ":" , ( "normal" | PercentageType ) , ";" ;
AtFontFaceUnicodeRangeDesc        = "unicode-range"       , ":" , UnicodeRangeTokenType , { "," , UnicodeRangeTokenType } , ";" ;
AtFontFaceAscentOverrideDesc      = "ascent-override"     , ":" , FontFaceOverrideType , ";" ;
AtFontFaceDescentOverrideDesc     = "descent-override"    , ":" , FontFaceOverrideType , ";" ;
AtFontFaceLineGapOverrideDesc     = "line-gap-override"   , ":" , FontFaceOverrideType , ";" ;

AtFontFaceBlock = { DeclarationItem | AtFontFaceSrcDesc | AtFontFaceWeightDesc | AtFontFaceStyleDesc | AtFontFaceWidthDesc
                  | AtFontFaceDisplayDesc | AtFontFaceVariationSettingsDesc | AtFontFaceSizeAdjustDesc
                  | AtFontFaceUnicodeRangeDesc | AtFontFaceAscentOverrideDesc | AtFontFaceDescentOverrideDesc
                  | AtFontFaceLineGapOverrideDesc } , [ Declaration ] ;

AtFontFace = "@" , "font-face" , "{" , AtFontFaceBlock , "}" ;

(* ── @font-feature-values ────────────────────────────────────────────────── *)

AtFontFeatureValues = "@" , "font-feature-values" , FontFamilyNameType , { "," , FontFamilyNameType } , "{" , AtFontFeatureValuesBlock , "}" ;

AtFontFeatureValuesBlock = { AtFfvSwash | AtFfvAnnotation | AtFfvOrnaments | AtFfvStylistic | AtFfvStyleset | AtFfvCharacterVariant } ;
AtFfvSwash            = "@" , "swash"            , "{" , { AtFfvSingleValueDecl } , "}" ;
AtFfvAnnotation       = "@" , "annotation"       , "{" , { AtFfvSingleValueDecl } , "}" ;
AtFfvOrnaments        = "@" , "ornaments"        , "{" , { AtFfvSingleValueDecl } , "}" ;
AtFfvStylistic        = "@" , "stylistic"        , "{" , { AtFfvSingleValueDecl } , "}" ;
AtFfvStyleset         = "@" , "styleset"         , "{" , { AtFfvMultiValueDecl  } , "}" ;
AtFfvCharacterVariant = "@" , "character-variant" , "{" , { AtFfvMultiValueDecl } , "}" ;
(* single-value: ident: <integer>; — used by @swash, @annotation, @ornaments, @stylistic *)
AtFfvSingleValueDecl  = ident_type , ":" , NonNegativeIntegerType , ";" ;
(* multi-value:  ident: <integer>+; — used by @styleset, @character-variant *)
AtFfvMultiValueDecl   = ident_type , ":" , NonNegativeIntegerType , { NonNegativeIntegerType } , ";" ;

(* ── @font-palette-values ────────────────────────────────────────────────── *)

FontPaletteBaseType = "light" | "dark" | IntegerType ;
FontPaletteOverrideColorsType = IntegerType , ColorType , { "," , IntegerType , ColorType } ;

AtFontPaletteValuesBasePaletteDesc    = "base-palette"    , ":" , FontPaletteBaseType , ";" ;
AtFontPaletteValuesOverrideColorsDesc = "override-colors" , ":" , FontPaletteOverrideColorsType , ";" ;

AtFontPaletteValuesBlock = { DeclarationItem | AtFontPaletteValuesBasePaletteDesc | AtFontPaletteValuesOverrideColorsDesc } , [ Declaration ] ;

AtFontPaletteValues = "@" , "font-palette-values" , dashed_ident_type , "{" , AtFontPaletteValuesBlock , "}" ;

(* ── @function ───────────────────────────────────────────────────────────── *)

CustomPropertyNameType  = dashed_ident_type ;

SyntaxTypeNameAtruleType =
    "angle" | "color" | "custom-ident" | "image" | "integer"
    | "length" | "length-percentage" | "number" | "percentage"
    | "resolution" | "string" | "time" | "url" | "transform-function" ;

SyntaxMultiplierAtruleType  = "#" | "+" ;
(* SyntaxSingleComponentType, SyntaxComponentType: defined in Property.ebnf *)
CssTypeAtruleType           = SyntaxComponentType | TypeFn ;
FunctionParameterType        = CustomPropertyNameType , [ CssTypeAtruleType ] , [ ":" , DeclarationValueInParensType ] ;

AtFunction =
    "@" , "function" , custom_ident_type , "(" , [ FunctionParameterType , { "," , FunctionParameterType } ] , ")" ,
    [ "returns" , CssTypeAtruleType ] ,
    "{" , DeclarationRuleListType , "}" ;

(* ── @import ─────────────────────────────────────────────────────────────── *)

ScopeStartType      = SelectorListType ;
ScopeEndType        = SelectorListType ;
(* [ ( <scope-start> ) ]? [ to ( <scope-end> ) ]? ]! : at least one of start or end must be present *)
ScopeBoundariesType =
    ( "(" , ScopeStartType , ")" ,
      [ "to" , "(" , ScopeEndType , ")" ] )
    | ( "to" , "(" , ScopeEndType , ")" ) ;

SupportsImportConditionType =
    "supports" , "(" , ( SupportsConditionType | DeclarationValueInParensType ) , ")" ;

ImportLayerType = "layer" | LayerFn ;
ImportScopeType = "scope" | ( "scope" , "(" , ( ScopeStartType | ScopeBoundariesType ) , ")" ) ;

AtImport =
    "@" , "import" , ( UrlType | string_type ) ,
    [ ImportLayerType ] ,
    [ ImportScopeType ] ,
    [ SupportsImportConditionType ] ,
    [ MediaQueryListType ] ,
    ";" ;

(* ── @keyframes ──────────────────────────────────────────────────────────── *)

(* KeyframesNameType: defined in Property.ebnf *)

(* <keyframe-selector>: from | to | <percentage> — comma-list is valid *)
KeyframeSelectorType = "from" | "to" | PercentageType ;

(* A single keyframe rule: one or more selectors, then a declaration block *)
KeyframeRuleType = KeyframeSelectorType , { "," , KeyframeSelectorType } ,
                   "{" , RuleBody , "}" ;

KeyframeBlockType = { KeyframeRuleType } ;

AtKeyframes = "@" , "keyframes" , KeyframesNameType , "{" , KeyframeBlockType , "}" ;

(* ── @layer ──────────────────────────────────────────────────────────────── *)

AtLayer =
    ( "@" , "layer" , [ LayerNameType ] , "{" , RuleListType , "}" )
    | ( "@" , "layer" , LayerNameType , { "," , LayerNameType } , ";" ) ;

(* ── @media ──────────────────────────────────────────────────────────────── *)

AtMedia = "@" , "media" , MediaQueryListType , "{" , RuleListType , "}" ;

(* ── @namespace ──────────────────────────────────────────────────────────── *)

NamespacePrefixType = custom_ident_type ;

AtNamespace = "@" , "namespace" , [ NamespacePrefixType ] , ( string_type | UrlType ) , ";" ;

(* ── @page ───────────────────────────────────────────────────────────────── *)

PseudoPageType =
    ":" , ( "left" | "right" | "first" | "blank" ) ;

(* [ <ident>? <pseudo-page>* ]! : at least one of ident or pseudo-page must be present *)
PageSelectorType =
    custom_ident_type , { PseudoPageType }
    | PseudoPageType , { PseudoPageType } ;

PageSizeType =
    "a5" | "a4" | "a3" | "b5" | "b4" | "JIS-B5" | "JIS-B4"
    | "letter" | "legal" | "ledger" ;

PageOrientationType = "upright" | "rotate-left" | "rotate-right" ;

PageSizeDescriptorType =
    length_type , [ length_type ]
    | "auto"
    | PageSizeType
    | PageSizeType , ( "portrait" | "landscape" )
    | "portrait" | "landscape" ;

AtPageSizeDesc        = "size"             , ":" , PageSizeDescriptorType , ";" ;
AtPageOrientationDesc = "page-orientation" , ":" , PageOrientationType , ";" ;

(* @top-left, @top-center, @top-right, @bottom-*, @left-*, @right-* margin at-rules *)
AtPageMarginBox = "@" , ident_type , "{" , { DeclarationItem } , [ Declaration ] , "}" ;
AtPageBlock = { DeclarationItem | AtPageSizeDesc | AtPageOrientationDesc | AtPageMarginBox } , [ Declaration ] ;

AtPage = "@" , "page" , [ PageSelectorType , { "," , PageSelectorType } ] , "{" , AtPageBlock , "}" ;

(* ── @position-try ───────────────────────────────────────────────────────── *)

AtPositionTry = "@" , "position-try" , dashed_ident_type , "{" , DeclarationListType , "}" ;

(* ── @Property ───────────────────────────────────────────────────────────── *)

AtPropertySyntaxDesc       = "syntax"        , ":" , string_type , ";" ;
AtPropertyInheritsDesc     = "inherits"       , ":" , ( "true" | "false" ) , ";" ;
AtPropertyInitialValueDesc = "initial-value"  , ":" , DeclarationValueTokenType , ";" ;

AtPropertyBlock = { DeclarationItem | AtPropertySyntaxDesc | AtPropertyInheritsDesc | AtPropertyInitialValueDesc } , [ Declaration ] ;

AtProperty = "@" , "property" , CustomPropertyNameType , "{" , AtPropertyBlock , "}" ;

(* ── @scope ──────────────────────────────────────────────────────────────── *)

AtScope = "@" , "scope" , [ ScopeBoundariesType ] , "{" , BlockContentsType , "}" ;

(* ── @starting-style ─────────────────────────────────────────────────────── *)

AtStartingStyle = "@" , "starting-style" , "{" , RuleListType , "}" ;

(* ── @supports ───────────────────────────────────────────────────────────── *)

AtSupports = "@" , "supports" , SupportsConditionType , "{" , RuleListType , "}" ;

(* ── @view-transition ────────────────────────────────────────────────────── *)

AtViewTransitionNavigationDesc = "navigation" , ":" , ( "auto" | "none" ) , ";" ;
AtViewTransitionTypesDesc       = "types"      , ":" , ( "none" | custom_ident_type , { custom_ident_type } ) , ";" ;
AtViewTransitionBlock = { AtViewTransitionNavigationDesc | AtViewTransitionTypesDesc } ;
AtViewTransition = "@" , "view-transition" , "{" , AtViewTransitionBlock , "}" ;

